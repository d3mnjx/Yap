@inject UserStateService UserState
<!DOCTYPE html>
@* Server-rendered font-size (like data-theme) = zero flash; applyFontSize in chat.js does live switching.
   Null (default) omits the style attribute entirely; out-of-range DB values are ignored as a safety net. *@
<html lang="en" data-appearance-user="@(UserState.UserId?.ToString() ?? "")" data-theme="@(UserState.Theme ?? "discord-dark")"
      style="@(UserState.FontSize is >= Yap.Models.User.MinFontSize and <= Yap.Models.User.MaxFontSize ? $"font-size: {UserState.FontSize}px" : null)">

<head>
    <meta charset="utf-8" />
    <!-- interactive-widget=resizes-content: resize viewport when mobile keyboard opens (works on Chrome/Brave iOS, not Safari) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <base href="/" />
    <script src="/js/appearance.js"></script>
    <script type="module" src="/chat-client/session-renewal.js"></script>

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["themes.css"]" />
    @* Generated per-scene blocks for the Tea House theme; inert for every other theme. *@
    <link rel="stylesheet" href="@Assets["themes/teahouse.css"]" />
    <link rel="stylesheet" href="/chat-client/shared.css" />
    <link rel="stylesheet" href="@Assets["Yap.styles.css"]" />
    @* crossorigin is required even same-origin: CSS font fetches use CORS mode, and a
       mismatched preload is silently wasted (double download). Italic is not preloaded — rare. *@
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <!-- use-credentials: the manifest fetch must send the auth cookie, or every install would get the anonymous (untokenized) start_url -->
    <link rel="manifest" href="manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <!-- Pre-CSS default; appearance.js retints it to the active theme's canvas color -->
    <meta name="theme-color" content="#1a1a2e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <ImportMap />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />

    @* Built-in Blazor error UI - shown automatically when unhandled exceptions occur *@
    <div id="blazor-error-ui" data-nosnippet>
        <div class="error-modal-content">
            <div class="error-illustration">
                <pre class="error-ascii">
    ,--./,-.
   / #      \
  |  O    O  |
  \    __   /
   '-.__.-'
  /`-.__.-'\
 / /  | |  \ \
( (   | |   ) )
 \ \  | |  / /
  '._\|_|/_.'
    </pre>
            </div>
            <h2 class="error-title">Oops! The gremlins got us</h2>
            <p class="error-message">Something went terribly wrong. Our best engineers (who are also gremlins) are looking into it.</p>
            <div class="error-actions">
                <a href="" class="reload">Reload &amp; Try Again</a>
            </div>
            <p class="error-hint">If this keeps happening, try clearing your browser cache or yelling at your computer.</p>
        </div>
    </div>

    @*
        =============================================================================
        BLAZOR STARTUP WITH CUSTOM RECONNECTION OPTIONS (.NET 10)
        =============================================================================
        We use autostart="false" to prevent Blazor from starting automatically.
        This allows us to configure reconnection options before starting.

        Key Configuration:
        - retryIntervalMilliseconds: Function that returns retry delay in ms
          - We return 4000 (4 seconds) for every attempt = infinite retries
          - Returning null would stop retrying (we never do that)

        Alternative configurations:
        - Fixed array: [0, 1000, 2000, 5000] - retry immediately, then 1s, 2s, 5s, stop
        - Exponential: (attempts) => Math.min(attempts * 1000, 30000) - increase delay up to 30s
        =============================================================================
    *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // Start Blazor with custom reconnection configuration
        Blazor.start({
            circuit: {
                // Log SignalR negotiation (incl. the selected transport) to the console — a client
                // stuck on long-polling fallback instead of WebSockets is the #1 per-machine latency suspect.
                configureSignalR: builder => builder.configureLogging('information'),
                reconnectionOptions: {
                    // Retry timing: immediate first attempt, then every 4 seconds.
                    retryIntervalMilliseconds: function(previousAttempts, maxRetries) {
                        console.log('[Blazor] Reconnection attempt ' + (previousAttempts + 1));
                        // First attempt immediate, then 4 seconds between retries
                        return previousAttempts === 0 ? 0 : 4000;
                    }
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tus-js-client@4/dist/tus.min.js"></script>
    <script src="@Assets["js/chat.js"]"></script>
    <script>
        // Register service worker for PWA support
        if ('serviceWorker' in navigator) {
            import('/chat-client/worker-updates.js').then(module => module.registerWorker())
                .then(reg => console.log('[PWA] Service worker registered'))
                .catch(err => console.warn('[PWA] Service worker registration failed:', err));
        }
    </script>
</body>

</html>
