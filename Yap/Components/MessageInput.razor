@using Yap.Services.Gifs
@inject ChatService ChatService
@inject ChatConfigService ChatConfig
@inject UserStateService UserState
@inject UserService UserService
@inject GifService GifService
@inject IJSRuntime JS
@inject ILogger<MessageInput> Logger
@implements IAsyncDisposable

@if (ReadOnly)
{
    <div class="typing-indicator-container"></div>
    <div class="readonly-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
        <span>You do not have permission to send messages in this channel</span>
    </div>
}
else
{

@if (!string.IsNullOrEmpty(warningTitle))
{
    <div class="warning-modal-backdrop" @onclick="DismissWarning">
        <div class="warning-modal" @onclick:stopPropagation="true">
            <button class="warning-modal-close" @onclick="DismissWarning">✕</button>
            <h3 class="warning-modal-title">@warningTitle</h3>
            <p class="warning-modal-message" style="white-space: pre-line;">@warningMessage</p>
            <button class="warning-modal-button" @onclick="DismissWarning">Got It</button>
        </div>
    </div>
}

<div class="typing-indicator-container">
    @if (isUploading)
    {
        <div class="typing-indicator upload-indicator">
            <div class="upload-progress-row">
                <span class="upload-progress-text">
                    @if (uploadingCount > 1)
                    {
                        @($"File {uploadedFileCount + 1}/{uploadingCount} — {uploadPercent}%")
                    }
                    else
                    {
                        @($"Uploading... {uploadPercent}%")
                    }
                </span>
                <div class="upload-progress-track">
                    <div class="upload-progress-fill" style="width: @uploadPercent%"></div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(typingIndicatorText))
    {
        <div class="typing-indicator">
            <span style="display: flex; align-items: center; gap: 0.5rem; color: #72767d;">
                <span class="typing-dots">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </span>
                <span>@typingIndicatorText</span>
            </span>
        </div>
    }
</div>

@if (ReplyingToMessage != null)
{
    <div class="reply-bar">
        <span class="reply-bar-text">
            Replying to <strong>@(ReplyingToDisplayName ?? ReplyingToMessage.Username)</strong>
        </span>
        <button class="reply-bar-close" @onclick="HandleCancelReply">✕</button>
    </div>
}

@* Drag & drop is fully client-side (setupDropZone in chat.js): dragover fires continuously
   during a drag and must never round-trip; the highlight rides on a JS-set data-dragging
   attribute, which Blazor's diff never touches (unlike this interpolated class attribute). *@
@* Picker visibility and composing state are client-owned view state: chat.js flips
   data-picker / data-composing ATTRIBUTES on this container (its class attribute is
   Blazor-interpolated and would clobber JS classes — the data-dragging precedent), and
   CSS reacts. Opening a picker or focusing the box never waits on the circuit. *@
<div class="message-input-container @(ReplyingToMessage != null ? "has-reply-bar" : "")"
     @ref="dropZoneElement">
    @* Discord-style layout: one rounded box holds the + upload button, the textarea, and
       the picker toggles. The send button sits OUTSIDE the box and is revealed/collapsed
       by pure CSS (:placeholder-shown + data-picker) — none of it waits on the circuit. *@
    <div class="input-box">
        <label class="image-upload-button" title="Upload files">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <InputFile OnChange="HandleFileSelected" accept="image/*,video/*" multiple style="display: none;" id="@FileInputId" />
        </label>
        @* Plain @bind (change granularity): keystrokes never round-trip. The send pipeline
           (chat.js) commits the draft with a synthetic change right before the send click's
           RPC — in-order circuit processing lands it ahead of HandleSend. Typing-indicator
           bursts come from setupTypingTracker, ~2 dispatches per burst.
           The DOM value runs ahead of messageText the whole time the user types. That is safe:
           Blazor rewrites a bound input's value only when the RENDERED value changed between
           renders, so re-renders from typing indicators, pickers or the reply bar leave the
           uncommitted draft alone. The only server writes to messageText are the change events
           (echoing the DOM) and HandleSend's clear (paired with the client-side clear). *@
        <textarea @bind="messageText" placeholder="@placeholder" class="message-input"
                  rows="1" id="@TextareaId"></textarea>
        <div class="emoji-toggle-wrapper">
            @* The pickers mount ONCE in the background (pickersMounted flips ~1.2s after page
               load, or on the first early toggle tap via EnsurePickersMounted) and stay in the
               DOM behind display:none — opening is then a pure CSS attribute flip in chat.js.
               PickerPane stops parent re-render cascades from re-diffing the hidden subtrees. *@
            <button class="gif-toggle-button" data-picker-toggle="gif" title="GIF picker">
                <span class="gif-toggle-badge">GIF</span>
            </button>
            @if (pickersMounted && !isMobileLayout)
            {
                <PickerPane>
                    <div class="emoji-picker-backdrop" data-picker-pane="gif"></div>
                    <div class="emoji-picker-container" data-picker-pane="gif">
                        <GifPicker CurrentUserId="@UserId" CurrentUsername="@Username"
                                   OnGifSelected="HandleGifSelected" OnUploadError="HandleGifUploadError" />
                    </div>
                </PickerPane>
            }
            <button class="emoji-toggle-button" data-picker-toggle="emoji" title="Emoji picker">
                <span class="emoji-toggle-icon" id="@EmojiIconId"
                      style="--grey-col: @greyCol; --grey-row: @greyRow; --color-col: @colorCol; --color-row: @colorRow;"></span>
            </button>
            @if (pickersMounted)
            {
                @* @key: a mobile↔desktop flip must rebuild this pane with the right picker
                   inside — PickerPane blocks ordinary re-renders, so the swap needs the
                   fresh instance a changed key provides. *@
                <PickerPane @key="isMobileLayout">
                    <div class="emoji-picker-backdrop" data-picker-pane="emoji"></div>
                    <div class="emoji-picker-container" data-picker-pane="emoji">
                        @if (isMobileLayout)
                        {
                            <CombinedPicker CurrentUserId="@UserId" CurrentUsername="@Username"
                                            OnGifSelected="HandleGifSelected" OnUploadError="HandleGifUploadError"
                                            RecentEmojis="@RecentEmojis" OnEmojiUsed="@OnEmojiUsed" TextareaId="@TextareaId" />
                        }
                        else
                        {
                            <EmojiPicker RecentEmojis="@RecentEmojis" OnEmojiUsed="@OnEmojiUsed" TextareaId="@TextareaId" />
                        }
                    </div>
                </PickerPane>
            }
        </div>
    </div>
    @* Enter-to-send is client-side (chat.js send pipeline) and the show/hide of this
       button is pure CSS on the box's content state — neither waits on a circuit round
       trip; HandleSend still guards. The button stays in the DOM while collapsed so the
       Enter handler's .click() always has a target. *@
    <button class="send-button"
            @onclick="HandleSend"
            title="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
    </button>
</div>

} @* end else (not ReadOnly) *@

@code {
    // Context parameters - one or the other will be set
    [Parameter] public Guid? RoomId { get; set; }
    [Parameter] public string? DmUser { get; set; }

    // Emoji drawer parameters
    [Parameter] public List<string> RecentEmojis { get; set; } = new();
    [Parameter] public Action<string>? OnEmojiUsed { get; set; }

    // Read-only mode (channel write permissions)
    [Parameter] public bool ReadOnly { get; set; }

    // Upload endpoint URL (empty = relative /api/tus, or full URL for upload subdomain)
    [Parameter] public string UploadUrl { get; set; } = "";

    // Reply parameters
    [Parameter] public ChatMessage? ReplyingToMessage { get; set; }
    [Parameter] public string? ReplyingToDisplayName { get; set; }
    [Parameter] public EventCallback OnCancelReply { get; set; }

    private Guid UserId => UserState.UserId ?? Guid.Empty;
    private string Username => UserState.Username ?? "";
    private bool IsRoomContext => RoomId.HasValue;
    private bool IsDmContext => !string.IsNullOrEmpty(DmUser);

    // The channel ID for the current context
    private Guid? channelId;

    // Internal state
    private ElementReference dropZoneElement;
    private string messageText = "";
    private string placeholder = "";
    private string typingIndicatorText = "";
    private string warningTitle = "";
    private string warningMessage = "";
    // Mirrors the last typing transition the server saw. Keystrokes never reach the
    // server (plain @bind); the JS tracker dispatches burst start/stop only.
    private bool isTyping = false;
    private bool isUploading = false;
    private int uploadingCount = 0;
    private int uploadedFileCount = 0;
    private int uploadPercent = 0;
    private DotNetObjectReference<MessageInput>? _uploadRef;

    // Unique IDs for this instance
    private string TextareaId = $"messageTextarea_{Guid.NewGuid():N}";
    private string FileInputId = $"fileInput_{Guid.NewGuid():N}";
    private bool isMobileLayout = false;
    private bool needsElementSetup = true;  // first render + after the ReadOnly branch recreated the subtree
    private bool wasReadOnly = false;
    private DotNetObjectReference<MessageInput>? _layoutRef;
    private readonly string _layoutWatcherId = Guid.NewGuid().ToString("N");
    // The picker subtrees mount once (hidden) shortly after load; open/close is
    // client-owned (data-picker attribute in chat.js). See MountPickersAfterIdleAsync.
    private bool pickersMounted = false;

    // Emoji button sprite grid: 960x192 PNG, 48px cells = 20 cols x 4 rows
    private const int SpriteCols = 20;
    private const int SpriteTotalEmojis = 73; // 3 full rows + 13 in last row
    private static readonly Random _random = new();
    private string EmojiIconId = $"emojiIcon_{Guid.NewGuid():N}";
    private int greyCol;
    private int greyRow;
    private int colorCol;
    private int colorRow;

    protected override void OnInitialized()
    {
        var greyIndex = _random.Next(SpriteTotalEmojis);
        greyCol = greyIndex % SpriteCols;
        greyRow = greyIndex / SpriteCols;
        var colorIndex = _random.Next(SpriteTotalEmojis);
        colorCol = colorIndex % SpriteCols;
        colorRow = colorIndex / SpriteCols;

        UpdateChannelId();
        UpdatePlaceholder();

        // Subscribe to typing events (unified for all channels)
        ChatService.OnTypingUsersChanged += HandleTypingUsersChanged;

        UpdateTypingIndicator();
    }

    protected override void OnParametersSet()
    {
        var previousChannelId = channelId;
        UpdateChannelId();
        // Typing state is per-channel: a switch mid-burst must stop the indicator in the
        // channel we left, or it lingers there until something else happens to clear it.
        if (isTyping && previousChannelId is { } oldChannelId && oldChannelId != channelId)
        {
            isTyping = false;
            _ = ChatService.StopTypingAsync(oldChannelId, Username);
        }
        UpdatePlaceholder();
        UpdateTypingIndicator();

        // The ReadOnly branch swaps out the entire input subtree; when it swaps back in,
        // the fresh elements need all their element-bound JS wiring re-attached.
        if (wasReadOnly && !ReadOnly) needsElementSetup = true;
        wasReadOnly = ReadOnly;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Viewport watcher is id-keyed and element-independent — once per component lifetime.
            try
            {
                _layoutRef = DotNetObjectReference.Create(this);
                isMobileLayout = await JS.InvokeAsync<bool>("setupMobileLayoutWatcher", _layoutRef, _layoutWatcherId);
                StateHasChanged();
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup mobile layout watcher"); }

            // Mount the (hidden) pickers once the page has settled — off every critical
            // path, so opening them later is a pure CSS flip with zero round trips.
            _ = MountPickersAfterIdleAsync();
        }

        // Element-bound wiring: first render, and again after the ReadOnly branch swapped the
        // input subtree back in (fresh DOM elements — the old listeners died with the old ones).
        if (needsElementSetup && !ReadOnly)
        {
            needsElementSetup = false;
            try { await JS.InvokeVoidAsync("setupDropZone", dropZoneElement, FileInputId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup drop zone"); }
            try { await JS.InvokeVoidAsync("setupEnterKeyHandler", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup enter key handler"); }
            try { await JS.InvokeVoidAsync("setupTextareaAutoResize", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup textarea auto-resize"); }
            try { await JS.InvokeVoidAsync("setupTypingTracker", TextareaId, _layoutRef); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup typing tracker"); }
            try { await JS.InvokeVoidAsync("setupCaretTracking", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup caret tracking"); }
            try { await JS.InvokeVoidAsync("setupSendButtonFocus", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup send button focus"); }
            try { await JS.InvokeVoidAsync("setupEmojiToggle", EmojiIconId, SpriteCols, SpriteTotalEmojis); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup emoji toggle"); }
            try { await JS.InvokeVoidAsync("setupPasteUpload", TextareaId, FileInputId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup paste upload"); }
            try { await JS.InvokeVoidAsync("registerPickerHost", dropZoneElement, _layoutRef); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to register picker host"); }
        }
    }

    /// <summary>
    /// Background mount of the hidden picker subtrees. The delay is a priority hint, not
    /// a contract — a toggle tap that beats it lands in <see cref="EnsurePickersMounted"/>
    /// via chat.js and skips the wait.
    /// </summary>
    private async Task MountPickersAfterIdleAsync()
    {
        await Task.Delay(1200);
        await EnsurePickersMounted();
    }

    [JSInvokable]
    public async Task EnsurePickersMounted()
    {
        if (pickersMounted) return;
        pickersMounted = true;
        try { await InvokeAsync(StateHasChanged); }
        catch { /* circuit may be dead */ }
    }

    [JSInvokable]
    public async Task OnMobileLayoutChanged(bool isMobile)
    {
        if (isMobileLayout == isMobile) return;
        isMobileLayout = isMobile;
        // chat.js already closed any open picker on the flip (client-owned state);
        // this re-render swaps which picker component is mounted for the new layout.
        try { await InvokeAsync(StateHasChanged); }
        catch { /* circuit may be dead */ }
    }

    private void UpdateChannelId()
    {
        if (IsRoomContext)
        {
            channelId = RoomId;
        }
        else if (IsDmContext && !string.IsNullOrEmpty(DmUser))
        {
            var otherUser = UserService.GetByUsername(DmUser);
            if (otherUser != null)
            {
                var channel = ChatService.GetOrCreateDMChannel(UserId, Username, otherUser.Id, otherUser.Username);
                channelId = channel.Id;
            }
            else
            {
                channelId = null;
            }
        }
        else
        {
            channelId = null;
        }
    }

    private void UpdatePlaceholder()
    {
        // Must never be empty: send-button dimming rides on :placeholder-shown,
        // which can't match an empty placeholder attribute.
        placeholder = IsDmContext
            ? $"Message @{DmUser}"
            : ChatConfig.GetRandomMessagePlaceholder() is { Length: > 0 } text ? text : "Say something…";
    }

    #region Typing Indicator

    private void UpdateTypingIndicator()
    {
        if (channelId.HasValue)
        {
            var typingUsers = ChatService.GetTypingUsers(channelId.Value);
            var others = typingUsers.Where(u => !u.Equals(Username, StringComparison.OrdinalIgnoreCase)).ToList();

            if (IsDmContext)
            {
                // Simple DM typing indicator
                typingIndicatorText = others.Count > 0 ? $"{string.Join(", ", others)} is typing..." : "";
            }
            else
            {
                // Room typing indicator with random messages
                typingIndicatorText = ChatConfig.GetRandomTypingIndicator(others, Username);
            }
        }
        else
        {
            typingIndicatorText = "";
        }
    }

    private async void HandleTypingUsersChanged(Guid changedChannelId)
    {
        if (channelId.HasValue && channelId.Value == changedChannelId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    UpdateTypingIndicator();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleTypingUsersChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleTypingUsersChanged");
            }
        }
    }

    // Burst transitions dispatched by the JS typing tracker (setupTypingTracker): Start
    // on the first keystroke of a burst, Stop after 3s idle or when the box empties.
    // The tracker owns the timeout; these stay idempotent via isTyping for the other
    // callers (HandleSend's stop, DisposeAsync's cleanup, the channel-switch stop).
    [JSInvokable]
    public Task ReportTypingStarted() => StartTypingAsync();

    [JSInvokable]
    public Task ReportTypingStopped() => StopTypingAsync();

    private async Task StartTypingAsync()
    {
        if (isTyping || !channelId.HasValue) return;
        isTyping = true;
        await ChatService.StartTypingAsync(channelId.Value, Username);
    }

    private async Task StopTypingAsync()
    {
        if (!isTyping || !channelId.HasValue) return;
        isTyping = false;
        await ChatService.StopTypingAsync(channelId.Value, Username);
    }

    #endregion

    #region Input Handling

    private async Task HandleSend()
    {
        if (string.IsNullOrWhiteSpace(messageText) || !channelId.HasValue) return;

        // Open-picker close and composing-state reset happen client-side in the send
        // pipeline (chat.js) — no server-owned view state is left to clear here.

        // The visible textarea was already cleared + resized client-side by the send
        // pipeline (chat.js) the moment the button was clicked — this resets the
        // server-side copy so the guard above and the binding stay truthful.
        var content = messageText;
        messageText = "";

        try
        {
            await ChatService.SendMessageAsync(channelId.Value, UserId, Username, content, replyToMessageId: ReplyingToMessage?.Id);
            await StopTypingAsync();
            if (ReplyingToMessage != null)
            {
                await OnCancelReply.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send message");
        }
    }

    #endregion

    #region Emoji Picker

    private async Task HandleCancelReply()
    {
        await OnCancelReply.InvokeAsync();
    }

    private async Task HandleGifSelected(Yap.Models.GifAttachment att)
    {
        if (!channelId.HasValue) return;
        // Card taps were already closed client-side by the gif-card listener; uploads
        // through the picker have no card tap, so close here too (idempotent for taps).
        try { await JS.InvokeVoidAsync("closePickers"); } catch { /* circuit may be dead */ }
        try
        {
            await ChatService.SendMessageAsync(channelId.Value, UserId, Username, "",
                replyToMessageId: ReplyingToMessage?.Id,
                gifAttachments: new List<Yap.Models.GifAttachment> { att });
            // Explicit scroll for the sender. The OnMessageReceived → ScrollToBottomAsync chain
            // also fires, but its timing races with MessageInput's picker-close re-render and
            // sometimes lands before the new message's <img> hits the DOM. This call runs after
            // SendMessageAsync's async work is done and reliably hits the latest layout.
            try { await JS.InvokeVoidAsync("scrollToBottom"); } catch { /* circuit may be dead */ }
            if (ReplyingToMessage != null)
                await OnCancelReply.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send GIF message");
        }
    }

    private void HandleGifUploadError(string error)
    {
        // Card-tap failures: the picker was already hidden client-side at tap time, and
        // there is no server-side picker state left to converge. Upload failures: the
        // picker stays open behind the modal, ready for a retry. Both get the explanation.
        ShowWarning("Couldn't send GIF", error);
    }

    #endregion

    #region File Upload

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (!channelId.HasValue) return;

        var fileCount = e.GetMultipleFiles(10).Count;
        if (fileCount == 0) return;

        try
        {
            // Show upload indicator
            isUploading = true;
            uploadingCount = fileCount;
            uploadedFileCount = 0;
            uploadPercent = 0;
            StateHasChanged();

            Logger.LogInformation("Upload started: {Count} file(s) via tus", fileCount);

            // Create DotNetObjectReference for progress callbacks from JS
            _uploadRef?.Dispose();
            _uploadRef = DotNetObjectReference.Create(this);

            // Upload via tus with resumability and progress tracking
            using var uploadCts = new CancellationTokenSource(TimeSpan.FromMinutes(30));
            var maxSizeMB = ChatConfig.MaxUploadSizeMB;
            var tusEndpoint = string.IsNullOrEmpty(UploadUrl) ? "/api/tus" : UploadUrl;

            var result = await JS.InvokeAsync<UploadResult>("uploadFilesWithTus", uploadCts.Token,
                new object[] { FileInputId, maxSizeMB, tusEndpoint, _uploadRef });

            if (!result.Success)
            {
                ShowWarning("Upload failed", result.Error ?? "No valid files selected");
                return;
            }

            // Show warning for partial failures
            if (!string.IsNullOrEmpty(result.Error))
            {
                ShowWarning($"{result.SuccessCount} of {result.TotalCount} files uploaded", result.Error);
            }

            Logger.LogInformation("Upload complete: {Success}/{Total} files", result.SuccessCount, result.TotalCount);

            // Hide indicator before message send
            isUploading = false;
            StateHasChanged();

            // Separate by type (server already did thumbnails/posters). Files the server
            // classified as GIFs come back as library entry ids, not URLs — they post as
            // first-class GIF attachments, same as a picker send.
            var imageUrls = result.Files.Where(f => f.Type == "image" && f.Url != null).Select(f => f.Url!).ToList();
            var videoUrls = result.Files.Where(f => f.Type == "video" && f.Url != null).Select(f => f.Url!).ToList();
            var gifAttachments = result.Files
                .Where(f => f.Type == "gif" && f.GifEntryId is not null)
                .Select(f => new Yap.Models.GifAttachment(f.GifEntryId!.Value, f.Width ?? 0, f.Height ?? 0))
                .ToList();

            if (imageUrls.Count > 0 || videoUrls.Count > 0 || gifAttachments.Count > 0)
            {
                await ChatService.SendMessageAsync(channelId.Value, UserId, Username, "",
                    imageUrls.Count > 0 ? imageUrls : null,
                    videoUrls: videoUrls.Count > 0 ? videoUrls : null,
                    gifAttachments: gifAttachments.Count > 0 ? gifAttachments : null);
                Logger.LogInformation("Message posted with {ImageCount} image(s), {VideoCount} video(s), {GifCount} gif(s)",
                    imageUrls.Count, videoUrls.Count, gifAttachments.Count);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload failed");
            ShowWarning("Upload failed", "Something went wrong while uploading your files");
        }
        finally
        {
            if (isUploading)
            {
                await InvokeAsync(() =>
                {
                    isUploading = false;
                    StateHasChanged();
                });
            }
            uploadingCount = 0;
            uploadedFileCount = 0;
            uploadPercent = 0;
        }
    }

    /// <summary>
    /// Called from JS to update upload progress bar.
    /// </summary>
    [JSInvokable]
    public async Task OnUploadProgress(int percent, int completed, int total)
    {
        uploadPercent = percent;
        uploadedFileCount = completed;
        uploadingCount = total;
        try { await InvokeAsync(StateHasChanged); }
        catch { /* circuit may be dead */ }
    }

    // DTOs for JS interop. Gif results carry an entry id instead of a URL.
    private record UploadResult(bool Success, string? Error, UploadedFile[] Files, int TotalCount, int SuccessCount);
    private record UploadedFile(string? Url, string? Path, string Type, Guid? GifEntryId, int? Width, int? Height);

    private void ShowWarning(string title, string message)
    {
        warningTitle = title;
        warningMessage = message;
    }

    private void DismissWarning()
    {
        warningTitle = "";
        warningMessage = "";
    }

    #endregion

    public async ValueTask DisposeAsync()
    {
        _uploadRef?.Dispose();
        try { await JS.InvokeVoidAsync("teardownMobileLayoutWatcher", _layoutWatcherId); }
        catch { /* circuit may be dead */ }
        _layoutRef?.Dispose();

        // Unsubscribe from events
        ChatService.OnTypingUsersChanged -= HandleTypingUsersChanged;

        // Stop typing if we were
        if (isTyping)
        {
            await StopTypingAsync();
        }
    }
}
