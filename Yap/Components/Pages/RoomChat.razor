@layout ChatLayout
@inherits ChatBase

<PageTitle>@ChatConfig.ProjectName | #@currentContext</PageTitle>

<div class="messages">
    @* messages-flow wraps the whole scrollable content so a pattern layer can span
       its FULL height and scroll natively with the text (the pattern-scroll
       experiment). .messages stays the scroller; this is the flex column now.
       chat.js binds its MutationObservers (ghost reconciler + send telemetry) to
       THIS element's direct children — .message-group items must stay direct
       children of .messages-flow, or ghosts linger and duplicate the sent message. *@
    <div class="messages-flow">
    @if (isLoadingMore)
    {
        <div class="loading-more">
            <div class="loading-spinner"></div>
            <span>Loading older messages...</span>
        </div>
    }
    else if (!hasMoreMessages)
    {
        <div class="history-start">
            @if (historyLimited)
            {
                <span>Older messages are not available in this channel</span>
            }
            else if (!string.IsNullOrEmpty(channelDescription))
            {
                @foreach (var line in channelDescription.Split('\n'))
                {
                    <div>@line</div>
                }
            }
            else
            {
                <span>This is the beginning of #@currentContext</span>
            }
        </div>
    }

    <div class="messages-spacer"></div>
    @for (int i = 0; i < messages.Count; i++)
    {
        var message = messages[i];
        var isSystemMessage = message.Username == "System";
        var showHeader = !isSystemMessage && ShouldShowHeader(i);
        var replyTarget = GetReplyTarget(message);

        @* @key pins each MessageItem to its message: prepends/deletes shift positions, and
           positional matching would hand the editing instance (and its local draft) to a
           different message. Also cheaper diffs on insert/remove. *@
        <MessageItem @key="message.Id"
                     Message="@message"
                     ShowHeader="@showHeader"
                     IsEditing="@(editingMessageId == message.Id)"
                     CurrentUsername="@Username"
                     ProfilePictureUrl="@GetProfilePictureUrl(message.Username)"
                     DisplayName="@GetDisplayName(message.Username)"
                     IsBot="@BotService.IsBotUser(message.Username)"
                     RecentEmojis="@recentEmojis"
                     QuickReactions="@quickReactions"
                     IsReplyTarget="@(replyingToMessage?.Id == message.Id)"
                     ReplyToMessage="@replyTarget"
                     ReplyToDisplayName="@(replyTarget != null ? GetDisplayName(replyTarget.Username) : null)"
                     ReplyToProfilePictureUrl="@(replyTarget != null ? GetProfilePictureUrl(replyTarget.Username) : null)"
                     OnReply="@(() => StartReply(message))"
                     OnScrollToMessage="@(() => ScrollToMessageAsync(message.ReplyToMessageId!.Value))"
                     OnReaction="@(emoji => ToggleReaction(message.Id, emoji))"
                     OnStartEdit="@(() => StartEdit(message))"
                     OnSaveEdit="SaveEdit"
                     OnCancelEdit="CancelEdit"
                     OnDelete="@(() => DeleteMessage(message.Id))"
                     OnImageClick="@(args => ShowGallery(args.Images, args.Index))"
                     LinkPreviews="@GetLinkPreviews(message)" />
    }

    @* JS-owned: optimistic pending-send ghosts render here (chat.js send pipeline).
       Blazor must always render it empty — its children belong to the client. *@
    <div class="pending-echoes"></div>
    </div>
</div>

<MessageInput RoomId="@channelId" RecentEmojis="@recentEmojis" OnEmojiUsed="HandleInputEmojiUsed"
              UploadUrl="@ChatConfig.UploadUrl"
              ReadOnly="@(!canWrite)"
              ReplyingToMessage="@replyingToMessage"
              ReplyingToDisplayName="@(replyingToMessage != null ? GetDisplayName(replyingToMessage.Username) : null)"
              OnCancelReply="CancelReply" />

<ImageGalleryModal Visible="@showImageModal"
                   Images="@modalGallery"
                   Videos="@modalVideoGallery"
                   StartIndex="@modalImageIndex"
                   OnClose="CloseImageModal" />

@code {
    [Parameter] public Guid? RoomId { get; set; }

    // Tracks previous room to detect navigation between rooms (e.g., /lobby -> /room/xyz)
    // without component recreation - Blazor reuses the component and just updates parameters
    private Guid? previousRoomId = null;

    // Channel info
    private string? channelDescription;
    private bool canWrite = true;

    protected override async Task OnParametersSetAsync()
    {
        // Detect room parameter changes (navigating between rooms)
        var newRoomId = RoomId ?? ChatService.GetLobbyId();
        if (previousRoomId.HasValue && previousRoomId.Value != newRoomId)
        {
            await SwitchRoomContentAsync(newRoomId);
        }
        previousRoomId = newRoomId;
    }

    protected override async Task OnInitializedChatAsync()
    {
        // Set current room
        channelId = RoomId ?? ChatService.GetLobbyId();
        previousRoomId = channelId;

        // Load initial messages (most recent page)
        LoadInitialMessages();

        // Mark channel as read (explicit open — always counts as a read)
        await ChatService.MarkChannelAsReadAsync(UserId, channelId, callerSessionId: UserState.SessionId);

        // Set navigation context
        var room = ChatService.GetChannel(channelId);
        currentContext = room?.Name ?? "lobby";
        channelDescription = room?.Description;
        canWrite = ChatService.CanUserWrite(channelId, UserId);
        historyLimited = (room?.HistoryLimit != Models.HistoryLimit.Unlimited || room?.SinceJoined == true) && !ChatService.IsAdmin(UserId);
        NavState.SetRoomContext(channelId, currentContext, ChatConfig.GetRandomRoomHeader(currentContext));
        var route = channelId == ChatService.GetLobbyId() ? "/lobby" : $"/room/{channelId}";
        await JS.InvokeVoidAsync("saveLastRoute", route);

        await UpdatePageTitleAsync();

        // Subscribe to events
        ChatService.OnMessageReceived += HandleMessageReceived;
        ChatService.OnMessageUpdated += HandleMessageUpdated;
        ChatService.OnMessageDeleted += HandleMessageDeleted;
        ChatService.OnReactionChanged += HandleReactionChanged;
        ChatService.OnUserChanged += HandleUserChanged;
        ChatService.OnChannelDeleted += HandleChannelDeleted;
        ChatService.OnChannelUpdated += HandleChannelUpdated;
        ChatService.OnLinkPreviewReady += HandleLinkPreviewReady;
        ChatService.OnMediaCacheReady += HandleLinkPreviewReady;
        GifService.OnGifEntryUpdated += HandleGifEntryUpdated;

        // Queue link preview + media cache fetches for loaded messages
        QueuePreviewsForMessages(messages);
    }

    private async Task SwitchRoomContentAsync(Guid newRoomId)
    {
        channelId = newRoomId;

        // Pending optimistic ghosts belong to the previous channel — their echo can't arrive here
        try { await JS.InvokeVoidAsync("clearPendingEchoes"); } catch { /* circuit may be dead */ }

        // Reset pagination state and load fresh
        ResetPaginationState();
        LoadInitialMessages();

        // Mark channel as read (explicit open — always counts as a read)
        await ChatService.MarkChannelAsReadAsync(UserId, channelId, callerSessionId: UserState.SessionId);

        var room = ChatService.GetChannel(channelId);
        currentContext = room?.Name ?? "lobby";
        channelDescription = room?.Description;
        canWrite = ChatService.CanUserWrite(channelId, UserId);
        historyLimited = (room?.HistoryLimit != Models.HistoryLimit.Unlimited || room?.SinceJoined == true) && !ChatService.IsAdmin(UserId);
        NavState.SetRoomContext(channelId, currentContext, ChatConfig.GetRandomRoomHeader(currentContext));
        ReportSessionViewing();
        var route = channelId == ChatService.GetLobbyId() ? "/lobby" : $"/room/{channelId}";
        await JS.InvokeVoidAsync("saveLastRoute", route);

        await UpdatePageTitleAsync();
        QueuePreviewsForMessages(messages);
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();
    }

    #region Room-Specific Event Handlers

    private async void HandleMessageReceived(ChatMessage message)
    {
        if (message.ChannelId == channelId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    messages.Add(message);
                    StateHasChanged();
                });
                // Mark as read only if THIS device is foreground and not Away — otherwise a
                // backgrounded/away device would clear unread for our other devices.
                if (ShouldMarkReadOnReceive())
                    await ChatService.MarkChannelAsReadAsync(UserId, channelId, silent: true, callerSessionId: UserState.SessionId, source: "receive");
                await InvokeAsync(ScrollToBottomAsync);
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleMessageReceived: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleMessageReceived");
            }
        }

        if (message.Username != Username && message.Username != "System")
        {
            try
            {
                await InvokeAsync(() => HandleNewMessageNotificationAsync(message.Username, isDM: false));
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleMessageReceived notification: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleMessageReceived notification");
            }
        }
    }

    private async void HandleUserChanged(string user, bool isJoining)
    {
        // Add system message in lobby
        var lobbyId = ChatService.GetLobbyId();
        if (channelId == lobbyId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    messages.Add(new ChatMessage(
                        lobbyId,
                        Guid.Empty, // System messages don't have a real user
                        "System",
                        ChatConfig.GetRandomSystemMessage(user, isJoining),
                        DateTime.UtcNow
                    ));
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleUserChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleUserChanged");
            }
        }
    }

    private async void HandleChannelDeleted(Guid deletedChannelId)
    {
        if (channelId == deletedChannelId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    Navigation.NavigateTo("/lobby", replace: true);
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleChannelDeleted: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleChannelDeleted");
            }
        }
    }

    private async void HandleChannelUpdated(Channel channel)
    {
        if (channel.Id == channelId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    channelDescription = channel.Description;
                    canWrite = channel.CanWrite(UserId, ChatService.IsAdmin(UserId));
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleChannelUpdated: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleChannelUpdated");
            }
        }
    }

    private async void HandleLinkPreviewReady(Guid messageId)
    {
        if (messages.Any(m => m.Id == messageId))
        {
            try
            {
                // Best-effort: this fires off a background event (OG scrape / yt-dlp media cache)
                // and the JS round-trip can be canceled when the circuit is busy (e.g. the heavy
                // YouTube media-cache path). A failed measurement must NOT skip the StateHasChanged
                // below — otherwise the scraped preview never renders.
                bool wasNearBottom = false;
                try { wasNearBottom = await JS.InvokeAsync<bool>("isNearBottom", 100); }
                catch { /* couldn't measure scroll position; render anyway, skip auto-scroll */ }

                await InvokeAsync(StateHasChanged);
                if (wasNearBottom)
                {
                    await Task.Delay(50);
                    await ScrollToBottomAsync();
                }
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException or JSDisconnectedException or OperationCanceledException)
                    Logger.LogWarning("HandleLinkPreviewReady: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleLinkPreviewReady");
            }
        }
    }

    private async void HandleGifEntryUpdated(Guid gifEntryId)
    {
        if (!messages.Any(m => m.GifAttachments.Any(a => a.GifEntryId == gifEntryId))) return;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleGifEntryUpdated: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleGifEntryUpdated");
        }
    }

    #endregion

    public override async ValueTask DisposeAsync()
    {
        ChatService.OnMessageReceived -= HandleMessageReceived;
        ChatService.OnMessageUpdated -= HandleMessageUpdated;
        ChatService.OnMessageDeleted -= HandleMessageDeleted;
        ChatService.OnReactionChanged -= HandleReactionChanged;
        ChatService.OnUserChanged -= HandleUserChanged;
        ChatService.OnChannelDeleted -= HandleChannelDeleted;
        ChatService.OnChannelUpdated -= HandleChannelUpdated;
        ChatService.OnLinkPreviewReady -= HandleLinkPreviewReady;
        ChatService.OnMediaCacheReady -= HandleLinkPreviewReady;
        GifService.OnGifEntryUpdated -= HandleGifEntryUpdated;

        // Mark channel as read when leaving — only if this device was foreground and not Away, so an
        // evicted/backgrounded circuit's teardown doesn't clear unread for our other devices.
        if (channelId != Guid.Empty && UserId != Guid.Empty && ShouldMarkReadOnReceive())
        {
            await ChatService.MarkChannelAsReadAsync(UserId, channelId, callerSessionId: UserState.SessionId, source: "dispose");
        }

        await base.DisposeAsync();
    }
}
