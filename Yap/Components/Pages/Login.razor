@page "/login"
@using Yap.Helpers
@inject ChatConfigService ChatConfig
@inject UserService UserService
@inject UserStateService UserState
@inject SystemBotService BotService
@inject RegistrationGateService RegistrationGate
@inject AccessLinkService AccessLinks
@inject ChatService ChatService
@inject IHttpContextAccessor HttpContextAccessor
@inject UserActionLogService ActionLog
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@ChatConfig.ProjectName</PageTitle>

<div class="username-container">
    @if (_state == LoginState.Closed)
    {
        <h2>Registration is temporarily closed</h2>
        <div class="closed-message">
            <p>New signups are not being accepted right now. Please check back later.</p>
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
    else if (_state == LoginState.WaitingApproval)
    {
        <h2>Waiting for approval</h2>
        <div class="waiting-message">
            <div class="waiting-spinner"></div>
            <p>Your request to join as <strong>@usernameInput</strong> has been submitted.</p>
            <p class="waiting-hint">An admin will review your request shortly. This page will update automatically.</p>
            @if (_wasRejected)
            {
                <p class="rejection-notice">Your previous request was not approved. You can try a different username.</p>
                <button class="join-button" @onclick="ResetToForm">Try again</button>
            }
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
    else
    {
        <h2>@welcomeMessage</h2>
        <div class="username-form">
            <div class="username-form-row">
                <input type="text" @bind="usernameInput" @bind:event="oninput" @bind:after="ValidateUsername"
                       placeholder="@usernamePlaceholder" class="username-input @(showError ? "invalid" : "")"
                       @onkeypress="HandleUsernameKeyPress" @onblur="OnInputBlur" maxlength="23" />
                <button class="join-button" @onclick="JoinChat"
                        disabled="@(!IsValid)">
                    @joinButtonText
                </button>
            </div>
            @if (showError && !_showMultiDeviceGuide)
            {
                <div class="validation-error">
                    @errorMessage
                </div>
            }
            @if (_willCreateNewAccount && !showError && !_showMultiDeviceGuide)
            {
                <div class="new-account-hint">
                    New here? Joining creates a fresh account named <strong>@usernameInput</strong>.
                </div>
            }
            @if (_showMultiDeviceGuide)
            {
                <div class="multidevice-guide">
                    @if (_isStandalone)
                    {
                        <strong>Almost there!</strong> <span>This installed app starts signed out — your login for <strong>@usernameInput</strong> stayed in the browser you joined from.</span>
                        <ol>
                            <li>Open <strong>@ChatConfig.ProjectName</strong> in your browser — you should still be logged in there</li>
                            <li>In <strong>Settings → Login Link</strong>, copy your link (create one if there isn't one), or just read its code</li>
                            <li>Open the link here, or come back and type the code</li>
                        </ol>
                    }
                    else
                    {
                        <strong>Almost there!</strong> <span>To log in as <strong>@usernameInput</strong> on this device:</span>
                        <ol>
                            <li>Open the app on the device where you're already logged in</li>
                            <li>In <strong>Settings → Login Link</strong>, copy your link (create one if there isn't one), or just read its code</li>
                            <li>Open the link on this device, or come back here and type the code</li>
                        </ol>
                    }
                    <button type="button" @onclick="RetryMultiDevice" class="retry-link">Done, try again</button>
                </div>
            }
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    // Set when /auth/signin bounced the attempt (currently only reason=displayname),
    // with the rejected name echoed back so the form can explain in place.
    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    [SupplyParameterFromQuery(Name = "u")]
    public string? AttemptedName { get; set; }

    private enum LoginState { Normal, Closed, WaitingApproval }
    private LoginState _state = LoginState.Normal;

    private string usernameInput = "";
    private string welcomeMessage = "";
    private string joinButtonText = "";
    private string usernamePlaceholder = "";
    private string errorMessage = "";
    private bool hasError = false;
    private bool isLengthError = false;
    private bool hasBlurred = false;
    private bool _shouldRedirect = false;
    private bool _usernameHasPassword = false;
    private bool _smartModeMatch = false;
    private bool _showMultiDeviceGuide = false;
    private bool _wasRejected = false;
    private bool _willCreateNewAccount = false;
    private bool _isStandalone = false;

    private Timer? _pollTimer;
    private string? _clientIp;
    private string? _clientUa;

    private bool IsValid => !string.IsNullOrWhiteSpace(usernameInput) && !_showMultiDeviceGuide && (!hasError || _usernameHasPassword || _smartModeMatch);

    // Only show length errors after user has blurred the input (finished typing)
    private bool showError => hasError && (!isLengthError || hasBlurred);

    // Validated return URL (must be relative path to prevent open redirect)
    private string? SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : null;

    protected override void OnInitialized()
    {
        // Capture IP and User-Agent during initial render (HttpContext is null after this during SignalR callbacks)
        _clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();
        _clientUa = HttpContextAccessor.HttpContext?.Request.Headers.UserAgent.ToString();

        // Already authenticated (via cookie - UserState populated by AuthMiddleware)
        // Verify user still exists in database before redirecting
        if (UserState.IsLoggedIn && UserState.UserId.HasValue)
        {
            var existingUser = UserService.GetById(UserState.UserId.Value);
            if (existingUser != null)
            {
                _shouldRedirect = true;
                return;
            }
            else
            {
                // User no longer exists - clear the stale state
                UserState.UserId = null;
                UserState.Username = null;
                UserState.DisplayName = null;
                UserState.ProfilePictureUrl = null;
                UserState.SessionId = null;
                UserState.Status = UserStatus.Online;
            }
        }

        // Check if registration is closed (new visitors only)
        if (RegistrationGate.RegistrationClosed)
        {
            _state = LoginState.Closed;
            ActionLog.Log(null, UserActionLog.KnownActions.LOGIN_FAIL, info: "registration_closed", ip: _clientIp, userAgent: _clientUa);
            return;
        }

        // Track anonymous visitor
        ActionLog.Log(null, UserActionLog.KnownActions.VISIT, ip: _clientIp, userAgent: _clientUa);

        welcomeMessage = ChatConfig.GetRandomWelcomeMessage();
        joinButtonText = ChatConfig.GetRandomJoinButtonText();
        usernamePlaceholder = ChatConfig.GetRandomUsernamePlaceholder();

        // Bounced back by the /auth/signin display-name guard: re-show the typed name so
        // ValidateUsername flags it in place with the full explanation.
        if (Reason == "displayname" && !string.IsNullOrWhiteSpace(AttemptedName))
        {
            usernameInput = AttemptedName;
            hasBlurred = true;
            ValidateUsername();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            var destination = SafeReturnUrl ?? "/lobby";
            Navigation.NavigateTo(destination, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // Standalone = running as the installed app. Its cookie jar can start empty,
            // so the multi-device guide must not send these users to an "original device"
            // — this IS that device; the login they're missing lives in the browser
            // sitting right next to this app.
            _isStandalone = await JS.InvokeAsync<bool>("isPwaInstalled");
        }
        catch (Exception)
        {
            // Cosmetic only — fall back to the generic guide wording
        }
    }

    private void ValidateUsername()
    {
        hasError = false;
        isLengthError = false;
        errorMessage = "";
        _usernameHasPassword = false;
        _smartModeMatch = false;
        _showMultiDeviceGuide = false;
        _willCreateNewAccount = false;

        if (string.IsNullOrWhiteSpace(usernameInput))
            return;

        // Shape rules live in UsernameRules, shared with the invite page and endpoint
        var shapeError = UsernameRules.Check(usernameInput, out var normalized);
        if (normalized != usernameInput)
        {
            usernameInput = normalized;
        }

        if (shapeError != null)
        {
            hasError = true;
            isLengthError = usernameInput.Length < UsernameRules.MinLength;
            errorMessage = shapeError;
            return;
        }

        // Bot username is reserved
        if (BotService.IsBotUser(usernameInput))
        {
            hasError = true;
            errorMessage = "Nice try! 🤖";
            return;
        }

        // A display name is not a login. Letting it through would silently create a
        // doppelgänger account (and duplicate DM channels), so block with an explanation.
        // Real usernames win: this only runs when no account has the typed name.
        if (!UserService.IsUsernameTaken(usernameInput))
        {
            if (UserService.FindByDisplayName(usernameInput) is not null)
            {
                hasError = true;
                errorMessage = $"\"{usernameInput}\" is a member's display name. If that's you, log in with your original username — changing your display name never changes your login. Otherwise, pick a different name.";
                return;
            }

            // Genuinely new name: make it obvious that joining creates a fresh account.
            _willCreateNewAccount = true;
        }
    }

    /// <summary>
    /// Checks username-taken scenarios (smart mode, secret code, multi-device guide).
    /// Called on submit, not on every keystroke — avoids premature prompts while typing.
    /// </summary>
    private void CheckExistingUsername()
    {
        _usernameHasPassword = false;
        _smartModeMatch = false;
        _showMultiDeviceGuide = false;

        if (!UserService.IsUsernameTaken(usernameInput))
            return;

        // Smart mode: auto-login if same IP as an active session (unless user opted out)
        if (RegistrationGate.SmartMode)
        {
            var targetUser = UserService.GetByUsername(usernameInput);
            if (targetUser != null && !targetUser.SmartLoginOptOut)
            {
                var clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();
                // Live session OR recently-seen IP (persisted, 14-day TTL) — mirrors HandleSignIn
                if (ChatService.HasActiveSessionFromIp(usernameInput, clientIp)
                    || UserService.HasRecentKnownIp(usernameInput, clientIp))
                {
                    _smartModeMatch = true;
                    return;
                }
            }
        }

        // A passphrase or a login link: either one goes to the verify page, where the link's
        // code is accepted as the secret code.
        var target = UserService.GetByUsername(usernameInput);
        if (UserService.HasPassword(usernameInput) || (target != null && AccessLinks.HasActiveLink(target.Id)))
        {
            _usernameHasPassword = true;
        }
        else
        {
            _showMultiDeviceGuide = true;
            ActionLog.Log(null, UserActionLog.KnownActions.LOGIN_FAIL, info: $"multi_device_blocked:{usernameInput}", ip: _clientIp, userAgent: _clientUa);
        }
    }

    private void RetryMultiDevice()
    {
        CheckExistingUsername();

        // If secret code is now enabled, go straight to verify page
        if (_usernameHasPassword || _smartModeMatch)
        {
            JoinChat();
        }
    }

    private void HandleUsernameKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsValid) JoinChat();
    }

    private void OnInputBlur()
    {
        hasBlurred = true;
    }

    private void JoinChat()
    {
        if (!IsValid) return;

        // Check existing username on submit (not during typing)
        CheckExistingUsername();
        if (_showMultiDeviceGuide) return;

        var username = Uri.EscapeDataString(usernameInput.Trim());
        var returnUrl = SafeReturnUrl ?? "/lobby";

        // Smart mode match — same IP as active session, auto-login
        if (_smartModeMatch)
        {
            Navigation.NavigateTo($"/auth/signin?username={username}&returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return;
        }

        // Username with password — redirect to verify page (stays in Blazor)
        if (_usernameHasPassword)
        {
            var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
            Navigation.NavigateTo($"/verify/{username}?returnUrl={encodedReturnUrl}");
            return;
        }

        // Approval mode — add to pending set and wait
        if (RegistrationGate.RequireApproval)
        {
            var trimmed = usernameInput.Trim();
            if (!RegistrationGate.AddPendingUser(trimmed))
            {
                // Already pending
                hasError = true;
                errorMessage = "This username is already waiting for approval";
                return;
            }

            _state = LoginState.WaitingApproval;
            _wasRejected = false;

            // Notify admin via bot
            _ = BotService.NotifyAdminOfPendingUserAsync(trimmed);

            // Start polling for approval/rejection
            StartPolling();
            return;
        }

        // Normal mode — redirect to signin endpoint (creates user + sets cookie)
        var encodedReturn = Uri.EscapeDataString(returnUrl);
        Navigation.NavigateTo($"/auth/signin?username={username}&returnUrl={encodedReturn}", forceLoad: true);
    }

    private void StartPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = new Timer(async _ =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    var username = usernameInput.Trim();

                    if (RegistrationGate.IsApproved(username))
                    {
                        // Approved! Redirect to create the account (HandleSignIn will consume the approval)
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                        var encodedUsername = Uri.EscapeDataString(username);
                        var returnUrl = SafeReturnUrl ?? "/lobby";
                        var encodedReturn = Uri.EscapeDataString(returnUrl);
                        Navigation.NavigateTo($"/auth/signin?username={encodedUsername}&returnUrl={encodedReturn}", forceLoad: true);
                        return;
                    }

                    if (RegistrationGate.IsRejected(username))
                    {
                        // Rejected — consume so it doesn't show again
                        RegistrationGate.ConsumeRejection(username);
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                        _wasRejected = true;
                        StateHasChanged();
                        return;
                    }
                });
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void ResetToForm()
    {
        _state = LoginState.Normal;
        _wasRejected = false;
        usernameInput = "";
        hasError = false;
        _willCreateNewAccount = false;
        welcomeMessage = ChatConfig.GetRandomWelcomeMessage();
        joinButtonText = ChatConfig.GetRandomJoinButtonText();
        usernamePlaceholder = ChatConfig.GetRandomUsernamePlaceholder();
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
