@page "/verify/{Username}"
@inject UserService UserService
@inject AccessLinkService AccessLinks
@inject UserActionLogService ActionLog
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Verify — @Username</PageTitle>

<div class="verify-container">
    <h2>Welcome back, @Username</h2>
    <p class="verify-hint">Enter your secret code, or the code from your login link.</p>
    <div class="verify-form">
        <div class="input-wrapper">
            <input type="text" @bind="passwordInput" @bind:event="oninput"
                   placeholder="e.g. blue fox 4821" class="verify-input @(showError ? "invalid" : "")"
                   @onkeypress="HandleKeyPress" />
            @if (showError)
            {
                <span class="validation-error">@errorMessage</span>
            }
        </div>
        <button class="verify-button" @onclick="Submit"
                disabled="@(string.IsNullOrWhiteSpace(passwordInput))">
            Sign In
        </button>
    </div>
    <button class="back-link" @onclick="GoBack">Use a different username</button>
</div>

@code {
    [Parameter]
    public string Username { get; set; } = "";

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string passwordInput = "";
    private string errorMessage = "";
    private bool showError = false;
    private string? _clientIp;

    private string? SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : null;

    protected override void OnInitialized()
    {
        _clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();

        // Nothing to verify against: unknown user, or neither a passphrase nor a login link
        var user = UserService.GetByUsername(Username);
        if (user == null || (!UserService.HasPassword(Username) && !AccessLinks.HasActiveLink(user.Id)))
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(passwordInput))
            Submit();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(passwordInput)) return;

        showError = false;
        errorMessage = "";

        if (AccessLinks.IsBraked)
        {
            showError = true;
            errorMessage = "Too many attempts. Try again in a few minutes.";
            return;
        }

        // Passphrase or the user's login-link code; the endpoint re-checks both before it
        // sets the cookie. Misses feed the same brake as the invite page.
        var code = passwordInput.Trim();
        var user = UserService.VerifyPassword(Username, code);
        if (user == null && UserService.GetByUsername(Username) is { } owner && AccessLinks.VerifyCodeForUser(owner.Id, code) != null)
            user = owner;

        if (user == null)
        {
            AccessLinks.RecordFailure();
            showError = true;
            errorMessage = "Wrong code";
            ActionLog.Log(null, UserActionLog.KnownActions.LOGIN_FAIL, info: $"wrong_passphrase:{Username}", ip: _clientIp);
            return;
        }

        // POST via hidden form to avoid password in URL (browser history, logs, encoding issues)
        var returnUrl = SafeReturnUrl ?? "/lobby";
        await JS.InvokeVoidAsync("submitSigninForm", Username, passwordInput.Trim(), returnUrl);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/login");
    }
}
