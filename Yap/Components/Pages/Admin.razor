    private static string FormatAge(DateTime createdAt) => (DateTime.UtcNow - createdAt) switch
    {
        { TotalHours: >= 1 } age => $"{(int)age.TotalHours}h {age.Minutes}m",
        var age => $"{Math.Max(0, (int)age.TotalMinutes)}m"
    };

    private static string FormatAgo(DateTime? at) => at is DateTime t
        ? (DateTime.UtcNow - t) switch
        {
            { TotalSeconds: < 120 } ago => $"{Math.Max(0, (int)ago.TotalSeconds)}s ago",
            { TotalMinutes: < 120 } ago => $"{(int)ago.TotalMinutes}m ago",
            var ago => $"{(int)ago.TotalHours}h ago"
        }
        : "never";

