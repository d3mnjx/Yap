    private async Task DebounceFilterAsync(CancellationToken token, Func<Task> loadAction)
    {
        try
        {
            await Task.Delay(500, token);
            await InvokeAsync(async () => { await loadAction(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _logFilterCts?.Cancel();
        _logFilterCts?.Dispose();
        _mediaFilterCts?.Cancel();
        _mediaFilterCts?.Dispose();
        _diagTimer?.Dispose();

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroyAllCharts");
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

