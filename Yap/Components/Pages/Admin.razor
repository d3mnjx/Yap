    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Admin.razor.js");
        }
    }

    private async Task SelectDiagnosticsTab()
    {
        activeSection = "diagnostics";
        if (!diagLoaded)
        {
            diagLoaded = true;
            await LoadDiagnostics();
            _diagTimer = new System.Threading.Timer(async _ =>
            {
                if (activeSection != "diagnostics") return;
                await InvokeAsync(async () =>
                {
                    try
                    {
                        await LoadDiagnostics();
                        StateHasChanged();
                    }
                    catch (ObjectDisposedException) { }
                    catch (InvalidOperationException) { }
                });
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
        else
        {
            await LoadDiagnostics();
        }
    }

    private async Task LoadDiagnostics()
    {
        var snapshots = DiagCollector.GetSnapshots();
        diagLatest = DiagCollector.GetLatest();
        diagCircuits = CircuitTracker.GetAllCircuits()
            .OrderByDescending(c => c.IsConnected)
            .ThenBy(c => c.Username)
            .ToList();
        diagClosedCircuits = CircuitTracker.GetRecentlyClosed();
        // The system bot is not a real client: its always-online pseudo-session has no circuit,
        // and audit rows where the bot is the recipient (no device, no badge) are pure noise.
        // Rows where the bot SENDS to a real user stay — those are genuine pushes worth auditing.
        diagSessions = ChatService.GetAllSessions()
            .Where(s => !BotService.IsBotUser(s.Username))
            .OrderBy(s => s.Username)
            .ThenBy(s => s.CreatedAt)
            .ToList();
        diagCircuitById = diagCircuits.ToDictionary(c => c.CircuitId);
        diagPushDecisions = Audit.GetPushDecisions().Where(d => !BotService.IsBotUser(d.To)).ToList();
        diagPushResults = Audit.GetPushResults().Where(r => !BotService.IsBotUser(r.To)).ToList();
        diagUnreadChanges = Audit.GetUnreadChanges().Where(u => !BotService.IsBotUser(u.User)).ToList();

        if (_jsModule == null || snapshots.Count == 0) return;

        var labels = snapshots.Select(s => s.Timestamp.ToString("HH:mm")).ToArray();

        try
        {
            // Users & Sessions chart
            await _jsModule.InvokeVoidAsync("createOrUpdateChart", "diag-chart-users", labels, new[]
            {
                new { label = "Unique Users", data = snapshots.Select(s => s.UniqueUsers).ToArray(),
                      borderColor = "#3ba55c", backgroundColor = "rgba(59,165,92,0.1)" },
                new { label = "Sessions", data = snapshots.Select(s => s.UserSessions).ToArray(),
                      borderColor = "#5865f2", backgroundColor = "rgba(88,101,242,0.1)" }
            });

            // Circuits chart
            await _jsModule.InvokeVoidAsync("createOrUpdateChart", "diag-chart-circuits", labels, new[]
            {
                new { label = "Active", data = snapshots.Select(s => s.ActiveCircuits).ToArray(),
                      borderColor = "#3ba55c", backgroundColor = "rgba(59,165,92,0.1)" },
                new { label = "Disconnected", data = snapshots.Select(s => s.DisconnectedCircuits).ToArray(),
                      borderColor = "#faa61a", backgroundColor = "rgba(250,166,26,0.1)" }
            });

            // Messages chart
            await _jsModule.InvokeVoidAsync("createOrUpdateChart", "diag-chart-messages", labels, new[]
            {
                new { label = "Total Messages", data = snapshots.Select(s => s.TotalMessages).ToArray(),
                      borderColor = "#5865f2", backgroundColor = "rgba(88,101,242,0.15)", fill = true }
            });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // Formatting for the circuits telemetry table — "—" marks values that client hasn't reported yet
