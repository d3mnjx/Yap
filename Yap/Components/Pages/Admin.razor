    private static string FormatVisitorInfo(string? info)
    {
        if (string.IsNullOrEmpty(info)) return "---";

        var parts = info.Split(':', 2);
        var reason = parts[0] switch
        {
            "wrong_passphrase" => "Wrong passphrase",
            "multi_device_blocked" => "Multi-device blocked",
            "registration_closed" => "Registration closed",
            "bot_username" => "Bot username",
            "ip_mismatch" => "IP mismatch",
            "approval_not_consumed" => "Approval pending",
            _ => parts[0]
        };

        return parts.Length > 1 && !string.IsNullOrEmpty(parts[1])
            ? $"{reason} ({parts[1]})"
            : reason;
    }

