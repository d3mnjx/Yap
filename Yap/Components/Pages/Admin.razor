@page "/admin"
@inject UserStateService UserState
@inject UserService UserService
@inject ChatService ChatService
@inject ChatConfigService ChatConfig
@inject UserActionLogService ActionLog
@inject PushSubscriptionStore PushStore
@inject PushNotificationService PushService
@inject GeoLocationService GeoLocation
@inject SystemBotService BotService
@inject RegistrationGateService RegistrationGate
@inject AccessLinkService AccessLinks
@inject LinkPreviewSettingsService LinkPreviewSettings
@inject MediaCacheService MediaCacheService
@inject Yap.Services.Gifs.GifAdminSettingsService GifAdminSettings
@inject Yap.Services.Gifs.GifService GifService
@inject MediaUploadLogService MediaLog
@inject VideoService VideoService
@inject NavigationManager Navigation
@inject DiagnosticsCollectorService DiagCollector
@inject CircuitTracker CircuitTracker
@inject NotificationAudit Audit
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Admin</PageTitle>

<div class="admin-page">
    <nav class="admin-sidebar">
        <div class="admin-sidebar-header">
            <button class="back-button" @onclick="GoBack" title="Go back">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
            </button>
            <h2>Admin</h2>
        </div>
        <button class="nav-item @(activeSection == "users" ? "active" : "")"
                @onclick='() => activeSection = "users"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 8.00598C14 10.211 12.206 12.006 10 12.006C7.795 12.006 6 10.211 6 8.00598C6 5.80098 7.795 4.00598 10 4.00598C12.206 4.00598 14 5.80098 14 8.00598ZM2 19.006C2 15.473 5.29 13.006 10 13.006C14.711 13.006 18 15.473 18 19.006V20.006H2V19.006Z"/>
                <path d="M20.0001 20.006H22.0001V19.006C22.0001 16.4433 20.2697 14.4415 17.5213 13.5352C19.0621 14.9127 20.0001 16.8059 20.0001 19.006V20.006Z"/>
                <path d="M14.8834 11.9077C16.6657 11.5044 18.0001 9.9077 18.0001 8.00598C18.0001 5.96916 16.4693 4.28218 14.4971 4.0367C15.4322 5.09511 16.0001 6.48524 16.0001 8.00598C16.0001 9.44888 15.4889 10.7742 14.6378 11.8102C14.7203 11.8734 14.8022 11.9388 14.8834 11.9077Z"/>
            </svg>
            <span>Users</span>
        </button>
        <button class="nav-item @(activeSection == "debug" ? "active" : "")"
                @onclick='() => activeSection = "debug"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 8h-2.81c-.45-.78-1.07-1.45-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5s-.96.06-1.41.17L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"/>
            </svg>
            <span>Debug</span>
        </button>
        <button class="nav-item @(activeSection == "bot" ? "active" : "")"
                @onclick='() => activeSection = "bot"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1.17A7 7 0 0 1 14 22h-4a7 7 0 0 1-6.83-3H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2zM9.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm5 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
            </svg>
            <span>Bot</span>
        </button>
        <button class="nav-item @(activeSection == "settings" ? "active" : "")"
                @onclick='() => activeSection = "settings"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"/>
            </svg>
            <span>Settings</span>
        </button>
        <button class="nav-item @(activeSection == "invites" ? "active" : "")"
                @onclick='() => activeSection = "invites"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
            </svg>
            <span>Invites</span>
        </button>
        <button class="nav-item @(activeSection == "logs" ? "active" : "")"
                @onclick="SelectLogsTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 9h-2v2H9v-2H7v-2h2V7h2v2h2v2zm-3 8H8v-6h2v6zm4 0h-2v-4h2v4zm4 0h-2v-8h2v8zm-2-14V3.5L18.5 9H13z"/>
            </svg>
            <span>Logs</span>
        </button>
        <button class="nav-item @(activeSection == "media" ? "active" : "")"
                @onclick="SelectMediaTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/>
            </svg>
            <span>Media</span>
        </button>
        <button class="nav-item @(activeSection == "gifs" ? "active" : "")"
                @onclick="SelectGifsTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 3v2h-2V3H8v2H6V3H4v18h2v-2h2v2h8v-2h2v2h2V3h-2zM8 17H6v-2h2v2zm0-4H6v-2h2v2zm0-4H6V7h2v2zm10 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2z"/>
            </svg>
            <span>GIFs</span>
        </button>
        <button class="nav-item @(activeSection == "diagnostics" ? "active" : "")"
                @onclick="SelectDiagnosticsTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
            </svg>
            <span>Diagnostics</span>
        </button>
        <button class="nav-item @(activeSection == "visitors" ? "active" : "")"
                @onclick="SelectVisitorsTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
            </svg>
            <span>Visitors</span>
        </button>
    </nav>

    <div class="admin-tabs">
        <button class="tab-item @(activeSection == "users" ? "active" : "")"
                @onclick='() => activeSection = "users"'>
            Users
        </button>
        <button class="tab-item @(activeSection == "debug" ? "active" : "")"
                @onclick='() => activeSection = "debug"'>
            Debug
        </button>
        <button class="tab-item @(activeSection == "bot" ? "active" : "")"
                @onclick='() => activeSection = "bot"'>
            Bot
        </button>
        <button class="tab-item @(activeSection == "settings" ? "active" : "")"
                @onclick='() => activeSection = "settings"'>
            Settings
        </button>
        <button class="tab-item @(activeSection == "invites" ? "active" : "")"
                @onclick='() => activeSection = "invites"'>
            Invites
        </button>
        <button class="tab-item @(activeSection == "logs" ? "active" : "")"
                @onclick="SelectLogsTab">
            Logs
        </button>
        <button class="tab-item @(activeSection == "media" ? "active" : "")"
                @onclick="SelectMediaTab">
            Media
        </button>
        <button class="tab-item @(activeSection == "gifs" ? "active" : "")"
                @onclick="SelectGifsTab">
            GIFs
        </button>
        <button class="tab-item @(activeSection == "diagnostics" ? "active" : "")"
                @onclick="SelectDiagnosticsTab">
            Diagnostics
        </button>
        <button class="tab-item @(activeSection == "visitors" ? "active" : "")"
                @onclick="SelectVisitorsTab">
            Visitors
        </button>
    </div>

    <main class="admin-content">
        @if (activeSection == "users")
        {
            <div class="section-header">
                <h3>Users</h3>
                <span class="section-count">@users.Count registered</span>
            </div>

            <div class="table-wrapper">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Status</th>
                            <th>PWA</th>
                            <th>Created</th>
                            <th>Last Action</th>
                            <th>Locale</th>
                            <th>Recent IPs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            var isOnline = onlineStatusMap.TryGetValue(user.Username, out var statusInfo);
                            var statusClass = isOnline ? statusInfo.Status.ToString().ToLower() : "offline";
                            var statusLabel = isOnline ? statusInfo.Status.ToString() : "Offline";
                            lastActions.TryGetValue(user.Id.ToString(), out var lastAction);
                            recentIPs.TryGetValue(user.Id.ToString(), out var ips);
                            var uid = user.Id;

                            <tr class="clickable-row @(selectedUserId == uid ? "selected" : "")"
                                @onclick="() => SelectUser(uid)">
                                <td class="user-cell">
                                    <Avatar Username="@user.Username"
                                            ProfilePictureUrl="@user.ProfilePictureUrl"
                                            Size="AvatarSize.Small" />
                                    <div class="user-info">
                                        <span class="user-name">
                                            @user.EffectiveDisplayName
                                            @if (user.IsAdmin)
                                            {
                                                <span class="admin-badge" title="Admin">&#x1F451;</span>
                                            }
                                        </span>
                                        @if (user.DisplayName != null)
                                        {
                                            <span class="user-username">@user.Username</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill @statusClass">
                                        <span class="status-dot"></span>
                                        @statusLabel
                                    </span>
                                </td>
                                <td class="pwa-cell">
                                    @if (user.PwaInstalledAt.HasValue)
                                    {
                                        <span class="pwa-badge" title="Last seen as installed PWA: @user.PwaInstalledAt.Value.ToString("yyyy-MM-dd HH:mm")">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                            </svg>
                                            Installed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                                <td class="date-cell">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="action-cell">
                                    @if (lastAction != null)
                                    {
                                        <span class="action-type">@lastAction.Action</span>
                                        <span class="action-date">@lastAction.Date.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                                <td class="locale-cell">
                                    @if (user.TimeZone != null)
                                    {
                                        <span class="locale-tz" title="@user.TimeZone">@user.TimeZone</span>
                                        <span class="locale-lang">@user.Locale</span>
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                                <td class="ip-cell">
                                    @if (ips != null && ips.Count > 0)
                                    {
                                        @foreach (var ip in ips)
                                        {
                                            var geo = GeoLocation.IsAvailable ? GeoLocation.Lookup(ip)?.ToString() : null;
                                            <span class="ip-tag" title="@(geo ?? "")">@ip</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                            </tr>
                            @if (selectedUserId == uid && selectedUser != null)
                            {
                                <tr class="detail-row">
                                    <td colspan="7">
                <div class="user-detail-panel">
                    <div class="detail-header">
                        <Avatar Username="@selectedUser.Username"
                                ProfilePictureUrl="@selectedUser.ProfilePictureUrl"
                                Size="AvatarSize.Medium" />
                        <div class="detail-header-info">
                            <h4>@selectedUser.EffectiveDisplayName</h4>
                            @if (selectedUser.DisplayName != null)
                            {
                                <span class="user-username">@selectedUser.Username</span>
                            }
                        </div>
                        <button class="detail-close" @onclick="() => selectedUserId = null" title="Close">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                        </button>
                    </div>

                    @if (loadingDetail)
                    {
                        <div class="detail-loading">Loading...</div>
                    }
                    else
                    {
                        <div class="detail-tags">
                            <span class="detail-tag @(detailPushSubCount > 0 ? "tag-green" : "tag-muted")">
                                @if (detailPushSubCount > 0)
                                {
                                    <span>Push @detailPushSubCount sub@(detailPushSubCount != 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span>No push</span>
                                }
                            </span>
                            <span class="detail-tag @(selectedUser!.PwaInstalledAt.HasValue ? "tag-green" : "tag-muted")">
                                @if (selectedUser!.PwaInstalledAt.HasValue)
                                {
                                    <span>PWA installed (@selectedUser.PwaInstalledAt.Value.ToString("yyyy-MM-dd"))</span>
                                }
                                else
                                {
                                    <span>No PWA</span>
                                }
                            </span>
                            @{
                                var detailTheme = EffectiveTheme(selectedUser!);
                            }
                            <span class="detail-tag tag-muted"
                                  title="@(selectedUser!.Theme ?? "never picked a theme")">
                                <span class="theme-swatch" style="background: @detailTheme.PreviewBg"></span>
                                @if (selectedUser!.Theme != null && !ThemeRegistry.IsKnown(selectedUser!.Theme))
                                {
                                    <span>@selectedUser!.Theme &rarr; @detailTheme.Name</span>
                                }
                                else
                                {
                                    <span>@detailTheme.Name@(selectedUser!.Theme == null ? " (default)" : "")</span>
                                }
                            </span>
                        </div>

                        <div class="detail-tables">
                            <div class="detail-section">
                                <h5>IP Addresses</h5>
                                @if (detailIPs.Count > 0)
                                {
                                    <table class="detail-table">
                                        <thead>
                                            <tr>
                                                <th>IP Address</th>
                                                @if (GeoLocation.IsAvailable)
                                                {
                                                    <th>Location</th>
                                                }
                                                <th>Last Seen</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (ip, lastSeen) in detailIPs)
                                            {
                                                <tr>
                                                    <td class="ip-mono">@ip</td>
                                                    @if (GeoLocation.IsAvailable)
                                                    {
                                                        var geoDetail = GeoLocation.Lookup(ip);
                                                        <td class="geo-cell">@(geoDetail?.ToString() ?? "—")</td>
                                                    }
                                                    <td class="date-cell">@lastSeen.ToString("yyyy-MM-dd HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="no-data">No IP data</span>
                                }
                            </div>

                            <div class="detail-section">
                                <h5>User Agents</h5>
                                @if (detailUserAgents.Count > 0)
                                {
                                    <table class="detail-table">
                                        <thead>
                                            <tr>
                                                <th>User Agent</th>
                                                <th>Last Seen</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (ua, lastSeen) in detailUserAgents)
                                            {
                                                <tr>
                                                    <td class="ua-cell">@ua</td>
                                                    <td class="date-cell">@lastSeen.ToString("yyyy-MM-dd HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="no-data">No user agent data</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="section-header theme-stats-header">
                <h3>Themes</h3>
                <span class="section-count">effective theme per user (unset counts as default)</span>
            </div>
            <div class="theme-stats">
                @foreach (var (theme, count) in themeStats)
                {
                    <div class="theme-stat-card @(count == 0 ? "unused" : "")">
                        <span class="theme-stat-swatch" style="background: @theme.PreviewBg">
                            <span class="theme-stat-accent" style="background: @theme.PreviewAccent"></span>
                        </span>
                        <div class="theme-stat-info">
                            <span class="media-stat-label">@theme.Name</span>
                            <span class="media-stat-value">
                                @count
                                @if (count > 0 && users.Count > 0)
                                {
                                    <span class="theme-stat-pct">@((100.0 * count / users.Count).ToString("0"))%</span>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

        @if (activeSection == "debug")
        {
            <div class="section-header">
                <h3>Message Generator</h3>
                <span class="section-count">Generate test messages for debugging</span>
            </div>

            <div class="debug-form">
                <div class="form-group">
                    <label>Channel</label>
                    <select @bind="debugChannelId">
                        @foreach (var room in ChatService.GetRooms())
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Number of messages</label>
                    <input type="number" @bind="debugMessageCount" min="1" max="5000" />
                </div>

                <div class="form-group">
                    <label>Spread across</label>
                    <select @bind="debugTimeSpan">
                        <option value="1">Last 1 hour</option>
                        <option value="6">Last 6 hours</option>
                        <option value="24">Last 1 day</option>
                        <option value="72">Last 3 days</option>
                        <option value="168">Last 1 week</option>
                        <option value="336">Last 2 weeks</option>
                        <option value="720">Last 1 month</option>
                        <option value="2160">Last 3 months</option>
                        <option value="8760">Last 1 year</option>
                    </select>
                </div>

                <button class="generate-btn" @onclick="GenerateMessages" disabled="@debugGenerating">
                    @if (debugGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate @debugMessageCount messages</span>
                    }
                </button>

                @if (debugResult != null)
                {
                    <div class="debug-result">@debugResult</div>
                }
            </div>
        }
        @if (activeSection == "bot")
        {
            <div class="section-header">
                <h3>Bot Settings</h3>
                <span class="section-count">System bot configuration</span>
            </div>

            <div class="bot-settings">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" value="@botUsername" disabled class="form-input disabled" />
                    <span class="form-hint">Username cannot be changed after creation</span>
                </div>

                <div class="form-group">
                    <label>Display Name</label>
                    <input type="text" @bind="botDisplayName" class="form-input" maxlength="32" />
                </div>

                <div class="form-group">
                    <label>Welcome Message</label>
                    <textarea @bind="botWelcomeMessage" class="form-input form-textarea" rows="3" maxlength="500"></textarea>
                    <span class="form-hint">Sent to new users as a DM. Use {0} for the server name. Mobile users also get a PWA install link.</span>
                </div>

                <div class="bot-actions">
                    <button class="save-btn" @onclick="SaveBotSettings" disabled="@botSaving">
                        @(botSaving ? "Saving..." : "Save")
                    </button>
                    @if (botSaveResult != null)
                    {
                        <span class="save-result">@botSaveResult</span>
                    }
                </div>
            </div>
        }
        @if (activeSection == "invites")
        {
            <div class="section-header">
                <h3>Invite &amp; Login Links</h3>
                <span class="section-count">@openInvites.Count open · @userLinks.Count(l => l.IsActive) active</span>
            </div>

            <div class="invite-create">
                <div class="form-group">
                    <label>For</label>
                    <select @bind="inviteTargetUserId">
                        <option value="">Someone new (invite)</option>
                        @foreach (var u in users.Where(u => !BotService.IsBotUser(u.Username)))
                        {
                            <option value="@u.Id">@u.Username</option>
                        }
                    </select>
                </div>
                @if (string.IsNullOrEmpty(inviteTargetUserId))
                {
                    <div class="form-group">
                        <label>Note</label>
                        <input type="text" @bind="inviteNote" maxlength="64" placeholder="for Tom" />
                    </div>
                }
                <div class="form-group">
                    <label>Expires</label>
                    <select @bind="inviteExpiryDays">
                        <option value="0">Never</option>
                        <option value="1">In 1 day</option>
                        <option value="7">In 7 days</option>
                        <option value="30">In 30 days</option>
                    </select>
                </div>
                <button class="save-btn" @onclick="CreateInviteLink" disabled="@inviteCreating">
                    @(inviteCreating ? "Creating..." : "Create link")
                </button>
                @if (inviteCreateResult != null)
                {
                    <span class="save-result">@inviteCreateResult</span>
                }
            </div>
            <span class="form-hint invite-hint">
                An invite lets whoever opens it pick a username and join, even while registration is closed.
                A link for an existing user replaces their current one (the rescue for someone locked out of every device);
                they get a bot DM about it. Codes stay readable here only until the link is first used.
            </span>

            <div class="section-header" style="margin-top: 2rem;">
                <h3>Open invites</h3>
                <span class="section-count">@openInvites.Count waiting</span>
            </div>
            @if (openInvites.Count == 0)
            {
                <span class="form-hint">No open invites.</span>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th>Link</th>
                                <th>Note</th>
                                <th>Created</th>
                                <th>Expires</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var link in openInvites)
                            {
                                var l = link;
                                <tr>
                                    <td class="link-cell">
                                        <span class="link-code">@AccessLinks.BuildUrl(l.Code, Navigation.BaseUri)</span>
                                        @CopyButton(l)
                                    </td>
                                    <td>@(l.Note ?? "—")</td>
                                    <td class="date-cell">@FormatTimeAgo(l.CreatedAt)</td>
                                    <td class="date-cell">@ExpiryLabel(l)</td>
                                    <td>
                                        <div class="link-actions">
                                            @ExpirySelect(l)
                                            <button class="reject-btn" @onclick="() => RevokeLink(l)">Revoke</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="section-header" style="margin-top: 2rem;">
                <h3>User login links</h3>
                <span class="section-count">@userLinks.Count(l => l.IsActive) active</span>
            </div>
            @if (userLinks.Count == 0)
            {
                <span class="form-hint">No user links yet.</span>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Status</th>
                                <th>Link</th>
                                <th>Created</th>
                                <th>Used</th>
                                <th>Expires</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var link in userLinks)
                            {
                                var l = link;
                                var owner = UserService.GetById(l.UserId!.Value);
                                <tr>
                                    <td>@(owner?.Username ?? "(deleted)")</td>
                                    <td>
                                        <span class="status-pill @(l.IsActive ? "online" : "offline")">
                                            <span class="status-dot"></span>
                                            @LinkStatus(l)
                                        </span>
                                    </td>
                                    <td class="link-cell">
                                        @if (l.AdminCanSeeCode)
                                        {
                                            <span class="link-code">@AccessLinks.BuildUrl(l.Code, Navigation.BaseUri)</span>
                                            @CopyButton(l)
                                        }
                                        else
                                        {
                                            <span class="link-hidden" title="Only the user can see this code">🔒 hidden</span>
                                        }
                                    </td>
                                    <td class="date-cell">@FormatTimeAgo(l.CreatedAt)@(l.CreatedById != l.UserId ? " by admin" : "")</td>
                                    <td class="date-cell">@(l.UseCount == 0 ? "never" : $"{l.UseCount}× · {FormatTimeAgo(l.LastUsedAt!.Value)}")</td>
                                    <td class="date-cell">@ExpiryLabel(l)</td>
                                    <td>
                                        @if (l.IsActive)
                                        {
                                            <div class="link-actions">
                                                @ExpirySelect(l)
                                                <button class="reject-btn" @onclick="() => RevokeLink(l)">Revoke</button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @if (activeSection == "settings")
        {
            <div class="section-header">
                <h3>Registration</h3>
                <span class="section-count">Control who can join</span>
            </div>

            <div class="registration-settings">
                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Close registration</span>
                        <span class="toggle-hint">Block all new signups. Login page shows "temporarily closed".</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@regClosed" @onchange="ToggleRegistrationClosed" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Require approval</span>
                        <span class="toggle-hint">New users must wait for admin approval before joining.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@regApproval" @onchange="ToggleRequireApproval" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Smart login</span>
                        <span class="toggle-hint">Auto-login returning users from the same IP address without secret code.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@smartMode" @onchange="ToggleSmartMode" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>
            </div>

            <div class="section-header" style="margin-top: 2rem;">
                <h3>Link Previews</h3>
                <span class="section-count">OpenGraph preview cards</span>
            </div>

            <div class="registration-settings">
                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Enable link previews</span>
                        <span class="toggle-hint">Show OpenGraph preview cards below messages with URLs.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@linkPreviewsEnabled" @onchange="ToggleLinkPreviews" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Enable media caching</span>
                        <span class="toggle-hint">
                            Auto-download videos/audio from YouTube, Spotify, SoundCloud (under 10 min) for inline playback.
                            @if (!MediaCacheService.IsAvailable)
                            {
                                <br /><strong style="color: var(--status-away);">yt-dlp not found on this system.</strong>
                            }
                        </span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@mediaCachingEnabled" @onchange="ToggleMediaCaching"
                               disabled="@(!MediaCacheService.IsAvailable)" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

            </div>

            <div class="section-header" style="margin-top: 2rem;">
                <h3>GIFs</h3>
                <span class="section-count">Klipy content rating</span>
            </div>

            <div class="registration-settings">
                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Content rating</span>
                        <span class="toggle-hint">
                            How strictly Klipy filters search and trending results.
                            G = strictest (kid-friendly). PG = mild (default). PG-13 = some edgy content. R = anything goes.
                        </span>
                    </div>
                    <select class="log-filter-select" @bind="gifContentRating" @bind:after="UpdateGifContentRating">
                        <option value="G">G</option>
                        <option value="PG">PG</option>
                        <option value="PG13">PG-13</option>
                        <option value="R">R</option>
                    </select>
                </label>
            </div>

            @* Read-only how-tos: these two live in appsettings.json (per deployment), not in
               runtime toggles — both are useless without a matching DNS record, so an admin
               switch here could only lie about what the infrastructure supports. *@
            <div class="section-header" style="margin-top: 2rem;">
                <h3>Deployment</h3>
                <span class="section-count">Set in appsettings.json, per instance</span>
            </div>

            <div class="howto-list">
                <details class="howto-box">
                    <summary>
                        <span class="toggle-label">Upload subdomain (tus)</span>
                        @if (string.IsNullOrEmpty(ChatConfig.UploadUrl))
                        {
                            <span class="howto-status">off — uploads use /api/tus on this domain</span>
                        }
                        else
                        {
                            <span class="howto-status on">@ChatConfig.UploadUrl</span>
                        }
                    </summary>
                    <div class="howto-body">
                        <p>Uploads that pass through the Cloudflare proxy hit its request size limit. A direct subdomain avoids that limit, so large files upload without errors.</p>
                        <ol>
                            <li>Add a DNS record for <code>upload.your-domain.com</code>. Make it DNS-only (grey cloud). Point it at this server.</li>
                            <li>Give this server a trusted TLS certificate for that hostname (for example Let's Encrypt). Cloudflare origin certificates do not work here, because the browser connects directly.</li>
                            <li>Set <code>ChatSettings:UploadUrl</code> to <code>https://upload.your-domain.com/api/tus</code> and restart. In Docker, set the env var <code>ChatSettings__UploadUrl</code> instead.</li>
                        </ol>
                        <p>Leave the setting empty to upload through the main domain.</p>
                    </div>
                </details>


            </div>

            @if (pendingUsersList.Count > 0)
            {
                <div class="section-header" style="margin-top: 2rem;">
                    <h3>Pending Requests</h3>
                    <span class="section-count">@pendingUsersList.Count waiting</span>
                    <button class="refresh-btn" @onclick="RefreshPending" title="Refresh">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                        </svg>
                    </button>
                </div>

                <div class="pending-list">
                    @foreach (var (username, requestedAt) in pendingUsersList)
                    {
                        var u = username;
                        <div class="pending-item">
                            <div class="pending-info">
                                <span class="pending-username">@u</span>
                                <span class="pending-time">@FormatTimeAgo(requestedAt)</span>
                            </div>
                            <div class="pending-actions">
                                <button class="approve-btn" @onclick="() => ApprovePending(u)">Approve</button>
                                <button class="reject-btn" @onclick="() => RejectPending(u)">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (activeSection == "logs")
        {
            <div class="section-header">
                <h3>Action Logs</h3>
                <span class="section-count">@logEntries.Count loaded</span>
            </div>

            <div class="log-filters">
                <select class="log-filter-select" @onchange="OnActionFilterChanged">
                    <option value="">All actions</option>
                    <option value="LOGIN" selected="@(logFilterAction == "LOGIN")">LOGIN</option>
                    <option value="LOGOUT" selected="@(logFilterAction == "LOGOUT")">LOGOUT</option>
                    <option value="SMART_LOGIN" selected="@(logFilterAction == "SMART_LOGIN")">SMART_LOGIN</option>
                    <option value="CIRCUIT_RECONNECT" selected="@(logFilterAction == "CIRCUIT_RECONNECT")">CIRCUIT_RECONNECT</option>
                    <option value="CIRCUIT_DISCONNECT" selected="@(logFilterAction == "CIRCUIT_DISCONNECT")">CIRCUIT_DISCONNECT</option>
                </select>
                <input type="text" class="log-filter-input" placeholder="Filter by username..."
                       @bind="logFilterUsername" @bind:event="oninput" @bind:after="OnUsernameFilterChanged" />
            </div>

            <div class="table-wrapper">
                <table class="users-table logs-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>IP</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in logEntries)
                        {
                            <tr>
                                <td class="date-cell">@FormatLogDate(entry.Date)</td>
                                <td>@ResolveUsername(entry.UserUid)</td>
                                <td><span class="action-pill @GetActionClass(entry.Action)">@entry.Action</span></td>
                                <td class="ip-mono">@(entry.IP ?? "-")</td>
                                <td class="info-cell">@(entry.Info ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (logEntries.Count > 0 && logEntries.Count % 100 == 0)
            {
                <div class="log-load-more">
                    <button class="upload-button" @onclick="LoadMoreLogs" disabled="@logLoading">
                        @(logLoading ? "Loading..." : "Load more")
                    </button>
                </div>
            }

            @if (!logLoading && logEntries.Count == 0)
            {
                <div class="log-empty">No log entries found.</div>
            }
        }

        @if (activeSection == "media")
        {
            <div class="section-header">
                <h3>Media</h3>
                <span class="section-count">@mediaStats.TotalFiles files</span>
            </div>

            <div class="media-stats">
                <div class="media-stat-card">
                    <span class="media-stat-label">FFmpeg</span>
                    <span class="media-stat-value">
                        <span class="status-dot @(VideoService.IsAvailable ? "status-online" : "status-offline")"></span>
                        @(VideoService.IsAvailable ? "Available" : "Unavailable")
                    </span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Total Storage</span>
                    <span class="media-stat-value">@FormatFileSize(mediaStats.TotalBytes)</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Images</span>
                    <span class="media-stat-value">@mediaStats.ImageCount</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Videos</span>
                    <span class="media-stat-value">@mediaStats.VideoCount</span>
                </div>
            </div>

            <div class="log-filters">
                <select class="log-filter-select" @onchange="OnMediaTypeFilterChanged">
                    <option value="">All types</option>
                    <option value="image" selected="@(mediaFilterType == "image")">Image</option>
                    <option value="video" selected="@(mediaFilterType == "video")">Video</option>
                    <option value="gif" selected="@(mediaFilterType == "gif")">GIF</option>
                </select>
                <input type="text" class="log-filter-input" placeholder="Filter by username..."
                       @bind="mediaFilterUsername" @bind:event="oninput" @bind:after="OnMediaUsernameFilterChanged" />
            </div>

            <div class="table-wrapper">
                <table class="users-table logs-table">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Date</th>
                            <th>User</th>
                            <th>File</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Processing</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in mediaEntries)
                        {
                            <tr>
                                @{ var (thumbUrl, linkUrl) = GetMediaPreview(entry); }
                                <td>
                                    @if (thumbUrl != null)
                                    {
                                        <a href="@(linkUrl ?? thumbUrl)" target="_blank" rel="noopener">
                                            <img src="@thumbUrl" alt="" class="admin-thumb" loading="lazy"
                                                 onerror="this.parentElement.style.display='none'" />
                                        </a>
                                    }
                                </td>
                                <td class="date-cell">@FormatLogDate(entry.Date)</td>
                                <td>@entry.Username</td>
                                <td class="info-cell" title="@entry.OriginalFileName">@entry.OriginalFileName</td>
                                <td><span class="action-pill @(entry.FileType == "video" ? "action-circuit" : "action-default")">@entry.FileType</span></td>
                                <td>@FormatFileSize(entry.FileSize)</td>
                                <td>@(entry.CompressDurationMs.HasValue ? $"{entry.CompressDurationMs.Value / 1000.0:F1}s" : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (mediaEntries.Count > 0 && mediaEntries.Count % 100 == 0)
            {
                <div class="log-load-more">
                    <button class="upload-button" @onclick="LoadMoreMedia" disabled="@mediaLoading">
                        @(mediaLoading ? "Loading..." : "Load more")
                    </button>
                </div>
            }

            @if (!mediaLoading && mediaEntries.Count == 0)
            {
                <div class="log-empty">No media uploads found.</div>
            }
        }

        @if (activeSection == "gifs")
        {
            var gifRows = FilteredGifEntries.ToList();
            <div class="section-header">
                <h3>GIFs</h3>
                <span class="section-count">@gifRows.Count of @gifEntries.Count entries</span>
            </div>

            <div class="media-stats">
                <div class="media-stat-card">
                    <span class="media-stat-label">FFmpeg</span>
                    <span class="media-stat-value">
                        <span class="status-dot @(VideoService.IsAvailable ? "status-online" : "status-offline")"></span>
                        @(VideoService.IsAvailable ? "Available" : "Unavailable")
                    </span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Total Storage</span>
                    <span class="media-stat-value">@FormatFileSize(gifTotalBytes)</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Custom GIFs</span>
                    <span class="media-stat-value">@gifCustomCount</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Provider Cache</span>
                    <span class="media-stat-value">@gifProviderCount</span>
                </div>
            </div>

            <div class="server-gif-library">
                <h4>Server library</h4>
                <p class="section-hint">
                    A curated GIF set every user sees: its own picker tab, searchable by everyone,
                    ranked above the general pool. Import files or a zip, organize with folders.
                    Promote existing entries from the table below.
                </p>
                @if (UserState.UserId is Guid adminUserId)
                {
                    <GifLibraryManager Mode="GifLibraryMode.Server" CurrentUserId="@adminUserId" InitialVisibleCount="28" />
                }
            </div>

            <div class="log-filters">
                <select class="log-filter-select" @bind="gifFilter">
                    <option value="all">All entries</option>
                    <option value="custom">Custom uploads</option>
                    <option value="provider">Provider cache</option>
                    <option value="favorited">⭐ Favorited</option>
                    <option value="server">Server library</option>
                </select>
            </div>

            <div class="table-wrapper">
                <table class="users-table logs-table">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Date</th>
                            <th>Source</th>
                            <th>Uploader</th>
                            <th>Format</th>
                            <th>Dimensions</th>
                            <th>Size</th>
                            <th>Uses</th>
                            <th>Favs</th>
                            <th>Tags</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in gifRows.Take(gifTableVisible))
                        {
                            <tr>
                                @* Thumb renders the derived preview when one exists; the link
                                   always opens the full-size file. *@
                                @{
                                    var gifThumbUrl = g.PreviewUrl ?? g.GifUrl ?? g.RemoteGifUrl;
                                    var gifFullUrl = g.GifUrl ?? g.RemoteGifUrl;
                                }
                                <td>
                                    @if (!string.IsNullOrEmpty(gifThumbUrl))
                                    {
                                        <a href="@(gifFullUrl ?? gifThumbUrl)" target="_blank" rel="noopener">
                                            <img src="@gifThumbUrl" alt="" class="admin-thumb" loading="lazy" />
                                        </a>
                                    }
                                </td>
                                <td class="date-cell">@FormatLogDate(g.CreatedAt)</td>
                                <td>
                                    <span class="action-pill action-default">@(g.SourceProviderId ?? "custom")</span>
                                    @if (g.IsServerGif)
                                    {
                                        <span class="action-pill server-pill" title="In the server library">server</span>
                                    }
                                </td>
                                <td>@GifUploaderName(g)</td>
                                <td><span class="action-pill action-default">@GifFormat(g)</span></td>
                                <td>@($"{g.Width} × {g.Height}")</td>
                                <td>@FormatFileSize(g.FileSizeBytes)</td>
                                <td>@g.UseCount</td>
                                <td>@(gifFavCounts.TryGetValue(g.Id, out var favCount) ? $"⭐ {favCount}" : "—")</td>
                                <td class="gif-tags-cell">
                                    @if (editingGifTagsId == g.Id)
                                    {
                                        <div class="gif-tags-edit">
                                            <input class="gif-tags-input" @bind="gifTagsDraft" @bind:event="oninput"
                                                   @onkeydown="HandleGifTagsKeyDown"
                                                   placeholder="comma, separated, tags" />
                                            <button class="gif-tags-btn save" title="Save" @onclick="SaveGifTagsAsync">✓</button>
                                            <button class="gif-tags-btn" title="Cancel" @onclick="CancelEditGifTags">✕</button>
                                        </div>
                                    }
                                    else
                                    {
                                        var tags = GifService.GetTags(g);
                                        <div class="gif-tags-view" title="Click to edit tags" @onclick="@(() => StartEditGifTags(g))">
                                            @foreach (var tag in tags)
                                            {
                                                <span class="gif-tag-chip">@tag</span>
                                            }
                                            @if (tags.Count == 0)
                                            {
                                                <span class="gif-tags-empty">add tags…</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="gif-actions-cell">
                                    <button class="gif-row-btn @(g.IsServerGif ? "active" : "")"
                                            title="@(g.IsServerGif ? "Remove from server library" : "Add to server library")"
                                            @onclick="() => ToggleServerGifAsync(g)">
                                        @(g.IsServerGif ? "★ server" : "☆ server")
                                    </button>
                                    <button class="gif-row-btn danger" title="Delete this GIF everywhere"
                                            @onclick="() => DeleteGifEntryAsync(g)">
                                        @(confirmDeleteGifId == g.Id ? "Sure?" : "Delete")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ShowMoreButton Total="gifRows.Count" @bind-Visible="gifTableVisible" />

            @if (gifRows.Count == 0)
            {
                <div class="log-empty">@(gifEntries.Count == 0 ? "No GIFs in the library yet." : "No GIFs match this filter.")</div>
            }
        }

        @if (activeSection == "diagnostics")
        {
            <div class="section-header">
                <h3>Diagnostics</h3>
                <span class="section-count">Live system metrics</span>
            </div>

            @if (diagLatest != null)
            {
                <div class="diag-stats">
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Users</span>
                        <span class="media-stat-value">@diagLatest.UniqueUsers</span>
                    </div>
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Sessions</span>
                        <span class="media-stat-value">@diagLatest.UserSessions</span>
                    </div>
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Messages</span>
                        <span class="media-stat-value">@diagLatest.TotalMessages</span>
                    </div>
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Circuits</span>
                        <span class="media-stat-value">@(diagLatest.ActiveCircuits + diagLatest.DisconnectedCircuits)</span>
                    </div>
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Channels</span>
                        <span class="media-stat-value">@diagLatest.Channels</span>
                    </div>
                    <div class="diag-stat-card">
                        <span class="media-stat-label">Event Subs</span>
                        <span class="media-stat-value">@diagLatest.TotalEventSubscribers</span>
                    </div>
                </div>
            }

            @* Presence as the server believes it — first place to look when push/unread misbehaves:
               a session wrongly counted "visible" suppresses push for the whole account, and if it's
               also not Away and viewing the channel, it silently clears unread. *@
            <div class="diag-chart-card" style="margin-bottom: 16px;">
                <h4>Sessions — presence truth table</h4>
                @if (diagSessions.Count == 0)
                {
                    <p style="color: var(--text-secondary); margin: 0;">No active sessions.</p>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Device</th>
                                    <th>Transport</th>
                                    <th>Connected</th>
                                    <th title="Page visibility as last reported — a visible session suppresses push for the whole account">Visible</th>
                                    <th>Status</th>
                                    <th title="Channel this session has open — visible + not Away + viewing = marks incoming messages read">Viewing</th>
                                    <th title="Time since last real user input (client-reported)">Last input</th>
                                    <th title="Time since last client-state report — stale means frozen, disconnected, or pre-heartbeat client">Heartbeat</th>
                                    <th>Age</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in diagSessions)
                                {
                                    var circuit = s.CircuitId != null ? diagCircuitById.GetValueOrDefault(s.CircuitId) : null;
                                    var status = ChatService.GetUserStatus(s.Username);
                                    // The dangerous combo: counted foreground while its circuit is gone or silent.
                                    // (Only for circuit-backed sessions — a session without a circuit is never a ghost.)
                                    var ghost = s.PageVisible && s.CircuitId != null && circuit?.IsConnected != true;
                                    <tr style="@(ghost ? "color: var(--color-warning);" : "")">
                                        <td>@s.Username</td>
                                        <td>
                                            @(s.IsMobile == true ? "📱" : "🖥️") @(s.ClientIp ?? "—")

                                        </td>
                                        <td>@(circuit?.IsWebSocket switch { true => "WS", false => "⚠ Fallback", null => "—" })</td>
                                        <td>@(circuit == null ? "—" : circuit.IsConnected ? "✓" : $"✗ {FormatAgo(circuit.DisconnectedAt)}")</td>
                                        <td>@(s.PageVisible ? "👁 yes" : "no")</td>
                                        <td>@(status?.ToString() ?? "—")</td>
                                        <td>@(s.ViewingChannel ?? "—")</td>
                                        <td>@FormatAgo(s.LastActivity)</td>
                                        <td>@FormatAgo(s.LastReportAt)</td>
                                        <td>@FormatAge(s.CreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="diag-chart-card" style="margin-bottom: 16px;">
                <h4>Circuits — latency telemetry</h4>
                @if (diagCircuits.Count == 0 && diagClosedCircuits.Count == 0)
                {
                    <p style="color: var(--text-secondary); margin: 0;">No circuits tracked yet.</p>
                }
                else
                {
                    <table class="users-table logs-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>IP</th>
                                <th title="How this client's SignalR connected — Fallback (SSE/long-polling) instead of WebSockets is the #1 latency suspect">Transport</th>
                                <th>Connected</th>
                                <th title="Client-measured circuit round trip: last / average / max">RTT last/avg/max</th>
                                <th title="Inbound events the server took ≥100ms to process">Slow events</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in diagCircuits.Take(diagCircuitsVisible))
                            {
                                var laggy = c.IsWebSocket == false || c.AvgRttMs > 250;
                                <tr style="@(laggy ? "color: var(--color-warning);" : "")">
                                    <td>@(c.Username ?? "—")</td>
                                    <td>@(c.ClientIp ?? "—")</td>
                                    <td>@(c.IsWebSocket switch { true => "WS", false => "⚠ Fallback", null => "—" })</td>
                                    <td>@(c.IsConnected ? "✓" : "✗") @FormatAge(c.CreatedAt)</td>
                                    <td title="@c.RttSamples samples, last @FormatAgo(c.RttUpdatedAt)">
                                        @FormatMs(c.LastRttMs) / @FormatMs(c.AvgRttMs) / @FormatMs(c.MaxRttMs)
                                    </td>
                                    <td>@(c.SlowEventCount == 0 ? "—" : $"{c.SlowEventCount}× (max {c.MaxEventMs:F0}ms)")</td>
                                </tr>
                            }
                            @* Closed circuits continue the same row budget, so one button governs both segments. *@
                            @if (diagClosedCircuits.Count > 0 && diagCircuitsVisible > diagCircuits.Count)
                            {
                                @* Bounded trail (last 50) — lets an admin inspect a user's numbers after they signed out *@
                                <tr><td colspan="6" style="color: var(--text-secondary); padding-top: 10px;">Recently closed</td></tr>
                                @foreach (var c in diagClosedCircuits.Take(diagCircuitsVisible - diagCircuits.Count))
                                {
                                    var laggy = c.IsWebSocket == false || c.AvgRttMs > 250;
                                    <tr style="opacity: 0.55; @(laggy ? "color: var(--color-warning);" : "")">
                                        <td>@(c.Username ?? "—")</td>
                                        <td>@(c.ClientIp ?? "—")</td>
                                        <td>@(c.IsWebSocket switch { true => "WS", false => "⚠ Fallback", null => "—" })</td>
                                        <td>✗ @FormatAgo(c.ClosedAt)</td>
                                        <td title="@c.RttSamples samples, last @FormatAgo(c.RttUpdatedAt)">
                                            @FormatMs(c.LastRttMs) / @FormatMs(c.AvgRttMs) / @FormatMs(c.MaxRttMs)
                                        </td>
                                        <td>@(c.SlowEventCount == 0 ? "—" : $"{c.SlowEventCount}× (max {c.MaxEventMs:F0}ms)")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <ShowMoreButton Total="diagCircuits.Count + diagClosedCircuits.Count" @bind-Visible="diagCircuitsVisible" />
                }
            </div>

            <div class="diag-chart-card" style="margin-bottom: 16px;">
                <h4>Push notifications</h4>
                @switch (PushService.KeyStatus)
                {
                    case Yap.Services.PushKeyStatus.Valid:
                        <p style="color: var(--color-success); margin: 0;">✅ Configured — VAPID keypair verified at startup.</p>
                        break;
                    case Yap.Services.PushKeyStatus.Invalid:
                        <p style="color: var(--color-danger); margin: 0; font-weight: 600;">❌ DISABLED — VAPID keypair is invalid.</p>
                        <p style="color: var(--text-secondary); margin: 4px 0 0;">@PushService.KeyStatusDetail</p>
                        <p style="color: var(--text-secondary); margin: 4px 0 0;">Regenerate a matched pair and set both <code>Vapid:PublicKey</code> and <code>Vapid:PrivateKey</code>.</p>
                        break;
                    default:
                        <p style="color: var(--text-secondary); margin: 0;">⚠️ Not configured — no VAPID keys set.</p>
                        break;
                }
            </div>

            @* Push audit: the decision made for each DM (and why), then what the send actually did.
               Ring buffers, newest first, in-memory only — enough to answer "why didn't my phone
               buzz at 14:32" without enabling Debug logging. *@
            <div class="diag-chart-card" style="margin-bottom: 16px;">
                <h4>Push audit — decisions & results</h4>
                @if (diagPushDecisions.Count == 0 && diagPushResults.Count == 0)
                {
                    <p style="color: var(--text-secondary); margin: 0;">No DM push activity since restart.</p>
                }
                else
                {
                    <div class="table-wrapper" style="margin-bottom: 12px;">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>DM</th>
                                    <th>Decision</th>
                                    <th title="Recipient's total unread DMs at decision time (rides in the push payload as the badge count)">Unread</th>
                                    <th title="Recipient's push subscriptions at decision time">Subs</th>
                                    <th title="Recipient's sessions at decision time — the device forcing a suppression shows up here">Sessions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in diagPushDecisions.Take(diagPushDecisionsVisible))
                                {
                                    <tr style="@(d.Outcome.StartsWith("suppressed") ? "color: var(--color-warning);" : "")">
                                        <td>@FormatAgo(d.At)</td>
                                        <td>@d.From → @d.To</td>
                                        <td>@d.Outcome</td>
                                        <td>@d.TotalUnread</td>
                                        <td>@d.Subscriptions</td>
                                        <td style="font-size: 0.75rem;">@d.Sessions</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <ShowMoreButton Total="diagPushDecisions.Count" @bind-Visible="diagPushDecisionsVisible" />
                    </div>
                    <div class="table-wrapper">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>To</th>
                                    <th title="Devices the push service accepted / rejected / total attempted">Sent/Failed/Total</th>
                                    <th title="Muted users get badge-only pushes (no banner)">Muted</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in diagPushResults.Take(diagPushResultsVisible))
                                {
                                    <tr style="@(r.Failed > 0 || r.Total == 0 ? "color: var(--color-warning);" : "")">
                                        <td>@FormatAgo(r.At)</td>
                                        <td>@r.To</td>
                                        <td>@r.Sent / @r.Failed / @r.Total</td>
                                        <td>@(r.Muted ? "🔕" : "—")</td>
                                        <td>@(r.Note ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <ShowMoreButton Total="diagPushResults.Count" @bind-Visible="diagPushResultsVisible" />
                    </div>
                }
            </div>

            @* Unread audit: every DM badge increment and every clear — including WHICH device
               cleared it and whether that device was foreground/connected at that moment. *@
            <div class="diag-chart-card" style="margin-bottom: 16px;">
                <h4>Unread audit — DM badge changes</h4>
                @if (diagUnreadChanges.Count == 0)
                {
                    <p style="color: var(--text-secondary); margin: 0;">No DM unread activity since restart.</p>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th title="Whose badge changed">User</th>
                                    <th>Channel</th>
                                    <th title="+1 → new total on arrival; clear (n) = n unread wiped">Change</th>
                                    <th title="What triggered it: open, receive, resume, dispose, or the sender">Trigger</th>
                                    <th title="State of the clearing device at that moment">Device state</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in diagUnreadChanges.Take(diagUnreadVisible))
                                {
                                    <tr>
                                        <td>@FormatAgo(u.At)</td>
                                        <td>@u.User</td>
                                        <td>@u.Channel</td>
                                        <td>@(u.Kind == "clear" ? $"clear ({u.Count})" : $"+1 → {u.Count}")</td>
                                        <td>@u.Source</td>
                                        <td style="font-size: 0.75rem;">@u.SessionState</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <ShowMoreButton Total="diagUnreadChanges.Count" @bind-Visible="diagUnreadVisible" />
                    </div>
                }
            </div>

            <div class="diag-charts">
                <div class="diag-chart-card">
                    <h4>Users & Sessions</h4>
                    <div class="diag-chart-wrapper">
                        <canvas id="diag-chart-users"></canvas>
                    </div>
                </div>
                <div class="diag-chart-card">
                    <h4>Circuits: Active vs Disconnected</h4>
                    <div class="diag-chart-wrapper">
                        <canvas id="diag-chart-circuits"></canvas>
                    </div>
                </div>
                <div class="diag-chart-card">
                    <h4>Messages</h4>
                    <div class="diag-chart-wrapper">
                        <canvas id="diag-chart-messages"></canvas>
                    </div>
                </div>
            </div>
        }

        @if (activeSection == "visitors")
        {
            <div class="section-header">
                <h3>Visitors</h3>
                <span class="section-count">@visitorStats.TotalVisits visits tracked</span>
            </div>

            <div class="media-stats">
                <div class="media-stat-card">
                    <span class="media-stat-label">Total Visits</span>
                    <span class="media-stat-value">@visitorStats.TotalVisits</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Login Failures</span>
                    <span class="media-stat-value">@visitorStats.LoginFailures</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Unique IPs</span>
                    <span class="media-stat-value">@visitorStats.UniqueIPs</span>
                </div>
                <div class="media-stat-card">
                    <span class="media-stat-label">Today</span>
                    <span class="media-stat-value">@visitorStats.TodayVisits</span>
                </div>
            </div>

            <div class="log-filters">
                <select class="log-filter-select" @onchange="OnVisitorFilterChanged">
                    <option value="">All</option>
                    <option value="@UserActionLog.KnownActions.VISIT">Visits only</option>
                    <option value="@UserActionLog.KnownActions.LOGIN_FAIL">Login failures only</option>
                </select>
            </div>

            @if (visitorLoading)
            {
                <div class="log-empty">Loading...</div>
            }
            else if (visitorEntries.Count == 0)
            {
                <div class="log-empty">No visitor data yet. Visitors are tracked when they load the login page.</div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="users-table logs-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>IP</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>User-Agent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in visitorEntries)
                            {
                                <tr class="clickable-row @(selectedVisitorId == entry.Id ? "selected" : "")"
                                    @onclick="() => SelectVisitorEntry(entry.Id)">
                                    <td class="date-cell">@FormatLogDate(entry.Date)</td>
                                    <td class="ip-mono">@(entry.IP ?? "---")</td>
                                    <td>
                                        <span class="action-pill @GetVisitorActionClass(entry.Action)">
                                            @entry.Action
                                        </span>
                                    </td>
                                    <td>@FormatVisitorInfo(entry.Info)</td>
                                    <td class="ua-cell">@TruncateUa(entry.UserAgent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (visitorEntries.Count % 100 == 0)
                {
                    <div style="text-align: center; padding: 12px;">
                        <button class="join-button" @onclick="LoadMoreVisitors" disabled="@visitorLoading">
                            Load more
                        </button>
                    </div>
                }
            }

            @if (selectedVisitorEntry != null)
            {
                <div class="user-detail-panel">
                    <div class="detail-header">
                        <div class="detail-header-info">
                            <h4>@(selectedVisitorEntry.IP ?? "Unknown IP")</h4>
                            @if (GeoLocation.IsAvailable && !string.IsNullOrEmpty(selectedVisitorEntry.IP))
                            {
                                var geo = GeoLocation.Lookup(selectedVisitorEntry.IP);
                                if (geo != null)
                                {
                                    <span class="user-username">@geo</span>
                                }
                            }
                        </div>
                        <button class="detail-close" @onclick="() => selectedVisitorId = null" title="Close">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                        </button>
                    </div>

                    <div class="detail-tags">
                        <span class="detail-tag tag-muted">@FormatTimeAgo(selectedVisitorEntry.Date)</span>
                        <span class="detail-tag tag-muted">
                            @selectedVisitorEntry.Action
                        </span>
                        @if (!string.IsNullOrEmpty(selectedVisitorEntry.Info))
                        {
                            <span class="detail-tag tag-muted">@FormatVisitorInfo(selectedVisitorEntry.Info)</span>
                        }
                    </div>

                    <div class="detail-section">
                        <h5>User Agent</h5>
                        <span class="ua-cell" style="word-break: break-all;">@(selectedVisitorEntry.UserAgent ?? "---")</span>
                    </div>
                </div>
            }
        }
    </main>
</div>

@code {
    private string activeSection = "users";

    private List<User> users = new();
    private Dictionary<string, (UserStatus Status, bool? IsMobile)> onlineStatusMap = new();
    private Dictionary<string, UserActionLog> lastActions = new();
    private Dictionary<string, List<string>> recentIPs = new();

    // User detail panel
    private Guid? selectedUserId;
    private bool loadingDetail;
    private int detailPushSubCount;
    private List<(string IP, DateTime LastSeen)> detailIPs = new();
    private List<(string UserAgent, DateTime LastSeen)> detailUserAgents = new();

    private User? selectedUser => selectedUserId.HasValue
        ? users.FirstOrDefault(u => u.Id == selectedUserId.Value)
        : null;

    private List<(ThemeDefinition Theme, int Count)> themeStats = new();

    // Invites section
    private List<AccessLink> openInvites = new();
    private List<AccessLink> userLinks = new();
    private string inviteTargetUserId = "";
    private string inviteNote = "";
    private string inviteExpiryDays = "0";
    private bool inviteCreating;
    private string? inviteCreateResult;
    private Guid? copiedLinkId;

    // Stats/detail count the *effective* theme: an unset or stale id (theme renamed/removed,
    // no data migration) has no CSS block, so those users render the :root default look.
    private static ThemeDefinition EffectiveTheme(User user)
    {
        var id = ThemeRegistry.IsKnown(user.Theme) ? user.Theme! : ThemeRegistry.DefaultId;
        return ThemeRegistry.All.First(t => t.Id == id);
    }

    protected override void OnInitialized()
    {
        // Auth + admin guard
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue || !UserService.IsAdmin(UserState.UserId.Value))
        {
            // Chat routes are document endpoints outside the retained Blazor router.
            Navigation.NavigateTo("/lobby", forceLoad: true);
            return;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue || !UserService.IsAdmin(UserState.UserId.Value))
            return;

        // Load users from UserService
        users = UserService.GetAllUsers().OrderByDescending(u => u.LastSeenAt ?? u.CreatedAt).ToList();

        themeStats = ThemeRegistry.All
            .Select(t => (Theme: t, Count: users.Count(u => EffectiveTheme(u).Id == t.Id)))
            .OrderByDescending(t => t.Count)
            .ToList();

        // Build online status map from ChatService
        var onlineUsers = ChatService.GetAllUsersWithStatus();
        onlineStatusMap = onlineUsers.ToDictionary(
            u => u.Username,
            u => (u.Status, u.IsMobile),
            StringComparer.OrdinalIgnoreCase);

        // Load action logs and IPs in parallel
        var lastActionsTask = ActionLog.GetLastActionPerUserAsync();
        var recentIPsTask = ActionLog.GetRecentIPsPerUserAsync();

        await Task.WhenAll(lastActionsTask, recentIPsTask);

        lastActions = lastActionsTask.Result;
        recentIPs = recentIPsTask.Result;

        // Default debug channel to first room
        var rooms = ChatService.GetRooms();
        if (rooms.Count > 0)
            debugChannelId = rooms[0].Id;

        // Load bot settings
        botUsername = BotService.BotUsername ?? "";
        var botUser = BotService.BotUserId.HasValue ? UserService.GetById(BotService.BotUserId.Value) : null;
        botDisplayName = botUser?.DisplayName ?? botUsername;
        botWelcomeMessage = BotService.WelcomeMessage;

        // Load registration settings
        regClosed = RegistrationGate.RegistrationClosed;
        regApproval = RegistrationGate.RequireApproval;
        smartMode = RegistrationGate.SmartMode;
        pendingUsersList = RegistrationGate.GetPendingUsers();

        LoadLinks();

        // Load link preview settings
        linkPreviewsEnabled = LinkPreviewSettings.Enabled;
        mediaCachingEnabled = LinkPreviewSettings.MediaCachingEnabled;

        // Load GIF settings
        gifContentRating = GifAdminSettings.KlipyRating.ToString();
    }

    private async Task SelectUser(Guid userId)
    {
        if (selectedUserId == userId)
        {
            selectedUserId = null;
            return;
        }

        selectedUserId = userId;
        loadingDetail = true;

        var user = users.First(u => u.Id == userId);
        detailPushSubCount = PushStore.GetSubscriptions(user.Username).Count();

        var (ips, agents) = await ActionLog.GetUserConnectionDetailsAsync(userId.ToString());
        detailIPs = ips;
        detailUserAgents = agents;
        loadingDetail = false;
    }

    // Bot settings
    private string botUsername = "";
    private string botDisplayName = "";
    private string botWelcomeMessage = "";
    private bool botSaving;
    private string? botSaveResult;

    // Debug message generator
    private Guid debugChannelId;
    private int debugMessageCount = 200;
    private int debugTimeSpan = 168; // hours
    private bool debugGenerating;
    private string? debugResult;

    private async Task GenerateMessages()
    {
        if (!UserState.UserId.HasValue) return;

        debugGenerating = true;
        debugResult = null;
        StateHasChanged();

        try
        {
            var span = TimeSpan.FromHours(debugTimeSpan);
            var generated = await ChatService.GenerateTestMessagesAsync(
                debugChannelId, UserState.UserId.Value, UserState.Username!, debugMessageCount, span);
            debugResult = $"Generated {generated} messages spread across {span.TotalHours}h";
        }
        catch (Exception ex)
        {
            debugResult = $"Error: {ex.Message}";
        }
        finally
        {
            debugGenerating = false;
        }
    }

    private async Task SaveBotSettings()
    {
        botSaving = true;
        botSaveResult = null;
        StateHasChanged();

        try
        {
            await BotService.UpdateDisplayNameAsync(botDisplayName.Trim());
            await BotService.UpdateWelcomeMessageAsync(botWelcomeMessage.Trim());
            botSaveResult = "Saved!";
        }
        catch (Exception ex)
        {
            botSaveResult = $"Error: {ex.Message}";
        }
        finally
        {
            botSaving = false;
        }
    }

    // Registration settings
    private bool regClosed;
    private bool regApproval;
    private bool smartMode;
    private List<(string Username, DateTime RequestedAt)> pendingUsersList = new();

    // Link preview settings
    private bool linkPreviewsEnabled;
    private bool mediaCachingEnabled;

    // GIF settings
    private string gifContentRating = "PG";

    private async Task ToggleRegistrationClosed(ChangeEventArgs e)
    {
        regClosed = (bool)(e.Value ?? false);
        await RegistrationGate.SetRegistrationClosedAsync(regClosed);
    }

    private async Task ToggleRequireApproval(ChangeEventArgs e)
    {
        regApproval = (bool)(e.Value ?? false);
        await RegistrationGate.SetRequireApprovalAsync(regApproval);
    }

    private async Task ToggleSmartMode(ChangeEventArgs e)
    {
        smartMode = (bool)(e.Value ?? false);
        await RegistrationGate.SetSmartModeAsync(smartMode);
    }

    private async Task ToggleLinkPreviews(ChangeEventArgs e)
    {
        linkPreviewsEnabled = (bool)(e.Value ?? false);
        await LinkPreviewSettings.SetEnabledAsync(linkPreviewsEnabled);
    }

    private async Task ToggleMediaCaching(ChangeEventArgs e)
    {
        mediaCachingEnabled = (bool)(e.Value ?? false);
        await LinkPreviewSettings.SetMediaCachingEnabledAsync(mediaCachingEnabled);
    }

    private async Task UpdateGifContentRating()
    {
        if (Enum.TryParse<Yap.Services.Gifs.KlipyRating>(gifContentRating, out var parsed))
        {
            await GifAdminSettings.SetKlipyRatingAsync(parsed);
        }
    }


    // Invites section

    private void LoadLinks()
    {
        var all = AccessLinks.GetAll();
        openInvites = all.Where(l => !l.IsClaimed && l.IsActive)
            .OrderByDescending(l => l.CreatedAt).ToList();
        // Revoked user links are history (every "New Link" leaves one behind). Expired ones
        // stay listed so the admin can see why someone can't get in.
        userLinks = all.Where(l => l.IsClaimed && !l.IsRevoked)
            .OrderByDescending(l => l.IsActive).ThenByDescending(l => l.CreatedAt).ToList();
    }

    private async Task CreateInviteLink()
    {
        if (!UserState.UserId.HasValue || inviteCreating) return;
        inviteCreating = true;
        inviteCreateResult = null;

        try
        {
            DateTime? expiresAt = int.TryParse(inviteExpiryDays, out var days) && days > 0
                ? DateTime.UtcNow.AddDays(days)
                : null;

            if (Guid.TryParse(inviteTargetUserId, out var targetId) && UserService.GetById(targetId) is { } target)
            {
                var link = await AccessLinks.CreateForUserAsync(targetId, UserState.UserId.Value, expiresAt);
                if (link != null)
                {
                    _ = BotService.NotifyLinkReplacedByAdminAsync(target, link);
                    inviteCreateResult = $"New link for {target.Username} created. Their old one no longer works.";
                }
                else
                {
                    inviteCreateResult = "Failed to create link";
                }
            }
            else
            {
                var link = await AccessLinks.CreateInviteAsync(UserState.UserId.Value, inviteNote, expiresAt);
                inviteCreateResult = link != null ? "Invite created" : "Failed to create invite";
                inviteNote = "";
            }

            LoadLinks();
        }
        finally
        {
            inviteCreating = false;
        }
    }

    private async Task RevokeLink(AccessLink link)
    {
        await AccessLinks.RevokeAsync(link.Id);
        LoadLinks();
    }

    private async Task ChangeLinkExpiry(AccessLink link, ChangeEventArgs e)
    {
        var choice = e.Value?.ToString() ?? "current";
        if (choice == "current") return;

        DateTime? expiresAt = int.TryParse(choice, out var days) ? DateTime.UtcNow.AddDays(days) : null;
        await AccessLinks.SetExpiryAsync(link.Id, expiresAt);
        LoadLinks();
    }

    private async Task CopyInviteLink(AccessLink link)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", AccessLinks.BuildUrl(link.Code, Navigation.BaseUri));
        copiedLinkId = link.Id;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
        {
            if (copiedLinkId == link.Id) copiedLinkId = null;
            StateHasChanged();
        }));
    }

    private static string ExpiryLabel(AccessLink link) => link.ExpiresAt is { } at
        ? (at <= DateTime.UtcNow ? $"expired {at:yyyy-MM-dd}" : at.ToString("yyyy-MM-dd"))
        : "never";

    private static string LinkStatus(AccessLink link) =>
        link.IsRevoked ? "Revoked" : link.IsExpired ? "Expired" : "Active";

    private RenderFragment<AccessLink> CopyButton => l =>
        @<button class="refresh-btn" title="@(copiedLinkId == l.Id ? "Copied!" : "Copy link")" @onclick="() => CopyInviteLink(l)">
