    // Derives preview URLs from the upload pipeline's naming conventions (ImageService
    // thumbnails, VideoService posters, GifService library). The log is historical, so the
    // files may no longer exist — the img's onerror hides dead previews client-side.
    private (string? Thumb, string? Link) GetMediaPreview(MediaUploadLog entry)
    {
        // Also strips the "gif/" prefix from gif entries ("gif/{entryId}" → "{entryId}")
        var baseName = Path.GetFileNameWithoutExtension(entry.StoredFileName);
        return entry.FileType switch
        {
            "image" => ($"/uploads/{baseName}_800px.webp", $"/uploads/{entry.StoredFileName}"),

            // A recorded compress duration means the video was re-encoded to .mp4 (and a
            // non-mp4 original deleted), so link to the .mp4 in that case.
            "video" => ($"/uploads/{baseName}_poster.webp",
                        entry.CompressDurationMs.HasValue ? $"/uploads/{baseName}.mp4" : $"/uploads/{entry.StoredFileName}"),

            // Routed to the GIF library — resolve live, same preview logic as the GIFs tab
            // (thumb prefers the derived preview, the link opens the full file).
            "gif" when Guid.TryParse(baseName, out var gifId) && GifService.GetEntry(gifId) is { } gif
                => (gif.PreviewUrl ?? gif.GifUrl ?? gif.RemoteGifUrl, gif.GifUrl ?? gif.RemoteGifUrl),

            _ => (null, null)
        };
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

