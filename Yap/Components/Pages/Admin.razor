    private static string GifFormat(GifEntry g)
    {
        var url = g.GifUrl ?? g.Mp4Url ?? g.WebmUrl;
        if (string.IsNullOrEmpty(url)) return "?";
        var ext = Path.GetExtension(url).TrimStart('.').ToLowerInvariant();
        return string.IsNullOrEmpty(ext) ? "?" : ext;
    }

    // Inline tag editing — tags are what makes a custom GIF findable in the picker's local search,
    // and uploaders won't tag anything themselves, so the admin curates them here.
    private Guid? editingGifTagsId;
    private string gifTagsDraft = "";

    private void StartEditGifTags(GifEntry g)
    {
        editingGifTagsId = g.Id;
        gifTagsDraft = string.Join(", ", GifService.GetTags(g));
    }

    private void CancelEditGifTags()
    {
        editingGifTagsId = null;
        gifTagsDraft = "";
    }

    private async Task SaveGifTagsAsync()
    {
        if (editingGifTagsId is not Guid id) return;
        await GifService.SetTagsAsync(id,
            gifTagsDraft.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        CancelEditGifTags();
    }

    private async Task HandleGifTagsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveGifTagsAsync();
        else if (e.Key == "Escape") CancelEditGifTags();
    }

    // Row actions: server-library promotion and deletion (the eviction lever — works on
    // provider-cache rows too). Delete uses the same two-tap confirm as GifLibraryManager.
    private Guid? confirmDeleteGifId;

    private async Task ToggleServerGifAsync(GifEntry g)
    {
        confirmDeleteGifId = null;
        await GifService.SetServerGifAsync(g.Id, !g.IsServerGif);
        RefreshGifEntries();
    }

    private async Task DeleteGifEntryAsync(GifEntry g)
    {
        if (confirmDeleteGifId != g.Id)
        {
            confirmDeleteGifId = g.Id;
            return;
        }
        confirmDeleteGifId = null;

        if (UserState.UserId is not Guid adminId) return;
        await GifService.DeleteEntryAsync(adminId, g.Id, force: true);
        RefreshGifEntries();
    }

