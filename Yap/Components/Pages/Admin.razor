    private string ResolveUsername(string userUid)
    {
        if (_uidToUsername.TryGetValue(userUid, out var cached))
            return cached;

        if (Guid.TryParse(userUid, out var guid))
        {
            var user = UserService.GetById(guid);
            var name = user?.Username ?? userUid;
            _uidToUsername[userUid] = name;
            return name;
        }

        _uidToUsername[userUid] = userUid;
        return userUid;
    }

