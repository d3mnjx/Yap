    // Remaining time rather than a wall-clock instant: no timezone or culture plumbing, and
    // "another 6 days" is what the user actually wants to know.
    private string ServerMuteHint => MuteExpiry is { } until
        ? $"Muted for another {FormatRemaining(until - DateTime.UtcNow)}."
        : "Muted until you turn notifications back on.";

    private DateTime? MuteExpiry =>
        UserState.UserId.HasValue ? UserService.GetById(UserState.UserId.Value)?.NotifServerMuteUntil : null;

    private static string FormatRemaining(TimeSpan left)
    {
        if (left <= TimeSpan.Zero) return "a moment";
        if (left.TotalMinutes < 60) return $"{Math.Max(1, (int)left.TotalMinutes)} minutes";
        if (left.TotalHours < 24) return Plural((int)left.TotalHours, "hour");
        return Plural((int)left.TotalDays, "day");
    }

    private static string Plural(int count, string unit) =>
        count == 1 ? $"1 {unit}" : $"{count} {unit}s";

    /// <summary>
    /// Reads the stored notification state into the component fields, and tidies a server mute
    /// whose timer has run out (the evaluation treats it as expired already; this makes the row agree).
    /// </summary>
    private async Task LoadNotificationSettingsAsync()
    {
        if (!UserState.UserId.HasValue || UserState.Username == null) return;

        var user = UserService.GetById(UserState.UserId.Value);
        if (user == null) return;

        await NotificationSettings.ClearExpiredServerMuteAsync(user);

        serverMuted = NotificationSettings.IsServerMuted(user);
        mutePreset = PresetForExpiry(user.NotifServerMuteUntil);
        dmMode = user.NotifDmMode;
        roomMode = user.NotifRoomMode;
        newDmsMuted = user.NotifNewDmsMuted;

        rooms = ChatService.GetRooms();

        // Only conversations with real history, newest first. An empty DM channel means someone
        // opened a profile once, which is not something to offer a mute switch for.
        var channelsByPartner = ChatService.GetDMChannels(UserState.Username)
            .Select(c => (Channel: c, Partner: c.GetOtherParticipant(UserState.Username)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Partner))
            .ToDictionary(x => x.Partner!, x => x.Channel, StringComparer.OrdinalIgnoreCase);

        dmChannels = ChatService.GetDMConversations(UserState.Username)
            .OrderByDescending(c => c.LastMessageAt)
            .Where(c => channelsByPartner.ContainsKey(c.Username))
            .Select(c => (
                channelsByPartner[c.Username].Id,
                UserService.GetByUsername(c.Username)?.EffectiveDisplayName ?? c.Username))
            .ToList();
    }

    /// <summary>
    /// Which duration button to light up for a stored expiry: the shortest preset that still
    /// covers the time left. Exact until the remaining time drops below the next preset down,
    /// and the hint line carries the real expiry either way.
    /// </summary>
    private static int PresetForExpiry(DateTime? until)
    {
        if (until is not { } expiry) return DefaultMutePreset;

        var remaining = expiry - DateTime.UtcNow;
        for (var i = 0; i < MuteDurations.Length; i++)
        {
            if (MuteDurations[i].Duration is { } d && d >= remaining)
                return i;
        }
        return DefaultMutePreset;
    }

    private async Task SetServerMutedAsync(bool muted)
    {
        if (!UserState.UserId.HasValue) return;

        serverMuted = muted;
        if (muted) mutePreset = DefaultMutePreset;

        await UserService.SetServerMuteAsync(UserState.UserId.Value, muted, Expiry(mutePreset));
        if (!muted) await LoadNotificationSettingsAsync();  // refresh the lists we're about to show
        Logger.LogDebug("Server notifications {State} for {Username}", muted ? "muted" : "allowed", UserState.Username);
    }

    private async Task SetMuteDurationAsync(int index)
    {
        if (!UserState.UserId.HasValue) return;

        mutePreset = index;
        await UserService.SetServerMuteAsync(UserState.UserId.Value, muted: true, Expiry(index));
    }

    private static DateTime? Expiry(int presetIndex) =>
        MuteDurations[presetIndex].Duration is { } d ? DateTime.UtcNow + d : null;

    private async Task SetDmModeAsync(NotificationMode mode)
    {
        if (!UserState.UserId.HasValue) return;
        dmMode = mode;
        await UserService.SetDmNotificationModeAsync(UserState.UserId.Value, mode);
    }

    private async Task SetRoomModeAsync(NotificationMode mode)
    {
        if (!UserState.UserId.HasValue) return;
        roomMode = mode;
        await UserService.SetRoomNotificationModeAsync(UserState.UserId.Value, mode);
    }

    private async Task ToggleNewDmsAsync()
    {
        if (!UserState.UserId.HasValue) return;
        newDmsMuted = !newDmsMuted;
        await UserService.SetNewDmsMutedAsync(UserState.UserId.Value, newDmsMuted);
