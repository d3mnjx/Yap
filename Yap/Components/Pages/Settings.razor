@page "/settings"
@layout ChatLayout
@inject UserStateService UserState
@inject UserService UserService
@inject ImageService ImageService
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PushSubscriptionStore PushStore
@inject PushNotificationService PushService
@inject GeoLocationService GeoLocation
@inject IHttpContextAccessor HttpContextAccessor
@inject ChatService ChatService
@inject NotificationSettingsService NotificationSettings
@inject EmojiService EmojiService
@inject RegistrationGateService RegistrationGate
@inject AccessLinkService AccessLinks
@inject ILogger<Settings> Logger
@implements IAsyncDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    @if (showKickedNotice)
    {
        <div class="kicked-notice">
            <span class="kicked-notice-icon">&#x1f512;</span>
            <div class="kicked-notice-text">
                <strong>All other devices have been signed out.</strong>
                @(hasLink ? "Your login link keeps working. " : "")@(hasPassword ? "Your secret code was automatically changed. See the new one below." : "")
            </div>
            <button class="kicked-notice-dismiss" @onclick="() => showKickedNotice = false">&times;</button>
        </div>
    }

    <div class="settings-header">
        <h2>Settings</h2>
        @if (saveStatus != null)
        {
            <span class="save-status @(saveStatus == "Saved" ? "saved" : "saving")">@saveStatus</span>
        }
    </div>

    <div class="settings-content">
        <p class="form-hint" style="margin-bottom: 12px;">Changes are saved automatically.</p>
        <div class="settings-section">
            <h3>Profile</h3>

            <div class="profile-picture-section">
                <Avatar Username="@(UserState.Username ?? "")"
                        ProfilePictureUrl="@profilePictureUrl"
                        Size="AvatarSize.Large" />

                <div class="profile-picture-actions">
                    <InputFile OnChange="HandleProfilePictureUpload" accept="image/*" id="profile-upload" class="file-input" />
                    <label for="profile-upload" class="upload-button">
                        @if (isUploading)
                        {
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>@(string.IsNullOrEmpty(profilePictureUrl) ? "Upload Picture" : "Change Picture")</span>
                        }
                    </label>
                    @if (!string.IsNullOrEmpty(profilePictureUrl))
                    {
                        <button class="remove-button" @onclick="RemoveProfilePicture" disabled="@isUploading">
                            Remove
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="display-name">Display Name</label>
                <input type="text" id="display-name" value="@displayName"
                       @oninput="OnDisplayNameInput"
                       placeholder="@(UserState.Username ?? "Username")" maxlength="64" class="form-input" />
                <span class="form-hint">Your username is @UserState.Username, but your display name can be more fun. It can contain symbols and emojis :) </span>
            </div>

            <div class="form-group">
                <label for="bio">Bio</label>
                <textarea id="bio" value="@bio"
                          @oninput="OnBioInput" maxlength="150"
                          placeholder="Why are you awesome..." class="form-textarea"></textarea>
                <span class="form-counter">@(bio?.Length ?? 0)/150</span>
            </div>

            <div class="form-group">
                <label for="country">Tell us where are you from - map is in the making!</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text" id="country" value="@country"
                           @oninput="OnCountryInput"
                           placeholder="London" maxlength="100" class="form-input" style="flex: 1;" />
                    @if (detectedLocation != null)
                    {
                        <button class="upload-button" @onclick="FillDetectedLocation" style="white-space: nowrap;">
                            Detect
                        </button>
                    }
                </div>
                <span class="form-hint">Your location — used for the user map</span>
            </div>
        </div>

        <div class="settings-section">
            <h3>Appearance</h3>
            <span class="form-hint" style="margin-bottom: 12px;">Pick a color theme. Changes apply instantly and sync across your devices.</span>
            <div class="theme-grid">
                @foreach (var theme in ThemeRegistry.All)
                {
                    var id = theme.Id;
                    <button type="button" class="theme-card @(selectedTheme == id ? "selected" : "")"
                            @onclick="() => SelectTheme(id)" title="@theme.Name">
                        <div class="theme-card-preview" style="background: @theme.PreviewBg;">
                            <span class="theme-card-accent-dot" style="background: @theme.PreviewAccent;"></span>
                            @if (selectedTheme == id)
                            {
                                <span class="theme-card-check">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                            }
                        </div>
                        <span class="theme-card-name">@theme.Name</span>
                    </button>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Text Size</h3>
            <span class="form-hint" style="margin-bottom: 12px;">Scales all text in the app. Applies instantly and syncs across your devices.</span>
            <div class="font-size-row">
                @foreach (var size in FontSizePresets)
                {
                    <button type="button" class="font-size-option @(selectedFontSize == size ? "selected" : "")"
                            @onclick="() => SelectFontSize(size)" title="@(size)px">
                        <span class="font-size-sample" style="font-size: @(size)px;">Aa</span>
                        <span class="font-size-value">@(size == DefaultFontSize ? "Default" : $"{size}px")</span>
                    </button>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Login Link</h3>

            <span class="form-hint" style="margin-bottom: 12px;">@MultiDeviceSummary</span>

            @if (loginLink != null)
            {
                <span class="form-hint" style="margin-bottom: 12px;">Open this link on any device or browser to sign in as <strong>@UserState.Username</strong>. Anyone who has it can sign in, so keep it private. On the login page you can also type the last part of the link (the code) as your secret code.</span>
                <div class="passphrase-display">
                    <span class="passphrase-value">@(showLink ? loginLinkUrl : MaskedLinkUrl)</span>
                    <button class="passphrase-eye" @onclick="() => showLink = !showLink" title="@(showLink ? "Hide" : "Reveal")">
                        @if (showLink)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        }
                    </button>
                    <button class="passphrase-eye" @onclick="CopyLink" title="@(_copiedLink ? "Copied!" : "Copy")">
                        @if (_copiedLink)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        }
                    </button>
                </div>
                <div class="passphrase-actions">
                    <button class="remove-button" @onclick="RegenerateLink">New Link</button>
                    <button class="remove-button" @onclick="RevokeLink">Revoke</button>
                    <select class="expiry-select" value="@linkExpiryChoice" @onchange="ChangeLinkExpiry" title="Expiry">
                        @if (linkExpiryChoice == "current")
                        {
                            <option value="current">Expires @loginLink.ExpiresAt!.Value.ToString("yyyy-MM-dd")</option>
                        }
                        <option value="never">Never expires</option>
                        <option value="1">Expires in 1 day</option>
                        <option value="7">Expires in 7 days</option>
                        <option value="30">Expires in 30 days</option>
                    </select>
                </div>
                @if (linkSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@linkSaveStatus</span>
                }
            }
            else
            {
                <span class="form-hint" style="margin-bottom: 12px;">Create a link that signs you in on any device or browser. Save it somewhere safe, like your notes. It's the easiest way back into this account.</span>
                <button class="upload-button" @onclick="CreateLink">Create Login Link</button>
                @if (linkSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@linkSaveStatus</span>
                }
            }

            @if (RegistrationGate.SmartMode)
            {
                <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-primary);">
                    <label class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Allow smart login</span>
                            <span class="toggle-hint">Log in without a code from a network you've used recently.</span>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@smartLoginAllowed" @onchange="ToggleSmartLogin" />
                            <span class="toggle-slider"></span>
                        </label>
                    </label>
                </div>
            }
        </div>

        <div class="settings-section">
            <h3>Secret Code</h3>

            @if (hasPassword)
            {
                <span class="form-hint" style="margin-bottom: 12px;">Use this secret code to log in as <strong>@UserState.Username</strong> on another device or browser.</span>
                <div class="passphrase-display">
                    <span class="passphrase-value">@(showPassphrase ? currentPassword : "••••••••••")</span>
                    <button class="passphrase-eye" @onclick="() => showPassphrase = !showPassphrase" title="@(showPassphrase ? "Hide" : "Reveal")">
                        @if (showPassphrase)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        }
                    </button>
                    <button class="passphrase-eye" @onclick="CopyPassphrase" title="@(_copiedPassphrase ? "Copied!" : "Copy")">
                        @if (_copiedPassphrase)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        }
                    </button>
                </div>
                <div class="passphrase-actions">
                    <button class="remove-button" @onclick="RegeneratePassphrase">New Code</button>
                    <button class="remove-button" @onclick="RemovePassword">Disable</button>
                </div>
                @if (passwordSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@passwordSaveStatus</span>
                }
            }
            else
            {
                <span class="form-hint" style="margin-bottom: 12px;">The older way in: a short code you type together with your username on the login page. Optional now that login links exist.</span>
                <button class="upload-button" @onclick="EnablePassphrase">Enable Secret Code</button>
                @if (passwordSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@passwordSaveStatus</span>
                }
            }
        </div>

        <div class="settings-section">
            <h3>Active Sessions</h3>

            @if (sessions.Count > 0)
            {
                <div class="sessions-list">
                    @foreach (var session in sessions)
                    {
                        var isCurrentDevice = session.SessionId == UserState.SessionId;
                        <div class="session-item @(isCurrentDevice ? "current" : "")">
                            <span class="session-icon">@(session.IsMobile == true ? "📱" : "🖥️")</span>
                            <div class="session-details">
                                <div class="session-line">
                                    @if (isCurrentDevice)
                                    {
                                        <span class="session-badge">This device</span>
                                    }
                                    <span class="session-ip">@(session.ClientIp ?? "Unknown IP")</span>
                                </div>
                                <span class="session-activity">Active @FormatRelativeTime(session.LastActivity)</span>
                            </div>
                        </div>
                    }
                </div>

                @* Revocation also covers disconnected sessions retained outside the active list. *@
                @if (UserState.Username is { } sessionUsername && ChatService.GetSessionsForUser(sessionUsername)
                    .Any(session => session.SessionId != UserState.SessionId))
                {
                    <div style="margin-top: 12px;">
                        <button class="remove-button" @onclick="SignOutOtherDevices" disabled="@isSigningOutOthers">
                            @(isSigningOutOthers ? "Signing out..." : "Sign out all other devices")
                        </button>
                    </div>
                    @if (signOutStatus != null)
                    {
                        <span class="save-status saved" style="margin-top: 4px;">@signOutStatus</span>
                    }
                }
            }
            else
            {
                <span class="form-hint">No active sessions.</span>
            }
        </div>

        

        <div class="settings-section">
            <h3>Install as App</h3>

            @if (isPwa)
            {
                <div class="pwa-installed-info">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="pwa-check-icon">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </svg>
                    <span>Yap is installed as an app on this device.</span>
                </div>
            }
            else
            {
                <p class="pwa-description">Install Yap to your home screen for a full-screen experience with push notifications and quick access.</p>
                <button class="upload-button" @onclick="InstallPwa">Install Yap</button>
            }
        </div>

        <div class="settings-section">
            <h3>Device Push Notifications</h3>
            <p class="section-intro">Push lets Yap notify a device even when the tab is closed. Each device subscribes separately.</p>

            <div class="notification-status">
                <div class="notification-row">
                    <span class="notification-label">This device</span>
                    <span class="notification-value @GetPushStatusClass()">@GetPushStatusText()</span>
                </div>

                @if (!string.IsNullOrEmpty(pushPermission) && pushPermission != "unsupported")
                {
                    <div class="notification-row">
                        <span class="notification-label">Browser Permission</span>
                        <span class="notification-value @GetPermissionClass()">@pushPermission</span>
                    </div>
                }

                <div class="notification-row">
                    <span class="notification-label">Subscribed Devices</span>
                    <span class="notification-value">@serverSubscriptionCount device(s)</span>
                </div>

            </div>

            @if (pushDevices.Count > 0)
            {
                <div class="sessions-list" style="margin-bottom: 1rem;">
                    @foreach (var device in pushDevices)
                    {
                        var isThisDevice = currentEndpoint != null && device.Endpoint == currentEndpoint;
                        <div class="session-item @(isThisDevice ? "current" : "")">
                            <span class="session-icon">🔔</span>
                            <div class="session-details">
                                <div class="session-line">
                                    @if (isThisDevice)
                                    {
                                        <span class="session-badge">This device</span>
                                    }
                                    <span class="session-ip">@DescribePushEndpoint(device.Endpoint)</span>
                                </div>
                                <span class="session-activity">Added @FormatRelativeTime(device.CreatedAt)</span>
                                @if (PushStore.GetLastDelivered(device.Endpoint) is DateTime delivered)
                                {
                                    <span class="session-activity">Delivered @FormatRelativeTime(delivered)</span>
                                }
                            </div>
                            <button class="remove-button" style="margin-left: auto; padding: 0.25rem 0.625rem; font-size: 0.75rem; flex-shrink: 0;"
                                    @onclick="() => RemovePushDevice(device.Endpoint)" title="Remove this device">
                                Remove
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="notification-actions">
                @if (!pushSupported)
                {
                    <span class="form-hint">Push notifications are not supported in this browser.</span>
                }
                else if (!PushService.IsConfigured)
                {
                    <span class="form-hint">Push notifications are not configured on this server.</span>
                }
                else if (pushPermission == "denied")
                {
                    <span class="form-hint">Notification permission was denied. Reset it in your browser settings to re-enable.</span>
                }
                else if (pushSubscribed)
                {
                    <div class="notification-buttons">
                        <button class="remove-button" @onclick="DisablePush" disabled="@pushToggling">
                            @(pushToggling ? "Turning off..." : "Turn off push on this device")
                        </button>
                    </div>
                    <span class="form-hint">Stops push for this device only. Other devices stay subscribed; remove them in the list above.</span>
                }
                else
                {
                    <button class="upload-button" @onclick="EnablePush" disabled="@pushToggling">
                        @(pushToggling ? "Enabling..." : "Enable push on this device")
                    </button>
                    <span class="form-hint">Your browser will ask for permission. Yap can then notify this device even when the tab is closed.</span>
                }

                @if (PushService.IsConfigured && serverSubscriptionCount > 0)
                {
                    <div class="notification-buttons" style="margin-top: 8px;">
                        <button class="upload-button" @onclick="SendTestNotification" disabled="@sendingTest">
                            @(sendingTest ? "Sending..." : "Send a test to all devices")
                        </button>
                    </div>
                    <span class="form-hint">Sends a notification to every subscribed device — the ones that buzz are alive.</span>
                }
                @if (pushActionStatus != null)
                {
                    <span class="save-status @(pushActionIsError ? "error" : "saved")" style="margin-top: 4px;">@pushActionStatus</span>
                }

                <span class="form-hint">
                    Push only makes delivery possible. What actually notifies you is set in
                    <a href="#notification-settings" @onclick="ScrollToNotificationRules" @onclick:preventDefault>Allow / Mute Notifications</a> below.
                </span>
            </div>
        </div>

        @* Per-channel mute rules. Deliberately below the push section: that one answers "can this
           device be notified at all", this one answers "what is worth notifying me about". *@
        <div class="settings-section" id="notification-settings">
            <h3>Allow / Mute Notifications</h3>
            <p class="section-intro">Choose what actually notifies you. These rules follow your account on every device.</p>

            <div class="notif-row">
                <span class="notif-row-label">Everything on this server</span>
                <div class="segmented" role="radiogroup" aria-label="Server notifications">
                    <button type="button" role="radio" aria-checked="@(!serverMuted)"
                            class="seg-btn @(serverMuted ? "" : "seg-selected")"
                            @onclick="() => SetServerMutedAsync(false)">
                        @IconBell<span>Allow</span>
                    </button>
                    <button type="button" role="radio" aria-checked="@serverMuted"
                            class="seg-btn @(serverMuted ? "seg-selected" : "")"
                            @onclick="() => SetServerMutedAsync(true)">
                        @IconBellOff<span>Mute</span>
                    </button>
                </div>
            </div>

            @if (serverMuted)
            {
                <div class="notif-row">
                    <span class="notif-row-label">Mute for</span>
                    <div class="segmented segmented-wrap" role="radiogroup" aria-label="Mute duration">
                        @for (var i = 0; i < MuteDurations.Length; i++)
                        {
                            var index = i;
                            <button type="button" role="radio" aria-checked="@(mutePreset == index)"
                                    class="seg-btn @(mutePreset == index ? "seg-selected" : "")"
                                    @onclick="() => SetMuteDurationAsync(index)">
                                <span>@MuteDurations[index].Label</span>
                            </button>
                        }
                    </div>
                </div>
                <span class="form-hint">@ServerMuteHint</span>
            }
            else
            {
                <div class="notif-divider"></div>

                <div class="notif-row">
                    <span class="notif-row-label">Direct messages</span>
                    @ModePicker("Direct messages", dmMode, SetDmModeAsync)
                </div>

                @if (dmMode == NotificationMode.Individual)
                {
                    <div class="notif-list">
                        @foreach (var dm in dmChannels)
                        {
                            var muted = IsIndividuallyMuted(dm.ChannelId, isDm: true);
                            <div class="notif-item">
                                <span class="notif-item-name">@EmojiService.ConvertEmojis(dm.DisplayName, inline: true)</span>
                                @ItemToggle(muted, () => ToggleChannelAsync(dm.ChannelId, muted))
                            </div>
                        }
                        @* Not a channel, so it can't be a row above: this is the fallback for every DM
                           partner with no override row yet, including people who write for the first time. *@
                        <div class="notif-item notif-item-default">
                            <span class="notif-item-name">New DMs</span>
                            @ItemToggle(newDmsMuted, ToggleNewDmsAsync)
                        </div>
                    </div>
                }

                <div class="notif-divider"></div>

                <div class="notif-row">
                    <span class="notif-row-label">Rooms</span>
                    @ModePicker("Rooms", roomMode, SetRoomModeAsync)
                </div>

                @if (roomMode == NotificationMode.Individual)
                {
                    <div class="notif-list">
                        @foreach (var room in rooms)
                        {
                            var muted = IsIndividuallyMuted(room.Id, isDm: false);
                            <div class="notif-item">
                                <span class="notif-item-name">#@EmojiService.ConvertEmojis(room.Name, inline: true)</span>
                                @ItemToggle(muted, () => ToggleChannelAsync(room.Id, muted))
                            </div>
                        }
                    </div>
                }

                <span class="form-hint">
                    A muted room or DM still shows a small dot in the sidebar when something arrives.
                    It sends no notification, plays no sound, and adds nothing to the unread count.
                </span>
            }
        </div>

        <div class="settings-section">
            <h3>Time & Date</h3>

            <div class="form-group">
                <label>Your time</label>
                <div class="time-widget">
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(-1)" title="−1 hour">−</button>
                    <span class="current-time">@GetCurrentTime()</span>
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(1)" title="+1 hour">+</button>
                    <button class="upload-button" @onclick="DetectTimezone" style="white-space: nowrap; margin-left: 8px;">
                        Detect
                    </button>
                </div>
                <span class="form-hint">Adjust if the time doesn't match your clock</span>
            </div>

            @{
                var previewTime = GetPreviewTime();
                var activeCulture = GetActiveCulture();
                var availableCultures = LocaleResolver.GetAvailableCultures(UserState.Locale, timeZone);
            }

            <div class="form-group">
                <label>Clock</label>
                <div class="format-options">
                    @foreach (var clk in LocaleResolver.GetOrderedClockStyles(UserState.Locale))
                    {
                        var id = clk.Id;
                        <label class="format-option @(clockStyle == id ? "selected" : "")">
                            <input type="radio" name="clock" checked="@(clockStyle == id)"
                                   @onchange="() => SelectClock(id)" />
                            <span class="format-example">@previewTime.ToString(clk.TimeFormat, activeCulture)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Date order</label>
                <div class="format-options">
                    @foreach (var order in LocaleResolver.GetOrderedDateOrders(UserState.Locale))
                    {
                        var id = order.Id;
                        <label class="format-option @(dateOrder == id ? "selected" : "")">
                            <input type="radio" name="dateOrder" checked="@(dateOrder == id)"
                                   @onchange="() => SelectDateOrder(id)" />
                            <span class="format-example">@previewTime.ToString(order.FullDate, activeCulture)</span>
                        </label>
                    }
                </div>
            </div>

            @if (availableCultures.Count > 1)
            {
                <div class="form-group">
                    <label>Separators</label>
                    <div class="format-options">
                        @foreach (var c in availableCultures)
                        {
                            var name = c.Name;
                            var isSelected = (cultureOverride == null && name == availableCultures[0].Name)
                                          || cultureOverride == name;
                            var fmt = LocaleResolver.BuildFormat(dateOrder, clockStyle);
                            <label class="format-option @(isSelected ? "selected" : "")">
                                <input type="radio" name="separators" checked="@isSelected"
                                       @onchange="() => SelectCulture(name)" />
                                <span class="format-example">@fmt.FormatExample(previewTime, c)</span>
                                <span class="format-label">@c.NativeName</span>
                            </label>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(UserState.TimeZone) || !string.IsNullOrEmpty(UserState.Locale))
            {
                <span class="form-hint">Detected: @(UserState.TimeZone ?? "—") · @(UserState.Locale ?? "—")</span>
            }
        </div>

        <div class="settings-section" id="gif-library">
            <h3>My GIFs</h3>
            <p class="form-hint" style="margin-bottom: 1rem;">
                Your GIF pool — everything you've starred plus your own uploads. Organize with
                folders, edit search keywords, or bring a whole collection: import files or a zip,
                and export everything as a zip you can take anywhere.
            </p>
            @if (UserState.UserId is Guid gifUserId)
            {
                @* Small InitialVisibleCount keeps the section short — "Show all" expands in place. *@
                <GifLibraryManager Mode="GifLibraryMode.User" CurrentUserId="@gifUserId" InitialVisibleCount="6" />
            }
        </div>

        <div class="settings-section">
            <details class="debug-info">
                <summary>DEBUG INFO</summary>

                <p class="form-hint" style="margin-bottom: 12px;">
                    Read live from this device via the browser's Cache Storage API — the same store the
                    service worker writes to, so this is genuine proof that PWA caching works locally.
                    Clearing a cache keeps your locally saved drafts and outgoing messages.
                </p>

                @if (cacheReport is null)
                {
                    <span class="form-hint">@(loadingCache ? "Reading cache…" : "Cache report unavailable.")</span>
                }
                else if (!cacheReport.Supported)
                {
                    <span class="form-hint">Cache Storage API is not available in this browser.</span>
                }
                else
                {
                    <div class="notification-status">
                        <div class="notification-row">
                            <span class="notification-label">Cached files</span>
                            <span class="notification-value">@cacheReport.TotalCount file@(cacheReport.TotalCount == 1 ? "" : "s") · @FormatBytes(cacheReport.TotalBytes)</span>
                        </div>
                        @if (cacheReport.Usage is long usage)
                        {
                            <div class="notification-row">
                                <span class="notification-label">Origin storage estimate</span>
                                <span class="notification-value">@FormatBytes(usage)@(cacheReport.Quota is long quota ? $" of {FormatBytes(quota)}" : "")</span>
                            </div>
                        }
                    </div>

                    @foreach (var group in cacheReport.Caches)
                    {
                        <div class="cache-group">
                            <div class="cache-group-header">
                                <span class="cache-group-name">@FriendlyCacheName(group.Name)</span>
                                <span class="cache-group-meta">@group.Count · @FormatBytes(group.TotalBytes)</span>
                            </div>
                            @if (group.Entries.Count == 0)
                            {
                                <span class="form-hint">Empty</span>
                            }
                            else
                            {
                                <div class="cache-entry-list">
                                    @foreach (var entry in group.Entries)
                                    {
                                        <div class="cache-entry" title="@entry.Url">
                                            <span class="cache-entry-name">@entry.Name</span>
                                            <span class="cache-entry-size">@FormatBytes(entry.Bytes)</span>
                                        </div>
                                    }
                                </div>
                            }
                            @* Browser cache prefixes are owned by wwwroot/chat-client/constants.js. *@
                            @if ((group.Name == "yap-media-v1" || group.Name.StartsWith("yap-chat-media-")) && group.Count > 0)
                            {
                                <button class="remove-button" style="margin-top: 8px; padding: 0.25rem 0.625rem; font-size: 0.75rem;"
                                        @onclick="() => ClearCache(group.Name)" title="Delete this cache to watch it re-populate">
                                    Clear this cache
                                </button>
                            }
                        </div>
                    }
                }
            </details>
        </div>
       
    </div>
</div>

@code {
    private string? displayName;
    private string? profilePictureUrl;
    private string? bio;
    private string? country;
    private string? detectedLocation;
    private string? timeZone;
    private string dateOrder = "dmy";
    private string clockStyle = "24h";
    private string? cultureOverride;
    private string selectedTheme = ThemeRegistry.DefaultId;

    private const int DefaultFontSize = 16; // browser default rem base
    private static readonly int[] FontSizePresets = [14, 15, 16, 17, 18, 20];
    private int selectedFontSize = DefaultFontSize;

    private bool isUploading = false;
    private string? saveStatus;
    private CancellationTokenSource? _debounceCts;

    // Account security state
    private bool hasPassword;
    private string? currentPassword;
    private bool showPassphrase;
    private string? passwordSaveStatus;
    private bool smartLoginAllowed = true;
    private bool _copiedPassphrase;

    // Login link state (one active link per user, see AccessLinkService)
    private AccessLink? loginLink;
    private string loginLinkUrl = "";
    private bool showLink;
    private bool _copiedLink;
    private string? linkSaveStatus;
    private string linkExpiryChoice = "never";

    private bool hasLink => loginLink != null;

    // Keep the host visible, hide the code: "https://example.com/invite/••••••••••••"
    private string MaskedLinkUrl => loginLinkUrl[..(loginLinkUrl.LastIndexOf('/') + 1)] + "••••••••••••";

    private string MultiDeviceSummary
    {
        get
        {
            var ways = new List<string>();
            if (hasLink) ways.Add("your login link");
            if (hasPassword) ways.Add("your secret code");
            if (RegistrationGate.SmartMode && smartLoginAllowed) ways.Add("smart login from a network you used recently");

            return ways.Count switch
            {
                0 => "This account is tied to this device only.",
                1 => $"You can log in from other devices with {ways[0]}.",
                _ => $"You can log in from other devices with {string.Join(", ", ways[..^1])} or {ways[^1]}."
            };
        }
    }

    // Active sessions state
    private List<ChatService.UserSession> sessions = new();
    private bool isSigningOutOthers = false;
    private string? signOutStatus;
    private bool showKickedNotice;

    // Push notification state
    private bool pushSupported = false;
    private bool pushSubscribed = false;
    private string? pushPermission;
    private int serverSubscriptionCount = 0;
    private bool isPwa = false;
    private bool pushToggling = false;

    // Per-device subscription list (Lite — no schema change)
    private IReadOnlyList<Yap.Models.PushSubscription> pushDevices = new List<Yap.Models.PushSubscription>();
    private string? currentEndpoint;       // this browser's push endpoint (for the "This device" badge)
    private bool sendingTest = false;
    private string? pushActionStatus;
    private bool pushActionIsError = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Load current values
        var user = UserService.GetById(UserState.UserId.Value);
        if (user != null)
        {
            displayName = user.DisplayName;
            profilePictureUrl = user.ProfilePictureUrl;
            bio = user.Bio;
            country = user.Country;
            timeZone = user.TimeZone;
            if (user.DateFormat != null)
            {
                (dateOrder, clockStyle, cultureOverride) = LocaleResolver.ParseDateFormat(user.DateFormat);
            }
            else
            {
                dateOrder = LocaleResolver.GuessDateOrderFromLocale(user.Locale);
                clockStyle = LocaleResolver.GuessClockFromLocale(user.Locale);
            }
            selectedTheme = ThemeRegistry.IsKnown(user.Theme) ? user.Theme! : ThemeRegistry.DefaultId;
            selectedFontSize = user.FontSize ?? DefaultFontSize;

            // Load password state
            currentPassword = user.Password;
            hasPassword = currentPassword != null;
            smartLoginAllowed = !user.SmartLoginOptOut;

            LoadLoginLink();
        }

        // Detect location from IP for the Detect button
        if (GeoLocation.IsAvailable)
        {
            var clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();
            var geo = GeoLocation.Lookup(clientIp);
            var location = geo?.ToString();
            if (!string.IsNullOrEmpty(location))
                detectedLocation = location;
        }

        // Server-side subscription list (doesn't need JS)
        RefreshPushDevices();

        await LoadNotificationSettingsAsync();

        // Load active sessions
        if (UserState.Username != null)
        {
            sessions = ChatService.GetActiveSessionsForUser(UserState.Username);
            ChatService.OnUsersListChanged += HandleUsersListChanged;
        }

        // Check if we just kicked other devices (query param from redirect)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("kicked", out var kicked) && kicked == "1")
        {
            showKickedNotice = true;
            showPassphrase = true; // reveal so user sees the new passphrase
        }

        // Set nav context
        NavState.SetTitleWithBack("Settings");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Settings.razor.js");
            await LoadPushStatusAsync();
            await LoadCacheReportAsync();
            StateHasChanged();

            // The header dropdown links straight to the notification block; honour the fragment.
            if (new Uri(Navigation.Uri).Fragment == "#notification-settings")
                await JS.InvokeVoidAsync("scrollToElementId", "notification-settings");
        }
    }

    private void OnDisplayNameInput(ChangeEventArgs e)
    {
        displayName = e.Value?.ToString();
        DebounceSave();
    }

    private void OnBioInput(ChangeEventArgs e)
    {
        bio = e.Value?.ToString();
        DebounceSave();
    }

    private void OnCountryInput(ChangeEventArgs e)
    {
        country = e.Value?.ToString();
        DebounceSave();
    }

    // --- Time & Date handlers ---

    private string GetCurrentTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
        var clk = LocaleResolver.ClockStyles.FirstOrDefault(c => c.Id == clockStyle) ?? LocaleResolver.ClockStyles[0];
        return now.ToString(clk.TimeFormat, GetActiveCulture());
    }

    private DateTimeOffset GetPreviewTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
    }

    private async Task AdjustTimezone(int hours)
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var newOffset = tz.BaseUtcOffset.Add(TimeSpan.FromHours(hours));

        // Clamp to valid range
        if (newOffset.TotalHours < -14) newOffset = TimeSpan.FromHours(-14);
        if (newOffset.TotalHours > 14) newOffset = TimeSpan.FromHours(14);

        timeZone = LocaleResolver.FormatOffset(newOffset);
        await SaveTimeDateAsync();
    }

    private async Task DetectTimezone()
    {
        try
        {
            var info = await JS.InvokeAsync<ClientLocaleInfo>("getClientLocaleInfo");
            if (!string.IsNullOrEmpty(info.TimeZone))
            {
                timeZone = info.TimeZone;
                await SaveTimeDateAsync();
            }
        }
        catch { /* JS not available */ }
    }

    private async Task SelectDateOrder(string id)
    {
        dateOrder = id;
        await SaveTimeDateAsync();
    }

    private async Task SelectClock(string id)
    {
        clockStyle = id;
        await SaveTimeDateAsync();
    }

    private async Task SelectCulture(string cultureName)
    {
        var available = LocaleResolver.GetAvailableCultures(UserState.Locale, timeZone);
        // If selecting the browser default (first in list), clear the override
        cultureOverride = available.Count > 0 && available[0].Name == cultureName
            ? null
            : cultureName;
        await SaveTimeDateAsync();
    }

    private System.Globalization.CultureInfo GetActiveCulture()
    {
        if (!string.IsNullOrEmpty(cultureOverride))
        {
            try { return LocaleResolver.SanitizeCulture(new System.Globalization.CultureInfo(cultureOverride)); }
            catch { }
        }
        return UserState.GetCultureInfo();
    }

    private async Task SaveTimeDateAsync()
    {
        if (!UserState.UserId.HasValue) return;

        var normalizedTz = string.IsNullOrWhiteSpace(timeZone) ? null : timeZone.Trim();
        var dateFormat = cultureOverride != null
            ? $"{dateOrder}-{clockStyle}-{cultureOverride}"
            : $"{dateOrder}-{clockStyle}";
        UserState.TimeZone = normalizedTz;
        UserState.DateFormat = dateFormat;

        await UserService.UpdateLocaleAsync(UserState.UserId.Value, normalizedTz, UserState.Locale, dateFormat);
    }

    private void FillDetectedLocation()
    {
        if (detectedLocation != null)
        {
            country = detectedLocation;
            DebounceSave();
        }
    }

    private void DebounceSave()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(800, token);
                await InvokeAsync(async () =>
                {
                    await SaveProfileAsync();
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private async Task SaveProfileAsync()
    {
        if (!UserState.UserId.HasValue) return;

        saveStatus = "Saving...";
        StateHasChanged();

        try
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            await UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;

            saveStatus = "Saved";
            StateHasChanged();

            // Clear "Saved" after a short delay
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                await InvokeAsync(() =>
                {
                    if (saveStatus == "Saved")
                    {
                        saveStatus = null;
                        StateHasChanged();
                    }
                });
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save profile for {Username}", UserState.Username);
            saveStatus = null;
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        if (isUploading) return;

        var file = e.File;
        if (file == null) return;

        if (!file.ContentType.StartsWith("image/")) return;
        if (file.Size > 10 * 1024 * 1024) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var url = await ImageService.GenerateProfilePictureAsync(stream, UserState.UserId!.Value);
            if (url != null)
            {
                profilePictureUrl = $"{url}?v={DateTime.UtcNow.Ticks}";
                await SaveProfileAsync();
            }
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveProfilePicture()
    {
        if (UserState.UserId.HasValue)
        {
            ImageService.DeleteProfilePicture(UserState.UserId.Value);
        }
        profilePictureUrl = null;
        await SaveProfileAsync();
    }

    private void GoBack()
    {
        // Flush any pending debounced save immediately
        _debounceCts?.Cancel();
        if (UserState.UserId.HasValue)
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            _ = UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;
        }

        Navigation.NavigateTo("/lobby", forceLoad: true);
    }

    // Account security methods

    private async Task EnablePassphrase()
    {
        if (!UserState.UserId.HasValue) return;

        var passphrase = UserService.GeneratePassphrase();
        await UserService.SetPasswordAsync(UserState.UserId.Value, passphrase);
        currentPassword = passphrase;
        hasPassword = true;
        showPassphrase = true;
        ShowPasswordStatus("Secret code enabled");
    }

    private async Task RegeneratePassphrase()
    {
        if (!UserState.UserId.HasValue) return;

        var passphrase = UserService.GeneratePassphrase();
        await UserService.SetPasswordAsync(UserState.UserId.Value, passphrase);
        currentPassword = passphrase;
        showPassphrase = true;
        ShowPasswordStatus("Secret code changed");
    }

    private async Task RemovePassword()
    {
        if (!UserState.UserId.HasValue) return;

        await UserService.SetPasswordAsync(UserState.UserId.Value, null);
        currentPassword = null;
        hasPassword = false;
        showPassphrase = false;
        ShowPasswordStatus("Secret code disabled");
    }

    private async Task CopyPassphrase()
    {
        if (currentPassword == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", currentPassword);
        _copiedPassphrase = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
        {
            _copiedPassphrase = false;
            StateHasChanged();
        }));
    }

    // Login link methods

    private void LoadLoginLink()
    {
        loginLink = UserState.UserId.HasValue ? AccessLinks.GetActiveForUser(UserState.UserId.Value) : null;
        loginLinkUrl = loginLink == null ? "" : AccessLinks.BuildUrl(loginLink.Code, Navigation.BaseUri);
        linkExpiryChoice = loginLink?.ExpiresAt == null ? "never" : "current";
    }

    private async Task CreateLink()
    {
        if (!UserState.UserId.HasValue) return;

        await AccessLinks.CreateForUserAsync(UserState.UserId.Value, UserState.UserId.Value);
        LoadLoginLink();
        showLink = true;
        ShowLinkStatus("Login link created");
    }

    private async Task RegenerateLink()
    {
        if (!UserState.UserId.HasValue) return;

        // Keeps the current expiry: "New Link" is about the code leaking, not the lifetime.
        await AccessLinks.CreateForUserAsync(UserState.UserId.Value, UserState.UserId.Value, loginLink?.ExpiresAt);
        LoadLoginLink();
        showLink = true;
        ShowLinkStatus("New link created. The old one no longer works.");
    }

    private async Task RevokeLink()
    {
        if (loginLink == null) return;

        await AccessLinks.RevokeAsync(loginLink.Id);
        LoadLoginLink();
        showLink = false;
        ShowLinkStatus("Login link revoked");
    }

    private async Task ChangeLinkExpiry(ChangeEventArgs e)
    {
        if (loginLink == null) return;

        var choice = e.Value?.ToString() ?? "never";
        if (choice == "current") return;

        DateTime? expiresAt = int.TryParse(choice, out var days) ? DateTime.UtcNow.AddDays(days) : null;
        await AccessLinks.SetExpiryAsync(loginLink.Id, expiresAt);
        LoadLoginLink();
        ShowLinkStatus(expiresAt == null ? "Link never expires" : $"Link expires {expiresAt:yyyy-MM-dd}");
    }

    private async Task CopyLink()
    {
        if (loginLink == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", loginLinkUrl);
        _copiedLink = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
        {
            _copiedLink = false;
            StateHasChanged();
        }));
    }

    private void ShowLinkStatus(string message)
    {
        linkSaveStatus = message;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                linkSaveStatus = null;
                StateHasChanged();
            });
        });
    }

    private async Task ToggleSmartLogin(ChangeEventArgs e)
    {
        if (!UserState.UserId.HasValue) return;
        smartLoginAllowed = (bool)(e.Value ?? true);
        await UserService.SetSmartLoginOptOutAsync(UserState.UserId.Value, !smartLoginAllowed);
    }

    private void ShowPasswordStatus(string message)
    {
        passwordSaveStatus = message;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                if (passwordSaveStatus == message)
                {
                    passwordSaveStatus = null;
                    StateHasChanged();
                }
            });
        });
    }

    // Active sessions methods

    private async void HandleUsersListChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (UserState.Username != null)
                    sessions = ChatService.GetActiveSessionsForUser(UserState.Username);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleUsersListChanged: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleUsersListChanged");
        }
    }

    private async Task SignOutOtherDevices()
    {
        if (isSigningOutOthers || !UserState.UserId.HasValue || UserState.SessionId == null) return;

        isSigningOutOthers = true;
        StateHasChanged();

        try
        {
            // Remove other sessions from ChatService
            await ChatService.RemoveAllSessionsExcept(UserState.Username!, UserState.SessionId);

            // Rotate token to invalidate cookies on other devices
            var newToken = await UserService.RotateTokenAsync(UserState.UserId.Value);

            // Auto-rotate passphrase so kicked devices can't immediately re-login
            if (hasPassword)
            {
                var newPassphrase = UserService.GeneratePassphrase();
                await UserService.SetPasswordAsync(UserState.UserId.Value, newPassphrase);
            }

            if (newToken != null)
            {
                // Navigate to set the new cookie on this device, then return to settings with notice
                Navigation.NavigateTo($"/auth/refresh-token?token={Uri.EscapeDataString(newToken)}&returnUrl=/settings%3Fkicked=1", forceLoad: true);
                return;
            }

            // Token rotation failed but sessions were still removed
            sessions = ChatService.GetActiveSessionsForUser(UserState.Username!);
            signOutStatus = "Other devices signed out";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to sign out other devices");
            signOutStatus = "Failed";
        }
        finally
        {
            isSigningOutOthers = false;
            StateHasChanged();
        }

        // Clear status after delay
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                signOutStatus = null;
                StateHasChanged();
            });
        });
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        if (utcTime == default) return "unknown";

        var elapsed = DateTime.UtcNow - utcTime;
        if (elapsed.TotalSeconds < 30) return "just now";
        if (elapsed.TotalMinutes < 1) return $"{(int)elapsed.TotalSeconds}s ago";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    // --- Notification settings (per-channel mute) ---

    private bool serverMuted;
    private int mutePreset = DefaultMutePreset;
    private NotificationMode dmMode = NotificationMode.AllowAll;
    private NotificationMode roomMode = NotificationMode.MuteAll;
    private bool newDmsMuted;
    private List<(Guid ChannelId, string DisplayName)> dmChannels = new();
    private List<Yap.Models.Channel> rooms = new();

    /// <summary>"Until I turn it back on" — index into MuteDurations, and the default choice.</summary>
    private const int DefaultMutePreset = 3;

    private static readonly (string Label, TimeSpan? Duration)[] MuteDurations =
    {
        ("1 hour", TimeSpan.FromHours(1)),
        ("1 day", TimeSpan.FromDays(1)),
        ("1 week", TimeSpan.FromDays(7)),
        ("Until I turn it back on", null)
    };

