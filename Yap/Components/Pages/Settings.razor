    private async Task SelectTheme(string themeId)
    {
        if (selectedTheme == themeId || !UserState.UserId.HasValue) return;

        selectedTheme = themeId;
        UserState.Theme = themeId;

        // Flip the attribute immediately for instant preview, then persist.
        await JS.InvokeVoidAsync("applyTheme", themeId);
        await UserService.UpdateThemeAsync(UserState.UserId.Value, themeId);
    }

    private async Task SelectFontSize(int size)
    {
        if (selectedFontSize == size || !UserState.UserId.HasValue) return;

        selectedFontSize = size;
        UserState.FontSize = size;

        // Flip the root style immediately for instant preview, then persist.
        await JS.InvokeVoidAsync("applyFontSize", size);
        await UserService.UpdateFontSizeAsync(UserState.UserId.Value, size);
    }

    private record ClientLocaleInfo(string? TimeZone, string? Locale);

    private record PushSubData(
        [property: System.Text.Json.Serialization.JsonPropertyName("endpoint")] string? Endpoint,
        [property: System.Text.Json.Serialization.JsonPropertyName("p256dh")] string? P256dh,
        [property: System.Text.Json.Serialization.JsonPropertyName("auth")] string? Auth);

    private string GetPushStatusText()
    {
        if (!pushSupported) return "Not Supported";
        if (!PushService.IsConfigured) return "Not Configured";
        if (pushSubscribed) return "Subscribed";
        return "Not subscribed";
    }

    private string GetPushStatusClass()
    {
        if (pushSubscribed) return "status-enabled";
        if (!pushSupported || !PushService.IsConfigured) return "status-unavailable";
        return "status-disabled";
    }

    private string GetPermissionClass()
    {
        return pushPermission switch
        {
            "granted" => "status-enabled",
            "denied" => "status-denied",
            _ => "status-disabled"
        };
    }

    // --- Debug: Local Cache (PWA) ---
    private IJSObjectReference? _jsModule;
    private CacheReport? cacheReport;
    private bool loadingCache;

    private async Task LoadCacheReportAsync()
    {
        if (_jsModule is null) return;
        loadingCache = true;
        try { cacheReport = await _jsModule.InvokeAsync<CacheReport>("getCacheStorageReport"); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load cache report"); }
        finally { loadingCache = false; }
    }

    private async Task RefreshCacheReport()
    {
        await LoadCacheReportAsync();
        StateHasChanged();
    }

    private async Task ClearCache(string name)
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.InvokeAsync<bool>("clearCacheByName", name); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to clear cache {Cache}", name); }
        }
        await RefreshCacheReport();
    }

    // Browser cache prefixes are owned by wwwroot/chat-client/constants.js.
    private static string FriendlyCacheName(string name) => name switch
    {
        _ when name.StartsWith("yap-chat-media-") => "Media — saved chat attachments",
        _ when name.StartsWith("yap-chat-shell-") => "Chat app — offline interface",
        "yap-media-v1" => "Media — uploads, GIFs, cached video",
        "yap-v2" => "App shell — icons, sound",
        _ => name
    };

    private static string FormatBytes(long bytes) => bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : bytes < 1024L * 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB"
        : $"{bytes / (1024.0 * 1024 * 1024):0.##} GB";

    public record CacheReport(bool Supported, long? Usage, long? Quota, long TotalBytes, int TotalCount, List<CacheGroup> Caches);
    public record CacheGroup(string Name, int Count, long TotalBytes, List<CacheEntry> Entries);
    public record CacheEntry(string Url, string Name, long Bytes, string Type);

    public async ValueTask DisposeAsync()
    {
        ChatService.OnUsersListChanged -= HandleUsersListChanged;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }
