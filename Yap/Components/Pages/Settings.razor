    private bool IsIndividuallyMuted(Guid channelId, bool isDm)
    {
        if (!UserState.UserId.HasValue) return false;
        var user = UserService.GetById(UserState.UserId.Value);
        return user != null && NotificationSettings.IsChannelMutedIndividually(user, channelId, isDm);
    }

    // Push notification methods

    private async Task LoadPushStatusAsync()
    {
        try
        {
            pushSupported = await JS.InvokeAsync<bool>("isPushSupported");
            pushPermission = await JS.InvokeAsync<string>("getNotificationPermission");
            isPwa = await JS.InvokeAsync<bool>("isPwaInstalled");

            if (pushSupported)
            {
                var existingSub = await JS.InvokeAsync<string?>("getPushSubscription");
                pushSubscribed = existingSub != null;
                if (existingSub != null)
                {
                    var cur = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(existingSub);
                    currentEndpoint = cur?.Endpoint;
                }
            }

            Logger.LogDebug("Push status loaded: supported={Supported}, permission={Permission}, subscribed={Subscribed}, pwa={Pwa}, serverSubs={ServerSubs}",
                pushSupported, pushPermission, pushSubscribed, isPwa, serverSubscriptionCount);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load push notification status");
        }
    }

    private async Task EnablePush()
    {
        if (pushToggling || !pushSupported || !PushService.IsConfigured) return;
        pushToggling = true;
        StateHasChanged();

        try
        {
            pushActionIsError = false;
            pushActionStatus = null;

            var permission = await JS.InvokeAsync<string>("requestNotificationPermission");
            pushPermission = permission;

            if (permission != "granted")
            {
                if (permission == "default")
                {
                    // "denied" flips the UI to its own explanatory branch; a dismissed
                    // prompt would leave the button looking dead, so say something.
                    pushActionIsError = true;
                    pushActionStatus = "The browser closed the permission prompt without granting.";
                }
                Logger.LogDebug("Push enable: permission {Permission} for {Username}", permission, UserState.Username);
                return;
            }

            var publicKey = PushService.GetPublicKey();
            if (publicKey == null) return;

            var subscriptionJson = await JS.InvokeAsync<string?>("subscribeToPush", publicKey);
            if (subscriptionJson == null)
            {
                var jsError = await JS.InvokeAsync<string?>("getLastPushError");
                pushActionIsError = true;
                // "push service error" is the browser failing to register with ITS push backend
                // (FCM for the Chrome family) — a network/browser-config problem, not ours.
                pushActionStatus = jsError != null && jsError.Contains("push service error")
                    ? $"This browser could not reach its push service ({jsError}). A firewall or ad-block can cause this; in Brave, enable \"Use Google services for push messaging\"."
                    : $"Subscription failed in the browser: {jsError ?? "unknown error"}.";
                Logger.LogWarning("Push enable: browser subscription failed for {Username}: {Error}", UserState.Username, jsError);
                return;
            }

            var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(subscriptionJson);
            if (subData != null && UserState.Username != null)
            {
                await PushStore.SaveSubscriptionAsync(UserState.Username, new PushSubscriptionInfo
                {
                    Endpoint = subData.Endpoint ?? "",
                    P256dh = subData.P256dh ?? "",
                    Auth = subData.Auth ?? ""
                });
                pushSubscribed = true;
                currentEndpoint = subData.Endpoint;
                RefreshPushDevices();
                Logger.LogDebug("Push enabled for {Username} from settings", UserState.Username);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to enable push for {Username}", UserState.Username);
        }
        finally
        {
            pushToggling = false;
            StateHasChanged();
        }
    }

    private async Task DisablePush()
    {
        if (pushToggling) return;
        pushToggling = true;
        StateHasChanged();

        try
        {
            pushActionIsError = false;
            pushActionStatus = null;

            // Deliberately this-device-only: the button promises exactly that. An older
            // RemoveUserSubscriptionsAsync call here wiped every device; it predated the
            // per-device list, whose Remove buttons now cover the other devices.
            var existingSub = await JS.InvokeAsync<string?>("getPushSubscription");
            if (existingSub != null)
            {
                var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(existingSub);
                await JS.InvokeAsync<bool>("unsubscribeFromPush");
                if (subData?.Endpoint != null)
                {
                    await PushStore.RemoveSubscriptionAsync(subData.Endpoint);
                }
            }

            pushSubscribed = false;
            currentEndpoint = null;
            RefreshPushDevices();
            Logger.LogDebug("Push disabled on this device for {Username}", UserState.Username);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disable push for {Username}", UserState.Username);
        }
        finally
        {
            pushToggling = false;
            StateHasChanged();
        }
    }

    private void RefreshPushDevices()
    {
        if (UserState.Username != null)
        {
            pushDevices = PushStore.GetSubscriptionsDetailed(UserState.Username);
            serverSubscriptionCount = pushDevices.Count;
        }
    }

    private async Task SendTestNotification()
    {
        if (sendingTest || UserState.Username == null) return;
        sendingTest = true;
        pushActionStatus = null;
        pushActionIsError = false;
        StateHasChanged();

        try
        {
            var result = await PushService.SendTestAsync(UserState.Username);
            pushActionStatus = result.Total == 0
                ? "No subscribed devices to notify."
                : result.Failed == 0
                    ? $"Sent to {result.Sent} device(s) — check them now."
                    : $"Sent to {result.Sent}/{result.Total} device(s); {result.Failed} failed (expired ones removed).";
            Logger.LogDebug("Push test for {Username}: sent={Sent} failed={Failed} total={Total}",
                UserState.Username, result.Sent, result.Failed, result.Total);
        }
        catch (Exception ex)
        {
            pushActionIsError = true;
            pushActionStatus = "Failed to send test notification.";
            Logger.LogError(ex, "Failed to send test push for {Username}", UserState.Username);
        }
        finally
        {
            sendingTest = false;
            RefreshPushDevices();
            StateHasChanged();
        }

        ClearPushActionStatusAfterDelay();
    }

    private async Task RemovePushDevice(string endpoint)
    {
        try
        {
            await PushStore.RemoveSubscriptionAsync(endpoint);

            // If we removed THIS browser's subscription, also unsubscribe it locally.
            if (endpoint == currentEndpoint)
            {
                try { await JS.InvokeAsync<bool>("unsubscribeFromPush"); } catch { /* best-effort */ }
                pushSubscribed = false;
                currentEndpoint = null;
            }

            RefreshPushDevices();
            Logger.LogDebug("Push device removed for {Username}", UserState.Username);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove push device for {Username}", UserState.Username);
        }
        StateHasChanged();
    }

    private async Task ScrollToNotificationRules()
    {
        try { await JS.InvokeVoidAsync("scrollToElementId", "notification-settings"); }
        catch { /* scroll is a nicety */ }
    }

    private void ClearPushActionStatusAfterDelay()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                pushActionStatus = null;
                StateHasChanged();
            });
        });
    }

    /// <summary>
    /// Best-effort platform hint derived from a push endpoint host (Lite — no stored device label).
    /// </summary>
    private static string DescribePushEndpoint(string endpoint)
    {
        if (string.IsNullOrEmpty(endpoint)) return "Notification device";
        try
        {
            var host = new Uri(endpoint).Host.ToLowerInvariant();
            if (host.Contains("apple")) return "Apple (Safari / iOS)";
            if (host.Contains("fcm") || host.Contains("google")) return "Google (Chrome / Edge / Android)";
            if (host.Contains("mozilla")) return "Mozilla (Firefox)";
            if (host.Contains("windows") || host.Contains("microsoft")) return "Microsoft (WNS)";
            return host;
        }
        catch
        {
            return "Notification device";
        }
    }

