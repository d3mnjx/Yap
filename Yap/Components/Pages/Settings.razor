    /// <summary>
    /// The three-way Allow / Individual / Mute picker, shared by the DM and room rows.
    /// Individual sits in the middle so the row reads as a spectrum from loudest to quietest.
    /// </summary>
    private RenderFragment ModePicker(string label, NotificationMode current, Func<NotificationMode, Task> onPick) =>
        @<div class="segmented" role="radiogroup" aria-label="@label">
            <button type="button" role="radio" aria-checked="@(current == NotificationMode.AllowAll)"
                    class="seg-btn @(current == NotificationMode.AllowAll ? "seg-selected" : "")"
                    @onclick="() => onPick(NotificationMode.AllowAll)">
                @IconBell<span>Allow all</span>
            </button>
            <button type="button" role="radio" aria-checked="@(current == NotificationMode.Individual)"
                    class="seg-btn @(current == NotificationMode.Individual ? "seg-selected" : "")"
                    @onclick="() => onPick(NotificationMode.Individual)">
                @IconIndividual<span>Individual</span>
            </button>
            <button type="button" role="radio" aria-checked="@(current == NotificationMode.MuteAll)"
                    class="seg-btn @(current == NotificationMode.MuteAll ? "seg-selected" : "")"
                    @onclick="() => onPick(NotificationMode.MuteAll)">
                @IconBellOff<span>Mute all</span>
            </button>
        </div>;

    /// <summary>Per-row bell toggle used by the DM and room lists.</summary>
    private RenderFragment ItemToggle(bool muted, Func<Task> onToggle) =>
        @<button type="button" class="notif-item-toggle @(muted ? "muted" : "")" @onclick="onToggle"
                 title="@(muted ? "Muted — click to allow" : "Allowed — click to mute")"
                 aria-label="@(muted ? "Unmute" : "Mute")" aria-pressed="@muted">
            @(muted ? IconBellOff : IconBell)
