@inject ChatService ChatService
@inject UserStateService UserState
@inject UserService UserService
@inject AccessLinkService AccessLinks
@inject NotificationSettingsService NotificationSettings
@inject UserActionLogService ActionLog
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject EmojiService EmojiService
@inject PushSubscriptionStore PushStore
@inject ILogger<ChatHeader> Logger
@implements IDisposable

<div class="chat-header">
    @if (!string.IsNullOrEmpty(NavState.CurrentDmUser))
    {
        var dmUser = UserService.GetByUsername(NavState.CurrentDmUser);
        <div class="dm-header-title">
            <button class="back-button" @onclick="NavigateBack" title="Back to lobby">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
            </button>
            <Avatar Username="@(dmUser?.Username ?? NavState.CurrentDmUser)"
                    ProfilePictureUrl="@dmUser?.ProfilePictureUrl"
                    Size="AvatarSize.Small" />
            <h3>@EmojiService.ConvertEmojis(dmUser?.EffectiveDisplayName ?? NavState.CurrentDmUser, inline: true)</h3>
        </div>
    }
    else if (NavState.ShowBackButton)
    {
        <div class="dm-header-title">
            <button class="back-button" @onclick="NavigateBack" title="Back to lobby">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
            </button>
            <h3>@EmojiService.ConvertEmojis(NavState.Title, inline: true)</h3>
        </div>
    }
    else
    {
        <h3>@EmojiService.ConvertEmojis(NavState.Title, inline: true)</h3>
    }
    <div class="header-controls">
        <div class="status-dropdown-container">
            <button class="status-button status-@EffectiveStatus.ToString().ToLower()" @onclick="ToggleDropdown" @onclick:stopPropagation="true">
                <span class="status-indicator"></span>
                <span class="status-username">@EmojiService.ConvertEmojis(UserState.EffectiveDisplayName, inline: true)</span>
                <svg class="dropdown-gear" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                </svg>
            </button>
            @if (showDropdown)
            {
                <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>
                <div class="status-dropdown">
                    <button class="dropdown-item @(UserState.Status == UserStatus.Online ? "active" : "")" @onclick="() => SetStatus(UserStatus.Online)">
                        <span class="status-dot online"></span>
                        <span>Online</span>
                    </button>
                    <button class="dropdown-item @(UserState.Status == UserStatus.Away ? "active" : "")" @onclick="() => SetStatus(UserStatus.Away)">
                        <span class="status-dot away"></span>
                        <span>Away</span>
                    </button>
                    <button class="dropdown-item @(UserState.Status == UserStatus.Invisible ? "active" : "")" @onclick="() => SetStatus(UserStatus.Invisible)">
                        <span class="status-dot invisible"></span>
                        <span>Invisible</span>
                    </button>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item" @onclick="OpenSettings">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        </svg>
                        <span>Settings</span>
                    </button>
                    <button class="dropdown-item" @onclick="OpenNotificationSettings">
                        @* Crossed bell while the account-wide mute is on — the reminder lives here,
                           not on the closed header button (phone real estate). Server-level only:
                           DM/room modes have their own bells in the sidebar. *@
                        @if (IsServerMutedNow)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm0-15.5c2.49 0 4 2.02 4 4.5v5h2v1H6v-1h2v-5c0-3.07 1.63-5.64 4.5-6.32V4c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v.68c-.17.04-.33.09-.5.14zM5.41 3.35L4 4.76l2.81 2.81C6.29 8.57 6 9.74 6 11v5l-2 2v1h14.24l1.35 1.35 1.41-1.41L5.41 3.35z"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/>
                            </svg>
                        }
                        <span>Notification settings</span>
                    </button>
                    @if (UserState.UserId.HasValue && UserService.IsAdmin(UserState.UserId.Value))
                    {
                        <button class="dropdown-item" @onclick="OpenAdmin">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                            </svg>
                            <span>Admin</span>
                        </button>
                    }
                    <button class="dropdown-item signout" @onclick="SignOut">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                        </svg>
                        <span>Sign Out</span>
                    </button>
                    @* <button class="dropdown-item" style="color: #ed4245;" @onclick="TestException">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                        </svg>
                        <span>Test Exception</span>
                    </button> *@
                </div>
            }
        </div>
        @if (unreadCount > 0)
        {
            <button class="mailbox-button has-unread"
                    @onclick="HandleMailboxClick"
                    title="@unreadCount unread messages">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5v-3h3.56c.69 1.19 1.97 2 3.45 2s2.75-.81 3.45-2H19v3zm0-5h-4.99c0 1.1-.9 2-2 2s-2-.9-2-2H5V5h14v9z"/>
                </svg>
                <span class="mailbox-badge">@unreadCount</span>
            </button>
        }
        <button class="users-toggle" @onclick="NavState.ToggleSidebar" title="Toggle sidebar">
            <svg class="icon-people" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 8.00598C14 10.211 12.206 12.006 10 12.006C7.795 12.006 6 10.211 6 8.00598C6 5.80098 7.795 4.00598 10 4.00598C12.206 4.00598 14 5.80098 14 8.00598ZM2 19.006C2 15.473 5.29 13.006 10 13.006C14.711 13.006 18 15.473 18 19.006V20.006H2V19.006Z"/>
                <path d="M20.0001 20.006H22.0001V19.006C22.0001 16.4433 20.2697 14.4415 17.5213 13.5352C19.0621 14.9127 20.0001 16.8059 20.0001 19.006V20.006Z"/>
                <path d="M14.8834 11.9077C16.6657 11.5044 18.0001 9.9077 18.0001 8.00598C18.0001 5.96916 16.4693 4.28218 14.4971 4.0367C15.4322 5.09511 16.0001 6.48524 16.0001 8.00598C16.0001 9.44888 15.4889 10.7742 14.6378 11.8102C14.7203 11.8734 14.8022 11.9388 14.8834 11.9077Z"/>
            </svg>
            <svg class="icon-hamburger" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
            </svg>
            <span class="online-count">@onlineCount</span>
        </button>
    </div>
</div>

@code {
    private int unreadCount = 0;
    private int onlineCount = 0;
    private bool showDropdown = false;

    protected override async Task OnInitializedAsync()
    {
        // Get initial state
        await RefreshUnreadCountAsync();
        onlineCount = ChatService.GetOnlineUsers().Count;

        // Subscribe to events
        ChatService.OnUnreadChanged += HandleUnreadChanged;
        ChatService.OnUsersListChanged += HandleUsersListChanged;
        ChatService.OnUserStatusChanged += HandleUserStatusChanged;
        NavState.OnChange += HandleNavStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Small delay to catch users added during layout initialization
            await Task.Delay(100);
            var currentCount = ChatService.GetOnlineUsers().Count;
            if (currentCount != onlineCount)
            {
                onlineCount = currentCount;
                StateHasChanged();
            }
        }
    }

    // The dot shows the EFFECTIVE status (auto-Away included); the dropdown checkmarks keep
    // showing the chosen one — "your setting is Online, you're currently idle", Discord-style.
    private UserStatus EffectiveStatus =>
        (UserState.Username is { } name ? ChatService.GetUserStatus(name) : null) ?? UserState.Status;

    // Evaluated on render; opening the dropdown re-renders, so the icon is fresh whenever
    // the row becomes visible. No event subscription needed for a menu-only indicator.
    private bool IsServerMutedNow =>
        UserState.UserId.HasValue
        && UserService.GetById(UserState.UserId.Value) is { } u
        && NotificationSettings.IsServerMuted(u);

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private async Task SetStatus(UserStatus status)
    {
        UserState.Status = status;
        if (UserState.SessionId != null)
        {
            await ChatService.SetUserStatusAsync(UserState.SessionId, status);
        }
        showDropdown = false;
    }

    private async Task SignOut()
    {
        showDropdown = false;

        // Warn when nothing can bring them back: no login link and no secret code
        var hasWayBack = UserState.Username != null
            && (UserService.HasPassword(UserState.Username)
                || (UserState.UserId is { } uid && AccessLinks.HasActiveLink(uid)));
        if (!hasWayBack)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "You have no login link and no secret code. Without one, you won't be able to get back into this account. Continue signing out?");
            if (!confirmed) return;
        }

        ActionLog.Log(UserState.UserId?.ToString(), UserActionLog.KnownActions.LOGOUT, info: UserState.Username);

        // Unsubscribe push for this device only (not all devices)
        try
        {
            var existingSub = await JS.InvokeAsync<string?>("getPushSubscription");
            if (existingSub != null)
            {
                var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(existingSub);
                await JS.InvokeAsync<bool>("unsubscribeFromPush");
                if (subData?.Endpoint != null)
                {
                    await PushStore.RemoveSubscriptionAsync(subData.Endpoint);
                }
                Logger.LogDebug("Push subscription cleaned up on sign-out for {Username}", UserState.Username);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to clean up push subscription on sign-out for {Username}", UserState.Username);
        }

        // Remove this session from chat service (other sessions stay active)
        if (UserState.SessionId != null)
        {
            await ChatService.RemoveUserAsync(UserState.SessionId);
        }

        // Account stays alive — no DeleteUserAsync, no ClearReadStatesForUser

        // Clear cookie and redirect to login
        Navigation.NavigateTo("/auth/signout", forceLoad: true);
    }

    private async Task RefreshUnreadCountAsync()
    {
        if (!UserState.UserId.HasValue || string.IsNullOrEmpty(UserState.Username))
        {
            unreadCount = 0;
            return;
        }

        try
        {
            // Exclude currently viewed DM channel from unread count
            Guid? excludeChannelId = null;
            if (!string.IsNullOrEmpty(NavState.CurrentDmUser))
            {
                var otherUser = UserService.GetByUsername(NavState.CurrentDmUser);
                if (otherUser != null)
                {
                    var channel = ChatService.GetOrCreateDMChannelByUsername(UserState.Username, NavState.CurrentDmUser);
                    excludeChannelId = channel?.Id;
                }
            }

            unreadCount = ChatService.GetTotalUnreadCount(UserState.UserId.Value, excludeChannelId);
            await UpdateBadgeAsync();
        }
        catch (Exception)
        {
            // Ignore errors during unread count refresh (user might not be fully initialized)
            unreadCount = 0;
        }
    }

    private async Task UpdateBadgeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("setAppBadge", unreadCount);
        }
        catch
        {
            // Ignore badge errors (not supported, not installed as PWA, etc.)
        }
    }

    private async void HandleNavStateChanged()
    {
        // Refresh unread count when navigation changes (e.g., opening a DM marks messages as read)
        await InvokeAsync(async () =>
        {
            await RefreshUnreadCountAsync();
            StateHasChanged();
        });
    }

    private async void HandleUnreadChanged(Guid userId, Guid channelId)
    {
        // Only refresh if the unread change is for the current user
        if (UserState.UserId.HasValue && userId == UserState.UserId.Value)
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await RefreshUnreadCountAsync();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleUnreadChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleUnreadChanged");
            }
        }
    }

    private async void HandleUsersListChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                onlineCount = ChatService.GetOnlineUsers().Count;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleUsersListChanged: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleUsersListChanged");
        }
    }

    private async void HandleUserStatusChanged(string username, UserStatus status)
    {
        // Update header if it's our status that changed (e.g., auto-away)
        if (username.Equals(UserState.Username, StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                await InvokeAsync(() =>
                {
                    // UserState.Status is the CHOSEN status and [PersistentState] — mirroring an
                    // auto-Away here makes it the chosen status on the next circuit resume/rejoin
                    // (AddUserAsync seeds from it, with no restore record), stranding the user
                    // Away: open DMs stop clearing unread and push fires mid-conversation. Auto
                    // changes only repaint — the dot reads EffectiveStatus.
                    if (!ChatService.IsAutoAway(username))
                        UserState.Status = status;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleUserStatusChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleUserStatusChanged");
            }
        }
    }

    private void HandleMailboxClick()
    {
        NavState.OpenSidebar();
    }

    private void NavigateBack()
    {
        // Chat routes are document endpoints outside the retained Blazor router.
        Navigation.NavigateTo("/lobby", forceLoad: true);
    }

    private void OpenSettings()
    {
        showDropdown = false;
        // On phone the slide-in sidebar can be open under the header dropdown;
        // leaving it open would cover the page we navigate to. No-op on desktop.
        NavState.CloseSidebar();
        Navigation.NavigateTo("/settings");
    }

    private void OpenNotificationSettings()
    {
        showDropdown = false;
        NavState.CloseSidebar();
        Navigation.NavigateTo("/settings#notification-settings");
    }

    private record PushSubData(
        [property: System.Text.Json.Serialization.JsonPropertyName("endpoint")] string? Endpoint,
        [property: System.Text.Json.Serialization.JsonPropertyName("p256dh")] string? P256dh,
        [property: System.Text.Json.Serialization.JsonPropertyName("auth")] string? Auth);

    private void OpenAdmin()
    {
        showDropdown = false;
        NavState.CloseSidebar();
        Navigation.NavigateTo("/admin");
    }

    // private void TestException()
    // {
    //     showDropdown = false;
    //     throw new InvalidOperationException("Test exception from Blazor circuit! This verifies error handling is working.");
    // }

    public void Dispose()
    {
        ChatService.OnUnreadChanged -= HandleUnreadChanged;
        ChatService.OnUsersListChanged -= HandleUsersListChanged;
        ChatService.OnUserStatusChanged -= HandleUserStatusChanged;
        NavState.OnChange -= HandleNavStateChanged;
    }
}
