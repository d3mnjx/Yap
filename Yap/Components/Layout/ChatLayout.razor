@inherits LayoutComponentBase
@inject UserStateService UserState
@inject ChatNavigationState NavState
@inject ChatService ChatService
@inject NavigationManager Navigation
@inject CircuitTracker CircuitTracker
@inject CircuitIdentity CircuitIdentity
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject ILogger<ChatLayout> Logger
@implements IDisposable

@* data-context lets any theme shift its look between rooms and DMs, so you can tell
   where you are from the corner of your eye. Blazor owns this attribute outright (no
   JS touches it) and reads the same NavState the header line does, so the two can
   never disagree. Deliberately narrower than data-theme: a context may move the
   pattern and tint only, never a status colour - it changes many times a minute. *@
<div class="chat-container" data-context="@(NavState.CurrentDmUser != null ? "dm" : "room")">
    @* Themed background scene + legibility wash. Empty by design: both are painted
       entirely from CSS variables the active theme sets, so they stay inert for
       every theme that defines none. Order matters - the scrim paints over the
       scene. (The pattern layer is NOT here: it lives inside .messages-flow and
       scrolls with the conversation - see app.css.) *@
    <div class="theme-scene"></div>
    <div class="theme-scrim"></div>

    <ChatHeader />

    <img src="images/@(NavState.CurrentDmUser != null ? "purpleline01_3px.png" : "turqline01_3px.png")"
         class="header-line" alt="" />

    <div class="chat-main">
        <div class="messages-container">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-content">
                        <h3>Something went wrong</h3>
                        <p>@ex.Message</p>
                        <button class="error-retry-button" @onclick="Recover">Try Again</button>
                        <button class="error-reload-button" onclick="location.reload()">Reload Page</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>

        <ChatSidebar />
    </div>

    <div class="sidebar-backdrop @(NavState.SidebarOpen ? "show" : "")" @onclick="NavState.ToggleSidebar"></div>

    @* <PwaInstallBanner /> — PWA nudge now handled by Ping bot welcome DM *@
    <PushPermissionPrompt />
</div>

@code {
    private ErrorBoundary? errorBoundary;
    private DotNetObjectReference<ChatLayout>? selfRef;

    protected override void OnInitialized()
    {
        NavState.OnChange += StateHasChanged;
        ChatService.OnSessionKicked += HandleSessionKicked;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Auth guard - redirect to login if not authenticated
        // UserState is populated by AuthMiddleware before Blazor starts
        if (!UserState.IsLoggedIn)
        {
            var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            var returnUrl = Uri.EscapeDataString("/" + currentUrl);
            Navigation.NavigateTo($"/?returnUrl={returnUrl}");
            return;
        }

        // Latency telemetry: chat.js pings ProbePing every few seconds and reports send→appear
        // timings; results land in CircuitTracker for the admin diagnostics table. Hosted here
        // because ChatLayout is one-per-circuit and survives page navigation.
        try
        {
            // Settings/Admin now open fresh circuits without ChatBase. Register here so status
            // controls and "sign out other devices" have a current session to preserve.
            if (UserState.UserId is { } userId && UserState.Username is { } username
                && (UserState.SessionId == null || !ChatService.HasSession(UserState.SessionId)))
            {
                UserState.SessionId = Guid.NewGuid().ToString();
                UserState.Status = ChatService.GetStatusBeforeAutoAway(username)
                    ?? ChatService.GetUserStatus(username) ?? UserState.Status;
                UserState.IsMobile ??= HttpContextAccessor.HttpContext?.Items["IsMobile"] as bool?;
                var visible = await JS.InvokeAsync<bool>("isPageVisible");
                await ChatService.AddUserAsync(UserState.SessionId, userId, username, UserState.Status,
                    UserState.IsMobile, HttpContextAccessor.HttpContext?.Items["ClientIp"] as string,
                    CircuitIdentity.CircuitId, pageVisible: visible);
            }
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupLatencyProbe", selfRef, UserState.Username);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to setup latency probe");
        }
    }

    // The probe reports one interval late: each ping carries the PREVIOUS round trip, so a single
    // call both measures (its own duration, timed in JS) and delivers. Render-free by design.
    // Doubles as the presence heartbeat: real visibility + input-idle let ChatService keep
    // per-session foreground/away state truthful even in tabs that never fire visibilitychange.
    [JSInvokable]
    public async Task ProbePing(double? prevRttMs, bool visible, double idleSeconds)
    {
        if (prevRttMs is double ms && CircuitIdentity.CircuitId is string id)
            CircuitTracker.ReportRtt(id, ms);

        if (UserState.SessionId is string sessionId)
            await ChatService.ReportClientStateAsync(sessionId, visible, idleSeconds);
    }

    // Client-measured "send clicked → own message in the DOM" — the send latency the user actually saw.
    [JSInvokable]
    public void ReportSendTiming(double ms)
    {
        if (CircuitIdentity.CircuitId is string id)
            CircuitTracker.ReportSendTiming(id, ms);
    }

    private async void HandleSessionKicked(string sessionId)
    {
        if (sessionId != UserState.SessionId) return;

        try
        {
            await InvokeAsync(() =>
            {
                // Force full HTTP redirect to signout — clears cookie and lands on login
                Navigation.NavigateTo("/auth/signout", forceLoad: true);
            });
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
            // Circuit already dead, nothing to do
        }
    }

    private void Recover()
    {
        errorBoundary?.Recover();
    }

    public void Dispose()
    {
        NavState.OnChange -= StateHasChanged;
        ChatService.OnSessionKicked -= HandleSessionKicked;
        selfRef?.Dispose();
    }
}
