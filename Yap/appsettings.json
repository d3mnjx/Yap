// ⚠️ HEADS UP: at runtime, if Data/appsettings.json exists it ENTIRELY REPLACES this file
// (see Program.cs — the Data/ copy is the source of truth so Docker deployments can edit config
// without rebuilding the image). When you change a value here, mirror the same change into
// Data/appsettings.json or it won't take effect. The Data/ file is seeded from this one only
// when it doesn't already exist.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every SQL command at Information is one log line per database write; under load that is thousands a
      // second of journal output. Set this to "Information" and restart to see the commands for a while.
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // for push notifications in PWA -genereate your own VAPID keys
  "Vapid": {
    "Subject": "mailto:admin@example.com",
    "PublicKey": "GENERATE_YOUR_OWN_VAPID_PUBLIC_KEY",
    "PrivateKey": "GENERATE_YOUR_OWN_VAPID_PRIVATE_KEY"
  },
  "ChatSettings": {
    // App name shown in the browser tab and login page
    "ProjectName": "Yap",
    // The address the login links carry, such as "https://chat.example.com". Empty: the address the clients reach the server by
    "PublicOrigin": "",
    // The reverse proxies whose X-Forwarded-For and X-Forwarded-Proto the server believes: addresses or networks in CIDR form,
    // e.g. ["172.18.0.0/16"] for a proxy container or the Docker gateway. Loopback is always trusted. Cloudflare needs no entry:
    // its ranges are known, and the visitor comes from CF-Connecting-IP behind a Cloudflare hop (also through Caddy or nginx).
    // Empty behind a proxy: every client address counts as unknown, smart login (AU-09) is off, and the log says so once.
    "TrustedProxies": [],
    // Where the Cloudflare ranges are refreshed from, once a day. Empty turns the refresh off; the built-in list and
    // the last download in Data/cloudflare-ips.json stay in use.
    "CloudflareIpsUrl": "https://api.cloudflare.com/client/v4/ips",
    // Where uploaded files are stored, relative to the app folder. The URLs stay /uploads/... whatever the folder.
    "UploadsPath": "wwwroot/uploads",
    // Delete all uploaded images on app start
    "ClearUploadsOnStart": false,
    // Maximum file upload size in MB (images and videos)
    "MaxUploadSizeMB": 100,
    // Upload endpoint URL. Empty = same domain (/api/tus). Set to full URL (e.g., "https://upload.example.com/api/tus") to bypass Cloudflare proxy limits.
    "UploadUrl": "",
    // IPv4 beacon origin for the admin panel. Empty = disabled. Set to a full origin (e.g., "https://ip4.example.com") whose DNS has ONLY an A record (grey-cloud, no AAAA), pointing at this same app — forces one background request over IPv4 so admin can show the v4 of dualstack (IPv6) clients.
    "Ipv4BeaconUrl": "",
    // Where to store push notification subscriptions: "Json" (file) or "Database"
    "PushSubscriptionStorage": "Json",
    // Show a custom welcome/landing page before login. Requires Data/welcome/welcome.html
    "WelcomePageEnabled": true,
    "Bot": {
      "Enabled": true,
      "Username": "ping",
      "DisplayName": "Ping",
      "WelcomeMessage": "👋 Hey! Welcome to {server}! We have custom emojis — check them out in the emoji picker 😎"
    },
    "Persistence": {
      // Enable database persistence (messages, channels, reactions survive restarts)
      "Enabled": true,
      // What the server loads from the database at start, for each room and each direct conversation: the newest
      // messages, at most this many and at most this many days old. Both apply. 0 = no limit (also when the keys
      // are absent). Older messages stay in the database. Nobody can read them, the admin included, until the
      // limits change and the server restarts. The per-room history windows in the app are independent of this.
      "Load": { "MaxMessagesPerChannel": 5000, "MaxDays": 90 },
      "ConnectionStrings": {
        "SQLite": "Data Source=Data/yap.db"
      }
    },
    // GIF picker config (Klipy by default — Tenor stopped accepting new API clients Jan 2026).
    // Get a free API key at https://partner.klipy.com. Content rating is admin-controlled
    // from /admin (persisted to Data/gif-settings.json) — not set here.
    "GifSettings": {
      // Per-user cap (MB) on bring-your-own-GIF storage (uploads + zip imports). Admins are
      // exempt; starred provider GIFs never count.
      "UserQuotaMB": 4096,
      // Max size (MB) of a single GIF pack (.zip) import upload
      "MaxPackSizeMB": 1024,
      "Klipy": {
        "ApiKey": "",
        "CustomerId": "yap",
        "Locale": "en_US"
      }
    },
    // Randomized UI text — a random item is picked each time. Use {0} for dynamic values.
    "FunnyTexts": {
      // login page above username input
      "WelcomeMessages": [
        "welcome to {0}",
        "you ready?",
        "you found {0}",
        "{0}"
      ],
      // login button text
      "JoinButtonTexts": [
        "lessgo",
        "slide in",
        "hop on",
        "lock in",
        "get in queen",
        "join the squad",
        "get in badass"
      ],
      // login page username input placeholder
      "UsernamePlaceholders": [
        "drop your @",
        "who dis?",
        "username goes here",
        "tag yourself"
      ],
      // main chat message input placeholder
      "MessagePlaceholders": [
        "say hi...",
        "sup...",
        "spill the tea...",
        "say something...",
        "drop a hot take...",
        "type your truth...",
        "go off...",
        "send it..."
      ],
      // the pill that shows when messages arrive while the reader is scrolled up
      "NewMessagesPill": [
        "New messages"
      ],
      "SystemMessages": {
        "UserJoined": [
          "{0} just dropped",
          "{0} is here",
          "{0} arrives",
          "W {0} joined",
          "{0} spawned in",
          "{0} returns"
        ],
        "UserLeft": [
          "{0} dipped",
          "{0} ghosted us",
          "{0} went to touch grass",
          "{0} logged off",
          "{0} left on read",
          "{0} has left the chat",
          "rip {0}"
        ]
      },
      "TypingIndicators": {
        "Single": [
          "{0} is cooking..",
          "{0} boutta drop heat..",
          "{0} typing their villain arc..",
          "{0} lowkey struggling..",
          "{0} channeling their inner poet..",
          "{0} manifesting a message..",
          "{0} is in their typing era.."
        ],
        "Double": [
          "{0} and {1} are cooking..",
          "{0} and {1} causing chaos..",
          "{0} and {1} boutta spam..",
          "{0} and {1} racing fr fr..",
          "{0} and {1} typing faast.."
        ],
        "Multiple": [
          "{0}, {1} and more going crazy..",
          "chat's popping off: {0}, {1} + others..",
          "{0} and {1} causing chaos..",
          "typing apocalypse: {0}, {1} and more..",
          "{0} and {1} others said bet..",
          "everyone typing their hot takes.."
        ]
      },
      "OnlineUsersHeader": [
        "the gang ({0})",
        "squad check ({0})",
        "main characters ({0})",
        "{0} legends present",
        "chat fam ({0})"
      ],
      "RoomHeaders": [
        "# {0}",
        "you're @ {0}",
        "{0} chat",
        "welcome to {0}",
        "{0} vibes"
      ],
      // message search: the placeholder of the search field ({0} is the room or the person) and the text of a
      // search that finds nothing ({0} is what was searched for)
      "Search": {
        "Placeholder": [
          "search...",
          "find the receipts...",
          "dig up the lore...",
          "who said what...",
          "search {0}..."
        ],
        "NoResults": [
          "crickets...",
          "nothing. nada. zilch.",
          "no receipts found",
          "nobody said {0}",
          "that never happened"
        ]
      }
    }
  }
}
