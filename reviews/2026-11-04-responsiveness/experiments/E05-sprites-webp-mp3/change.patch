From e46721a38166ab7430cb12ccb60385aa97ea27c6 Mon Sep 17 00:00:00 2001
From: urza <189804+urza@users.noreply.github.com>
Date: Wed, 4 Nov 2026 10:53:34 +0100
Subject: [PATCH] Emoji-toggle sprites as lossless WebP, notif.mp3 without its
 cover art

The two 960x192 RGBA sprites behind the composer's 22 px emoji button
cost 85.0 KB (45,887 + 39,111 B) on every first visit. The worker
fetches them again at install. Lossless WebP (libwebp through ffmpeg,
-lossless 1 -compression_level 6) holds the same pixels in 31.5 KB
(19,040 + 12,508 B). Each PNG and its WebP decode to byte-identical
RGBA (ffmpeg rawvideo rgba, then cmp). The PNGs carried only sRGB and
gAMA 1/2.2 colour chunks, so the untagged WebP renders in the same
colour space.

composer.css points its four url()s at the .webp files; the cell math
does not change. ShellAssets adds root *.webp to the worker's precache
list, because without it an offline cold start loses the icon. The
worker's isShellAsset test already accepts webp. The PNGs are deleted;
nothing else refers to them.

notif.mp3 was 43,860 B: a 0.75 s 320 kb/s stereo stream, a 512x512 PNG
cover picture and ID3 tags. A remux that keeps only the audio stream
(-map 0:a -map_metadata -1 -c:a copy) gives 32,435 B. The audio frames
are copied, not re-encoded: the old and the new file decode to
identical f32 PCM. A lower bitrate would save more, but nobody here
can listen to it, so that step is left out.

Checked: dotnet build, 0 warnings. The served service-worker.js names
/emoji_selection_color.webp and /emoji_selection_greys.webp and no
sprite .png. Both answer 200 image/webp; the old PNG URLs answer 404.
npm run smoke 17/17, npm run features 14/14 and npm run screenshots
27/27 pass, with no HTTP error in the browser logs (the worker's
install included). The screenshots show the grey and the colour icon.

Co-Authored-By: Wren <wren@yap.local>
---
 Yap/Endpoints/ShellAssets.cs           |   2 +-
 Yap/wwwroot/css/composer.css           |   8 ++++----
 Yap/wwwroot/emoji_selection_color.png  | Bin 45887 -> 0 bytes
 Yap/wwwroot/emoji_selection_color.webp | Bin 0 -> 19040 bytes
 Yap/wwwroot/emoji_selection_greys.png  | Bin 39111 -> 0 bytes
 Yap/wwwroot/emoji_selection_greys.webp | Bin 0 -> 12508 bytes
 Yap/wwwroot/notif.mp3                  | Bin 43860 -> 32435 bytes
 7 files changed, 5 insertions(+), 5 deletions(-)
 delete mode 100644 Yap/wwwroot/emoji_selection_color.png
 create mode 100644 Yap/wwwroot/emoji_selection_color.webp
 delete mode 100644 Yap/wwwroot/emoji_selection_greys.png
 create mode 100644 Yap/wwwroot/emoji_selection_greys.webp

diff --git a/Yap/Endpoints/ShellAssets.cs b/Yap/Endpoints/ShellAssets.cs
index bbb425b9..e8b9607c 100644
--- a/Yap/Endpoints/ShellAssets.cs
+++ b/Yap/Endpoints/ShellAssets.cs
@@ -27,7 +27,7 @@ public sealed class ShellAssets
         // rare, and the worker keeps the italic file from its first use. The theme backgrounds (images/themes,
         // 1.5 MB) are not precached for the same reason.
         var plain = Files(webRoot, "fonts", "*.woff2").Where(f => !f.Contains("Italic"))
-            .Concat(Files(webRoot, ".", "*.svg")).Concat(Files(webRoot, ".", "*.png")).Concat(Files(webRoot, ".", "*.mp3"))
+            .Concat(Files(webRoot, ".", "*.svg")).Concat(Files(webRoot, ".", "*.png")).Concat(Files(webRoot, ".", "*.webp")).Concat(Files(webRoot, ".", "*.mp3"))
             .Concat(Files(webRoot, "images", "*.png")).Concat(Files(webRoot, "images", "*.svg"));
 
         ImportMap = JsonSerializer.Serialize(new { imports = modules.ToDictionary(p => p, p => $"{p}?v={v}") });
diff --git a/Yap/wwwroot/css/composer.css b/Yap/wwwroot/css/composer.css
index 1658b216..82525944 100644
--- a/Yap/wwwroot/css/composer.css
+++ b/Yap/wwwroot/css/composer.css
@@ -456,8 +456,8 @@
     height: 22px;
 
     /* Grey state: silhouette sprite as mask, filled with grey */
-    -webkit-mask-image: url(/emoji_selection_greys.png);
-    mask-image: url(/emoji_selection_greys.png);
+    -webkit-mask-image: url(/emoji_selection_greys.webp);
+    mask-image: url(/emoji_selection_greys.webp);
     -webkit-mask-size: 440px 88px;
     mask-size: 440px 88px;
     -webkit-mask-position: calc(var(--grey-col) * -22px) calc(var(--grey-row) * -22px);
@@ -467,7 +467,7 @@
     background-color: var(--text-secondary);
 
     /* Preload color sprite to avoid flash on first hover */
-    background-image: url(/emoji_selection_color.png);
+    background-image: url(/emoji_selection_color.webp);
     background-size: 0;
 }
 
@@ -477,7 +477,7 @@
     -webkit-mask-image: none;
     mask-image: none;
     background-color: transparent;
-    background-image: url(/emoji_selection_color.png);
+    background-image: url(/emoji_selection_color.webp);
     background-size: 440px 88px;
     background-position: calc(var(--color-col) * -22px) calc(var(--color-row) * -22px);
     background-repeat: no-repeat;
diff --git a/Yap/wwwroot/emoji_selection_color.png b/Yap/wwwroot/emoji_selection_color.png
deleted file mode 100644
index fd8472a4ea1251ff9a69eaa87dab0e640edd46f4..0000000000000000000000000000000000000000
