root = true

# Keep the rewrite's C# readable with the SDK's built-in formatter.
[Yap/Offline/*.cs]
indent_style = space
indent_size = 4
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false

[Yap/Services/ChatService.*.cs]
indent_style = space
indent_size = 4
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false

[tests/OfflineContract/*.cs]
indent_style = space
indent_size = 4
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
